{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "appName": {
      "value": "${APP_NAME=cmcsp}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=}"
    },
    "acrName": {
      "value": "${ACR_NAME=}"
    },
    "keyVaultName": {
      "value": "${KEY_VAULT_NAME=}"
    },
    "storageAccountName": {
      "value": "${STORAGE_ACCOUNT_NAME=}"
    },
    "grantMiRbacAdminOnSubscription": {
      "value": "${GRANT_MI_RBAC_ADMIN=false}"
    },
    "deployDataPlatform": {
      "value": "${DEPLOY_DATA_PLATFORM=false}"
    },
    "sqlAdminLogin": {
      "value": "${SQL_ADMIN_LOGIN=}"
    },
    "sqlAdminObjectId": {
      "value": "${SQL_ADMIN_OBJECT_ID=}"
    },
    "sqlAdminPrincipalType": {
      "value": "${SQL_ADMIN_PRINCIPAL_TYPE=User}"
    },
    "sqlServerName": {
      "value": "${SQL_SERVER_NAME=}"
    },
    "redisName": {
      "value": "${REDIS_NAME=}"
    }
  }
}
