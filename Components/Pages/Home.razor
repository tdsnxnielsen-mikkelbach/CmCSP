@page "/"
@inject ICostManagementService CostService
@inject DashboardStateService State
@inject SubscriptionStoreService SubStore
@inject ExportProvisioningService ExportProvisioner
@inject ILogger<Home> Logger
@implements IDisposable

<PageTitle>Cost Overview – CSP Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<SubscriptionScopeBadge SelectedCount="SubStore.AllIds.Count" WithDataCount="_withDataSubCount" />

@* ── Summary cards ────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Cost (selected range)</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@FormatCost(_totalCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Cost Month-to-Date</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@FormatCost(_costMtd)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Cost Year-to-Date</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@FormatCost(_costYtd)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Daily Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@FormatCost(_avgDailyCost)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── Charts ───────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3">
    @* Cost vs Prior Month *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Daily Cost – Current vs Prior Month</MudText>
            <ApexChart TItem="DailyPoint" Options="_twoLineOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_currentMonthDaily.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{GetSubName(capturedSubId)} (Current)")"
                                     XValue="@(e => e.Day)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_priorMonthDaily.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{GetSubName(capturedSubId)} (Prior)")"
                                     XValue="@(e => e.Day)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Monthly Trend *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Monthly Cost Trend</MudText>
            <ApexChart TItem="MonthlyPoint" Options="_barOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthlyTrend.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Top 10 Services *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Top 10 Services by Cost</MudText>
            <ApexChart TItem="ServicePoint" Options="_hbarOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="ServicePoint"
                                     Items="_topServices.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── Subscription Management ─────────────────────────────────────────────── *@
<MudExpansionPanels Class="mt-4" Elevation="2">
    <MudExpansionPanel Text="Manage Subscriptions" Icon="@Icons.Material.Filled.ManageAccounts">

        @* Active subscription chips *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Active Subscriptions (@SubStore.AllIds.Count)</MudText>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var sub in SubStore.AllIds)
            {
                var capturedId  = sub;
                var displayName = _subNames.TryGetValue(capturedId, out var n) ? n : capturedId;
                var isConfig    = SubStore.ConfiguredIds.Any(c => c.Equals(capturedId, StringComparison.OrdinalIgnoreCase));
                @if (isConfig)
                {
                    <MudChip T="string"
                             Icon="@Icons.Material.Filled.Lock"
                             Color="Color.Default"
                             Size="Size.Small"
                             title="@($"{capturedId} — defined in configuration, not removable at runtime")">
                        @displayName
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small"
                             title="@capturedId"
                             OnClose="@(async _ => await RemoveSubAsync(capturedId))">
                        @displayName
                    </MudChip>
                }
            }
            @if (!SubStore.AllIds.Any())
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">(none configured)</MudText>
            }
        </div>

        @if (Options.ExportBlob.Enabled && SubStore.AllIds.Any())
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">Export Provisioning</MudText>
            <div class="d-flex flex-column gap-2 mb-4">
                @foreach (var sub in SubStore.AllIds)
                {
                    var capturedId = sub;
                    var displayName = _subNames.TryGetValue(capturedId, out var name) ? name : capturedId;
                    var isProvisionBusy = _provisionBusy.Contains(capturedId);
                    <div class="d-flex align-center justify-space-between gap-2 flex-wrap">
                        <MudText Typo="Typo.body2">@displayName</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="@(async () => await ReprovisionExportAsync(capturedId))"
                                   Disabled="@(_subBusy || isProvisionBusy)">
                            @(isProvisionBusy ? "Re-provisioning..." : "Re-provision Export")
                        </MudButton>
                    </div>
                }
            </div>
        }

        @* Status alert *@
        @if (_subResult is not null)
        {
            <MudAlert Severity="@_subResult.Severity" Dense="true" ShowCloseIcon="true"
                      CloseIconClicked="@(() => _subResult = null)" Class="mb-3">
                @_subResult.Message
            </MudAlert>
        }

        <MudGrid Spacing="3">
            @* ── Add manually ───────────────────────────────────────────────── *@
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Add Manually</MudText>
                    <MudTextField @bind-Value="_newSubId"
                                  Label="Subscription ID (GUID)"
                                  Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                  FullWidth
                                  Variant="Variant.Outlined"
                                  OnKeyDown="@OnSubKeyDown" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                               OnClick="AddManualAsync" Disabled="_subBusy">
                        Add
                    </MudButton>
                </MudPaper>
            </MudItem>

            @* ── Import from CSV / paste ─────────────────────────────────────── *@
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Import from CSV / Text</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                        Paste subscription IDs (one per line, or any CSV — GUIDs are extracted automatically)
                    </MudText>
                    <MudTextField @bind-Value="_csvPaste"
                                  Lines="4"
                                  FullWidth
                                  Variant="Variant.Outlined"
                                  Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                    <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   OnClick="ImportPastedAsync" Disabled="_subBusy">
                            Import Pasted
                        </MudButton>
                        <MudText Typo="Typo.caption">— or —</MudText>
                        @* Hidden file input; the MudButton acts as its label *@
                        <InputFile id="subCsvFile" OnChange="ImportFileAsync" accept=".csv,.txt" style="display:none" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   HtmlTag="label" for="subCsvFile" Disabled="_subBusy">
                            Upload .csv / .txt
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private record DailyPoint(int Day, string SubscriptionId, decimal Cost);
    private record MonthlyPoint(string Label, string SubscriptionId, decimal Cost);
    private record ServicePoint(string ServiceName, string SubscriptionId, string Label, decimal Cost);

    private bool _loading = true;
    private string? _error;
    private List<CostRow> _data = [];
    private Dictionary<string, string> _subNames = [];
    private bool _subNamesBusy;

    private decimal _totalCost;
    private decimal _costMtd;
    private decimal _costYtd;
    private decimal _avgDailyCost;
    private int _withDataSubCount;

    private List<DailyPoint> _currentMonthDaily = [];
    private List<DailyPoint> _priorMonthDaily = [];
    private List<MonthlyPoint> _monthlyTrend = [];
    private List<ServicePoint> _topServices = [];
    private List<string> _seriesSubIds = [];

    private readonly ApexChartOptions<DailyPoint> _twoLineOpts = new()
    {
        Chart  = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = [2, 2] },
        Xaxis  = new XAxis { Type = XAxisType.Numeric },
        Yaxis  = [new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(2) : ''; }" } }]
    };

    private readonly ApexChartOptions<MonthlyPoint> _barOpts = new()
    {
        Chart       = new Chart { Toolbar = new Toolbar { Show = false }, Stacked = true },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 4 } },
        Yaxis       = [new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(2) : ''; }" } }]
    };

    private readonly ApexChartOptions<ServicePoint> _hbarOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 3 } }
    };

    protected override void OnInitialized() =>
        State.OnStateChanged += RefreshData;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RefreshSubNamesAsync();
    }

    private async void RefreshData()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            _data = await CostService.GetMainCostDataAsync();
            Compute();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load cost data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Compute()
    {
        var start  = State.SelectedRange.Start ?? DateTime.Now.AddYears(-1);
        var end    = State.SelectedRange.End   ?? DateTime.Now;
        var today  = DateTime.UtcNow;
        var filtered = _data.Where(r => r.Date >= start && r.Date <= end).ToList();
        _seriesSubIds = SubStore.AllIds
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(GetSubName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _totalCost    = filtered.Sum(r => r.NormalizedCost);
        _withDataSubCount = filtered
            .Where(r => !string.IsNullOrWhiteSpace(r.SubscriptionId))
            .Select(r => r.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        // MTD and YTD are always relative to today — do NOT use the range-filtered set
        // so they remain correct even when the date picker spans multiple years.
        _costMtd      = _data.Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                             .Sum(r => r.NormalizedCost);
        _costYtd      = _data.Where(r => r.Date.Year == today.Year)
                             .Sum(r => r.NormalizedCost);
        var distinctDays = filtered.Select(r => r.Date.Date).Distinct().Count();
        _avgDailyCost = distinctDays > 0 ? _totalCost / distinctDays : 0m;

        // Daily data for current and prior month
        var curMonth  = new DateTime(today.Year, today.Month, 1);
        var priorMonth = curMonth.AddMonths(-1);
        var curDays = Enumerable.Range(1, DateTime.DaysInMonth(curMonth.Year, curMonth.Month)).ToList();
        var priorDays = Enumerable.Range(1, DateTime.DaysInMonth(priorMonth.Year, priorMonth.Month)).ToList();
        var curBySubDay = filtered
            .Where(r => r.Date.Year == curMonth.Year && r.Date.Month == curMonth.Month)
            .GroupBy(r => new { r.SubscriptionId, Day = r.Date.Day })
            .ToDictionary(g => (SubId: g.Key.SubscriptionId, g.Key.Day), g => g.Sum(r => r.NormalizedCost));
        var priorBySubDay = filtered
            .Where(r => r.Date.Year == priorMonth.Year && r.Date.Month == priorMonth.Month)
            .GroupBy(r => new { r.SubscriptionId, Day = r.Date.Day })
            .ToDictionary(g => (SubId: g.Key.SubscriptionId, g.Key.Day), g => g.Sum(r => r.NormalizedCost));

        _currentMonthDaily = _seriesSubIds
            .SelectMany(subId => curDays.Select(day => new DailyPoint(
                day,
                subId,
                curBySubDay.TryGetValue((subId, day), out var cost) ? cost : 0m)))
            .ToList();

        _priorMonthDaily = _seriesSubIds
            .SelectMany(subId => priorDays.Select(day => new DailyPoint(
                day,
                subId,
                priorBySubDay.TryGetValue((subId, day), out var cost) ? cost : 0m)))
            .ToList();

        // Monthly trend
        var monthlyTotals = filtered
            .GroupBy(r => new { r.Date.Year, r.Date.Month })
            .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
            .OrderBy(d => d)
            .ToList();

        var monthlyBySub = filtered
            .GroupBy(r => new { r.SubscriptionId, r.Date.Year, r.Date.Month })
            .ToDictionary(
                g => (SubId: g.Key.SubscriptionId, MonthStart: new DateTime(g.Key.Year, g.Key.Month, 1)),
                g => g.Sum(r => r.NormalizedCost));

        _monthlyTrend = _seriesSubIds
            .SelectMany(subId => monthlyTotals.Select(month => new MonthlyPoint(
                month.ToString("MMM yy"),
                subId,
                monthlyBySub.TryGetValue((subId, month), out var cost) ? cost : 0m)))
            .ToList();

        // Top 10 services by overall cost, then split into per-subscription series.
        var topServiceNames = filtered
            .GroupBy(r => string.IsNullOrWhiteSpace(r.ServiceName) ? "(unassigned)" : r.ServiceName)
            .Select(g => new { Service = g.Key, Cost = g.Sum(r => r.NormalizedCost) })
            .OrderByDescending(x => x.Cost)
            .Take(10)
            .Select(x => x.Service)
            .ToList();

        var serviceBySub = filtered
            .GroupBy(r => new
            {
                ServiceName = string.IsNullOrWhiteSpace(r.ServiceName) ? "(unassigned)" : r.ServiceName,
                r.SubscriptionId
            })
            .ToDictionary(g => (Service: g.Key.ServiceName, SubId: g.Key.SubscriptionId), g => g.Sum(r => r.NormalizedCost));

        _topServices = _seriesSubIds
            .SelectMany(subId => topServiceNames.Select(service => new ServicePoint(
                service,
                subId,
                service,
                serviceBySub.TryGetValue((service, subId), out var cost) ? cost : 0m)))
            .ToList();
    }

    private string GetSubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) ? name : subscriptionId;

    private string FormatCost(decimal value) => Fmt(value);

    // Re-format using injected options at component level
    [Inject] private CostManagementOptions Options { get; set; } = default!;
    private string Fmt(decimal v) => $"{v:N0} {Options.TargetCurrency}";

    public void Dispose() => State.OnStateChanged -= RefreshData;

    // ── Subscription management ──────────────────────────────────────────────

    private async Task RefreshSubNamesAsync()
    {
        if (_subNamesBusy) return;
        _subNamesBusy = true;
        try   { _subNames = await CostService.GetSubscriptionDisplayNamesAsync(); }
        catch  { /* non-fatal — chips fall back to showing the GUID */ }
        finally { _subNamesBusy = false; }
    }

    private string _newSubId  = string.Empty;
    private string _csvPaste  = string.Empty;
    private bool   _subBusy   = false;
    private readonly HashSet<string> _provisionBusy = new(StringComparer.OrdinalIgnoreCase);

    private sealed record SubResult(Severity Severity, string Message);
    private SubResult? _subResult;

    private async Task AddManualAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSubId)) return;
        var correlationId = Guid.NewGuid().ToString("N");
        _subBusy = true;
        try
        {
            var (added, invalid) = await SubStore.AddAsync([_newSubId.Trim()], correlationId);
            if (invalid.Count > 0)
                _subResult = new(Severity.Error, $"Not a valid GUID: {invalid[0]}");
            else if (added == 0)
                _subResult = new(Severity.Info, "Subscription ID is already in the list.");
            else
            {
                await RefreshSubNamesAsync();
                await InvalidateAndRefreshAllAsync(correlationId);
                var id   = _newSubId.Trim().ToLowerInvariant();
                var name = _subNames.TryGetValue(id, out var n) ? n : id;
                _subResult = new(Severity.Success,
                    name != id ? $"Subscription '{name}' added." : "Subscription added.");
                _newSubId = string.Empty;
            }
        }
        finally { _subBusy = false; }
    }

    private async Task OnSubKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddManualAsync();
    }

    private async Task ImportPastedAsync()
    {
        if (string.IsNullOrWhiteSpace(_csvPaste)) return;
        var ids = ExtractGuids(_csvPaste);
        await BulkImportAsync(ids);
        _csvPaste = string.Empty;
    }

    private async Task ImportFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            // 1 MB max; subscription ID files are tiny in practice
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 1_048_576);
            using var reader       = new StreamReader(stream);
            var text               = await reader.ReadToEndAsync();
            await BulkImportAsync(ExtractGuids(text));
        }
        catch (Exception ex)
        {
            _subResult = new(Severity.Error, $"Could not read file: {ex.Message}");
        }
    }

    private async Task BulkImportAsync(List<string> ids)
    {
        if (ids.Count == 0)
        {
            _subResult = new(Severity.Warning, "No subscription IDs (GUIDs) found in the input.");
            return;
        }
        var correlationId = Guid.NewGuid().ToString("N");
        _subBusy = true;
        try
        {
            var (added, invalid) = await SubStore.AddAsync(ids, correlationId);
            var parts = new List<string>();
            if (added   > 0) parts.Add($"{added} added");
            if (invalid.Count > 0)
            {
                var preview = string.Join(", ", invalid.Take(3));
                if (invalid.Count > 3) preview += "...";
                parts.Add($"{invalid.Count} invalid ({preview})");
            }
            var skipped = ids.Count - added - invalid.Count;
            if (skipped > 0) parts.Add($"{skipped} already present");
            _subResult = new(
                added > 0 ? Severity.Success : Severity.Warning,
                string.Join("; ", parts));

            if (added > 0)
            {
                await RefreshSubNamesAsync();
                await InvalidateAndRefreshAllAsync(correlationId);
            }
        }
        finally { _subBusy = false; }
    }

    private async Task RemoveSubAsync(string id)
    {
        var correlationId = Guid.NewGuid().ToString("N");
        await SubStore.RemoveAsync(id, correlationId);
        await RefreshSubNamesAsync();
        await InvalidateAndRefreshAllAsync(correlationId);
    }

    private async Task ReprovisionExportAsync(string id)
    {
        if (!_provisionBusy.Add(id)) return;

        var correlationId = Guid.NewGuid().ToString("N");
        var displayName = _subNames.TryGetValue(id, out var name) ? name : id;

        try
        {
            var result = await ExportProvisioner.ProvisionAsync(id, correlationId);
            _subResult = result switch
            {
                { Succeeded: true } => new(Severity.Success, $"{displayName}: {result.Message}"),
                { Skipped: true } => new(Severity.Info, $"{displayName}: {result.Message}"),
                _ => new(Severity.Error, $"{displayName}: {result.Message}")
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Home[{CorrelationId}]: export re-provisioning failed for {SubId}", correlationId, id);
            _subResult = new(Severity.Error, $"{displayName}: export re-provisioning failed - {ex.Message}");
        }
        finally
        {
            _provisionBusy.Remove(id);
        }
    }

    private Task InvalidateAndRefreshAllAsync(string correlationId)
    {
        Logger.LogInformation(
            "Home[{CorrelationId}]: invalidating cost cache and broadcasting refresh after subscription change (active count {Count}).",
            correlationId, SubStore.AllIds.Count);
        CostService.InvalidateCache();
        State.SetDateRange(State.SelectedRange);
        return Task.CompletedTask;
    }

    /// <summary>Extracts all GUIDs found anywhere in <paramref name="text"/>.</summary>
    private static List<string> ExtractGuids(string text)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(
            text,
            @"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b");
        return matches
            .Select(m => m.Value.ToLowerInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
