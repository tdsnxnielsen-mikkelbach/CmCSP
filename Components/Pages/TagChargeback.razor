@page "/tags"
@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@implements IDisposable

<PageTitle>Tag Chargeback – CSP Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Tag Chargeback</MudText>
<SubscriptionScopeBadge SelectedCount="SubStore.AllIds.Count" WithDataCount="_withDataSubCount" />

@if (!_loading && !Options.ExportBlob.Enabled)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
        Tag Chargeback data is <strong>not available via the Cost Management Query API</strong>.
        Azure does not expose tag-key grouping through the Query API endpoint — tags are only included
        in scheduled <strong>Cost Management Exports</strong> written to blob storage.
        Enable <code>AzureCostManagement:ExportBlob:Enabled = true</code> and deploy the export
        infrastructure (<code>bicep/export-sub.bicep</code>) to populate this page.
    </MudAlert>
}

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Tagged Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@Fmt(_taggedCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Untagged Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Warning">@Fmt(_untaggedCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Distinct Tag Keys</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@_tagData.Count</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Subscription Coverage</MudText>
    <MudDataGrid T="SubCoverage"
                 Items="_subCoverage"
                 Dense
                 SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="s => s.SubscriptionName" Title="Subscription" />
            <PropertyColumn Property="s => s.SubscriptionId" Title="Subscription ID" />
            <PropertyColumn Property="s => s.TotalCost" Title="Total Cost" Format="N0" />
            <PropertyColumn Property="s => s.TaggedCost" Title="Tagged Cost" Format="N0" />
            <PropertyColumn Property="s => s.UntaggedCost" Title="Untagged Cost" Format="N0" />
        </Columns>
    </MudDataGrid>
</MudPaper>

<MudGrid Spacing="3">
    @* Cost distribution – horizontal bar instead of treemap (treemap not in SeriesType) *@
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Cost Distribution by Tag</MudText>
            <ApexChart TItem="TagSeriesPoint" Options="_treemapOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="TagSeriesPoint"
                                     Items="_tagSeriesData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Tag)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Horizontal bar – top tags ranked *@
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Tag Cost Ranked</MudText>
            <ApexChart TItem="TagSeriesPoint" Options="_hbarOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="TagSeriesPoint"
                                     Items="_tagSeriesData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Tag)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Table *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Tag Reference Table</MudText>
            <MudDataGrid T="TagPoint"
                         Items="_tagData"
                         Dense
                         SortMode="SortMode.Single"
                         Filterable
                         FilterMode="DataGridFilterMode.ColumnFilterRow">
                <Columns>
                    <PropertyColumn Property="t => t.Tag"  Title="Tag Key" />
                    <PropertyColumn Property="t => t.Cost" Title="Total Cost" Format="N0" />
                    <TemplateColumn Title="Share %">
                        <CellTemplate>
                            @context.Item.SharePct.ToString("F1")%
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record TagPoint(string Tag, decimal Cost, decimal SharePct);
    private record TagSeriesPoint(string Tag, string SubscriptionId, decimal Cost);
    private record SubCoverage(string SubscriptionId, string SubscriptionName, decimal TotalCost, decimal TaggedCost, decimal UntaggedCost);

    private bool _loading = true;
    private string? _error;

    private decimal _taggedCost;
    private decimal _untaggedCost;
    private int _withDataSubCount;
    private List<TagPoint> _tagData = [];
    private List<TagSeriesPoint> _tagSeriesData = [];
    private List<SubCoverage> _subCoverage = [];
    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _seriesSubIds = [];

    private readonly ApexChartOptions<TagSeriesPoint> _treemapOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Height = 380 },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = false, BorderRadius = 3 } },
        DataLabels = new DataLabels { Enabled = false },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(2) : ''; }" } }]
    };

    private readonly ApexChartOptions<TagSeriesPoint> _hbarOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 3 } },
        DataLabels = new DataLabels { Enabled = false },
        Xaxis = new XAxis { Labels = new XAxisLabels { Formatter = "function(val) { return val != null ? parseFloat(val).toFixed(2) : ''; }" } }
    };

    protected override void OnInitialized() =>
        State.OnStateChanged += RefreshData;

    protected override async Task OnInitializedAsync() =>
        await LoadAsync();

    private async void RefreshData()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var dataTask = CostService.GetTagCostDataAsync();
            var nameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var data  = await dataTask;
            _subNames = await nameTask;
            var start = State.SelectedRange.Start ?? DateTime.Now.AddYears(-1);
            var end   = State.SelectedRange.End   ?? DateTime.Now;

            var filtered = data.Where(r => r.Date >= start && r.Date <= end).ToList();
            var total    = filtered.Sum(r => r.NormalizedCost);

            var tagged   = filtered.Where(r => !string.IsNullOrWhiteSpace(r.Tag)).ToList();
            var untagged = filtered.Where(r => string.IsNullOrWhiteSpace(r.Tag)).ToList();

            _taggedCost   = tagged.Sum(r => r.NormalizedCost);
            _untaggedCost = untagged.Sum(r => r.NormalizedCost);

            _tagData = tagged
                .GroupBy(r => r.Tag)
                .Select(g =>
                {
                    var cost = g.Sum(r => r.NormalizedCost);
                    return new TagPoint(g.Key, cost, total > 0 ? cost / total * 100m : 0m);
                })
                .OrderByDescending(t => t.Cost)
                .ToList();

            _seriesSubIds = SubStore.AllIds
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(GetSubName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var topTags = _tagData.Select(t => t.Tag).ToList();
            var tagBySub = tagged
                .GroupBy(r => new { r.Tag, r.SubscriptionId })
                .ToDictionary(g => (Tag: g.Key.Tag, SubId: g.Key.SubscriptionId), g => g.Sum(r => r.NormalizedCost));

            _tagSeriesData = _seriesSubIds
                .SelectMany(subId => topTags.Select(tag => new TagSeriesPoint(
                    tag,
                    subId,
                    tagBySub.TryGetValue((tag, subId), out var cost) ? cost : 0m)))
                .ToList();

            _subCoverage = SubStore.AllIds
                .Select(id =>
                {
                    var rows = filtered.Where(r => r.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase)).ToList();
                    var subTotal = rows.Sum(r => r.NormalizedCost);
                    var subTagged = rows.Where(r => !string.IsNullOrWhiteSpace(r.Tag)).Sum(r => r.NormalizedCost);
                    var subUntagged = rows.Where(r => string.IsNullOrWhiteSpace(r.Tag)).Sum(r => r.NormalizedCost);
                    var name = _subNames.TryGetValue(id, out var n) ? n : id;
                    return new SubCoverage(id, name, subTotal, subTagged, subUntagged);
                })
                .OrderByDescending(s => s.TotalCost)
                .ToList();

            _withDataSubCount = _subCoverage.Count(s => s.TotalCost > 0);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load tag data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string Fmt(decimal v) => $"{v:N0} {Options.TargetCurrency}";

    private string GetSubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) ? name : subscriptionId;

    public void Dispose() => State.OnStateChanged -= RefreshData;
}

