@page "/resource-groups"
@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@implements IDisposable

<PageTitle>Resource Group Breakdown – CSP Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Resource Group Breakdown</MudText>
<SubscriptionScopeBadge SelectedCount="SubStore.AllIds.Count" WithDataCount="_withDataSubCount" />

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@Fmt(_totalCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Resource Groups (top 15 shown)</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@_totalRgCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Monthly Cost (top 15)</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@Fmt(_avgMonthly)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Spacing="3">
    @* Horizontal bar – top 15 RGs *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Top 15 Resource Groups by Cost</MudText>
            <ApexChart TItem="RgSeriesPoint" Options="_hbarOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="RgSeriesPoint"
                                     Items="_chartData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.RgName)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Table *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Details</MudText>
            <MudDataGrid T="RgPoint"
                         Items="_barData"
                         Dense
                         SortMode="SortMode.Single">
                <Columns>
                    <PropertyColumn Property="r => r.RgName"       Title="Resource Group" />
                    <PropertyColumn Property="r => r.SubscriptionName" Title="Subscription" />
                    <PropertyColumn Property="r => r.TotalCost"     Title="Total Cost"    Format="N0" />
                    <PropertyColumn Property="r => r.MtdCost"       Title="MTD"           Format="N0" />
                    <TemplateColumn Title="Share %">
                        <CellTemplate>
                            @context.Item.SharePct.ToString("F1")%
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record RgPoint(
        string RgName,
        string SubscriptionName,
        decimal TotalCost,
        decimal MtdCost,
        decimal SharePct,
        decimal AvgMonthly);
    private record RgSeriesPoint(string RgName, string SubscriptionId, decimal Cost);

    private bool _loading = true;
    private string? _error;

    private decimal _totalCost;
    private decimal _avgMonthly;
    private int _totalRgCount;
    private int _withDataSubCount;
    private List<RgPoint> _barData = [];
    private List<RgSeriesPoint> _chartData = [];
    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _seriesSubIds = [];

    private readonly ApexChartOptions<RgSeriesPoint> _hbarOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Height = 420 },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 3 } },
        DataLabels = new DataLabels { Enabled = false }
    };

    protected override void OnInitialized() =>
        State.OnStateChanged += RefreshData;

    protected override async Task OnInitializedAsync() =>
        await LoadAsync();

    private async void RefreshData()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var dataTask = CostService.GetRgCostDataAsync();
            var subNameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var data  = await dataTask;
            _subNames = await subNameTask;
            var start = State.SelectedRange.Start ?? DateTime.Now.AddYears(-1);
            var end   = State.SelectedRange.End   ?? DateTime.Now;
            var today = DateTime.UtcNow;

            var filtered = data.Where(r => r.Date >= start && r.Date <= end).ToList();
            _totalCost   = filtered.Sum(r => r.NormalizedCost);
            _withDataSubCount = filtered
                .Where(r => !string.IsNullOrWhiteSpace(r.SubscriptionId))
                .Select(r => r.SubscriptionId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
            _seriesSubIds = SubStore.AllIds
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(GetSubName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var byRg = filtered
                .GroupBy(r => string.IsNullOrWhiteSpace(r.ResourceGroupName)
                    ? "(unassigned)" : r.ResourceGroupName)
                .Select(g =>
                {
                    var total        = g.Sum(r => r.NormalizedCost);
                    var mtd          = g.Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                                       .Sum(r => r.NormalizedCost);
                    var distinctMths = g.Select(r => new { r.Date.Year, r.Date.Month }).Distinct().Count();
                    return new
                    {
                        Name     = g.Key,
                        Total    = total,
                        Mtd      = mtd,
                        AvgMthly = distinctMths > 0 ? total / distinctMths : total
                    };
                })
                .OrderByDescending(x => x.Total)
                .ToList();

            _totalRgCount = byRg.Count;

            var top15 = byRg.Take(15).ToList();
            _avgMonthly = top15.Count > 0 ? top15.Average(x => x.AvgMthly) : 0m;

            var rgBySub = filtered
                .GroupBy(r => new
                {
                    RgName = string.IsNullOrWhiteSpace(r.ResourceGroupName) ? "(unassigned)" : r.ResourceGroupName,
                    r.SubscriptionId
                })
                .ToDictionary(g => (RgName: g.Key.RgName, SubId: g.Key.SubscriptionId), g => g.Sum(r => r.NormalizedCost));

            _chartData = _seriesSubIds
                .SelectMany(subId => top15.Select(rg => new RgSeriesPoint(
                    rg.Name,
                    subId,
                    rgBySub.TryGetValue((rg.Name, subId), out var cost) ? cost : 0m)))
                .ToList();

            _barData = top15
                .Select(x => new RgPoint(
                    x.Name,
                    GetTopSubForRg(filtered, x.Name),
                    x.Total,
                    x.Mtd,
                    _totalCost > 0 ? x.Total / _totalCost * 100m : 0m,
                    x.AvgMthly))
                .ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load resource group data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetSubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) ? name : subscriptionId;

    private string GetTopSubForRg(List<CostRow> filtered, string rgName)
    {
        var best = filtered
            .Where(r => (string.IsNullOrWhiteSpace(r.ResourceGroupName) ? "(unassigned)" : r.ResourceGroupName) == rgName)
            .GroupBy(r => r.SubscriptionId)
            .Select(g => new { Id = g.Key, Cost = g.Sum(r => r.NormalizedCost) })
            .OrderByDescending(x => x.Cost)
            .FirstOrDefault();
        return best is null ? string.Empty : GetSubName(best.Id);
    }

    private string Fmt(decimal v) => $"{v:N0} {Options.TargetCurrency}";

    public void Dispose() => State.OnStateChanged -= RefreshData;
}

