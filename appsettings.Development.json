{
  /*
   * LOCAL DEVELOPMENT OVERRIDES
   * ────────────────────────────────────────────────────────────────────────────
   * This file is tracked in git. It contains ONLY non-secret dev settings.
   *
   * Secrets (TenantId, ClientId, ClientSecret, SubscriptionIds) must be
   * supplied via dotnet user-secrets:
   *
   *   dotnet user-secrets init
   *   dotnet user-secrets set "AzureCostManagement:TenantId"        "<tenant-id>"
   *   dotnet user-secrets set "AzureCostManagement:ClientId"        "<client-id>"
   *   dotnet user-secrets set "AzureCostManagement:ClientSecret"    "<client-secret>"
   *   dotnet user-secrets set "AzureCostManagement:SubscriptionIds:0" "<sub-id-1>"
   *
   * User-secrets are loaded after this file and override any matching keys.
   * ────────────────────────────────────────────────────────────────────────────
   */
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "CmCSP.Services.CostManagementService": "Debug"
    }
  },
  "AzureCostManagement": {
    "TargetCurrency": "DKK",
    "CacheExpirationMinutes": 5,
    "MonthlyBudget": 125000
  }
}
