            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": "[if(contains(parameters('cleanupJobImage'), reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-01-01-preview').loginServer), createArray(createObject('server', reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2023-01-01-preview').loginServer, 'identity', 'system')), createArray())]"
