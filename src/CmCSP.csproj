<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>bb9e6b00-7c45-4ffd-91d6-98b1177930b1</UserSecretsId>

    <!-- Microsoft.Data.SqlClient (SQL data platform) requires ICU; the plain chiseled
         image runs in globalization-invariant mode and throws on SqlConnection.Open().
         Use the -extra variant (ships ICU + tzdata) and disable invariant mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- dotnet publish /t:PublishContainer defaults -->
    <ContainerRepository>cmcsp</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra</ContainerBaseImage>
    <ContainerPort>80</ContainerPort>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude sibling projects from this project's implicit globbing -->
    <Compile Remove="CmCSP.Core\**" />
    <Content Remove="CmCSP.Core\**" />
    <EmbeddedResource Remove="CmCSP.Core\**" />
    <None Remove="CmCSP.Core\**" />
    <Compile Remove="CostCollectorJob\**" />
    <Content Remove="CostCollectorJob\**" />
    <EmbeddedResource Remove="CostCollectorJob\**" />
    <None Remove="CostCollectorJob\**" />
    <Compile Remove="CostBackfillJob\**" />
    <Content Remove="CostBackfillJob\**" />
    <EmbeddedResource Remove="CostBackfillJob\**" />
    <None Remove="CostBackfillJob\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CmCSP.Core\CmCSP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Blazor-ApexCharts" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="Radzen.Blazor" Version="13.1.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.0.0" />
  </ItemGroup>

</Project>
