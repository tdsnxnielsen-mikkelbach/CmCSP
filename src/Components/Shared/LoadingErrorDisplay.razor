@if (Loading)
{
    <RadzenProgressBar Class="mb-4" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
}
@if (Error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-4" AllowClose="false">@Error</RadzenAlert>
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
}
