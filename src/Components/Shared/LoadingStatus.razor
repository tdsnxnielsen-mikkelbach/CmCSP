@implements IDisposable
@inject DataLoadingStateService LoadingState

@if (_visible)
{
    <RadzenCard Class="pa-3 mb-4" Style="border-left: 4px solid var(--rz-primary);">

        <RadzenStack AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem">

            @* ── Status icon + headline ─────────────────────────────────── *@
            @if (LoadingState.IsLoading)
            {
                <RadzenProgressBarCircular ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText TextStyle="TextStyle.Body2">
                    <strong>Loading Azure cost data</strong> – please wait…
                </RadzenText>
            }
            else if (LoadingState.IsAllDone)
            {
                <RadzenIcon Icon="check_circle"  IconColor="var(--rz-success)" />
                <RadzenText TextStyle="TextStyle.Body2"><strong>All datasets ready.</strong></RadzenText>
            }
            else
            {
                <RadzenProgressBarCircular ShowValue="false" ProgressBarStyle="ProgressBarStyle.Warning" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText TextStyle="TextStyle.Body2"><strong>Preparing…</strong></RadzenText>
            }

            <div style="flex:1" />

            @* ── Per-dataset status chips ───────────────────────────────── *@
            @foreach (var ds in LoadingState.All)
            {
                <RadzenBadge BadgeStyle="@ChipColor(ds.Phase)" Variant="Variant.Outlined">
                    @ChipIcon(ds.Phase)&nbsp;@ds.Label
                    @if (ds.Detail is not null)
                    {
                        <text>&nbsp;(@ds.Detail)</text>
                    }
                </RadzenBadge>
            }

            @* ── Dismiss button (only when all done) ───────────────────── *@
            @if (LoadingState.IsAllDone)
            {
                <RadzenButton Icon="close"  Size="ButtonSize.Small" aria-label="Dismiss" ButtonStyle="ButtonStyle.Primary" Click="@(() => _visible = false)" />
            }

        </RadzenStack>

        @* ── Progress bar ──────────────────────────────────────────────── *@
        @if (!LoadingState.IsAllDone)
        {
            <RadzenProgressBar Value="@((double)LoadingState.DoneCount * 100 / 3)" Class="mt-2" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" />
        }

    </RadzenCard>
}

@code {
    private bool _visible;
    private bool _autoDismissPending;
    private bool _disposed;
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        // Only show the banner when there is something to report (warmup not yet complete).
        _visible = !LoadingState.IsAllDone;
        LoadingState.OnChanged += HandleStateChange;
    }

    private void HandleStateChange()
    {
        // OnChanged is raised from a background thread; marshal to the circuit thread.
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            StateHasChanged();

            if (LoadingState.IsAllDone && !_autoDismissPending)
            {
                _autoDismissPending = true;
                try
                {
                    // Auto-dismiss 5 seconds after all datasets report Ready/Failed.
                    await Task.Delay(5_000, _cts.Token);
                    _visible = false;
                    StateHasChanged();
                }
                catch (OperationCanceledException) { /* component disposed */ }
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        LoadingState.OnChanged -= HandleStateChange;
        _cts.Cancel();
        _cts.Dispose();
    }

    private static BadgeStyle ChipColor(LoadPhase p) => p switch
    {
        LoadPhase.Loading => BadgeStyle.Warning,
        LoadPhase.Ready   => BadgeStyle.Success,
        LoadPhase.Failed  => BadgeStyle.Danger,
        _                 => BadgeStyle.Base
    };

    // Returns a small Unicode symbol used inline inside the chip text.
    private static string ChipIcon(LoadPhase p) => p switch
    {
        LoadPhase.Loading => "⟳",
        LoadPhase.Ready   => "✓",
        LoadPhase.Failed  => "✗",
        _                 => "·"
    };
}
