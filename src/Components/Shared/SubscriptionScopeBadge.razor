<RadzenCard Class="pa-2 mb-4 d-flex align-center flex-wrap gap-2">
    <RadzenIcon Icon="filter_alt"  IconColor="var(--rz-primary)" />
    <RadzenText Class="mr-1" TextStyle="TextStyle.Caption">@Label</RadzenText>

    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Variant="Variant.Outlined">
        @SelectedCount selected
    </RadzenBadge>

    <RadzenBadge BadgeStyle="@(_withDataColor)" Variant="Variant.Outlined">
        @WithDataCount with data
    </RadzenBadge>
</RadzenCard>

@code {
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public int WithDataCount { get; set; }
    [Parameter] public string Label { get; set; } = "Subscription scope";

    private BadgeStyle _withDataColor => WithDataCount >= SelectedCount ? BadgeStyle.Success : BadgeStyle.Warning;
}
