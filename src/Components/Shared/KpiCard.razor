@* A reusable KPI summary card. *@
<RadzenColumn Size="12" SizeSM="@Sm" SizeMD="@Md">
    <RadzenCard Class="@PaperClass">
        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@Label</RadzenText>
        <RadzenText Class="@ValueClass" TextStyle="TextStyle.H5" Style="@TextColor(ValueColor)">@Value</RadzenText>
        @if (Footer is not null)
        {
            <RadzenText Class="@FooterClass" TextStyle="TextStyle.Caption" Style="@TextColor(FooterColor)">@Footer</RadzenText>
        }
    </RadzenCard>
</RadzenColumn>

@code {
    private static string TextColor(BadgeStyle color) =>
        color == BadgeStyle.Base ? "color: var(--rz-text-color);" : $"color: var(--rz-{color.ToString().ToLowerInvariant()});";
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Footer { get; set; }
    [Parameter] public BadgeStyle ValueColor { get; set; } = BadgeStyle.Base;
    [Parameter] public BadgeStyle FooterColor { get; set; } = BadgeStyle.Secondary;
    [Parameter] public int Sm { get; set; } = 6;
    [Parameter] public int Md { get; set; } = 4;
    [Parameter] public string PaperClass { get; set; } = "pa-4";
    [Parameter] public string ValueClass { get; set; } = "mt-1 fw-bold";
    [Parameter] public string FooterClass { get; set; } = "";
}
