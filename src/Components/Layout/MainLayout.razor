@inherits LayoutComponentBase
@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject ITenantScopeProvider ScopeProvider
@inject CustomerStore Customers
@inject TenantNameService TenantName
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton data-tour="4"
                       data-tour-title="Navigation drawer"
                       data-tour-desc="Toggle the side navigation to move between the dashboard pages."
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3 fw-bold">CSP Cost Dashboard</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mr-1 d-none d-sm-flex">
                    @(context.User.FindFirst("name")?.Value ?? context.User.Identity?.Name)
                </MudText>
                <MudTooltip Text="Sign out">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   Href="/logout"
                                   aria-label="Sign out" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
        <MudTooltip Text="Take a tour of this page">
            <MudIconButton data-tour="99"
                           data-tour-title="You're all set"
                           data-tour-desc="Replay this page's tour any time from here. Enjoy exploring your Azure spend!"
                           Icon="@Icons.Material.Filled.HelpOutline"
                           Color="Color.Inherit"
                           OnClick="StartTourAsync"
                           aria-label="Take a product tour" />
        </MudTooltip>
        <MudIconButton data-tour="91"
                       data-tour-title="Light / dark mode"
                       data-tour-desc="Switch between light and dark themes to suit your preference."
                       Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme"
                       aria-label="Toggle dark / light mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-2 fw-bold">Navigation</MudText>
        </MudDrawerHeader>
        <div data-tour="5"
             data-tour-title="Dashboard pages"
             data-tour-desc="Jump to cost overviews, budgets, breakdowns by subscription or resource group, tag chargeback, trends, optimization, security and more."
             data-tour-side="right"
             data-tour-align="start">
            <NavMenu />
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

            @* ── Tenant → subscription picker (view filter, scope-safe) ───── *@
            @if (_showPicker)
            {
                <MudPaper data-tour="7"
                          data-tour-title="Subscription filter"
                          data-tour-desc="Narrow every page to specific tenants and subscriptions. This is a view filter &mdash; it never widens what you're allowed to see."
                          Class="pa-3 mb-4" Elevation="1">
                    <div class="d-flex align-center flex-wrap gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Color="Color.Primary" Class="flex-none" />
                        <MudText Typo="Typo.subtitle2" Class="flex-none">Subscriptions</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-none">
                            @_selectedDisplayCount of @_allSubIds.Count selected@(_groups.Count > 1 ? $" · {_groups.Count} tenants" : "")
                        </MudText>
                        <MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="SelectAllSubs" Class="flex-none text-lowercase">all</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="ClearAllSubs" Class="flex-none text-lowercase">none</MudButton>
                    </div>
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true">
                        @foreach (var g in _groups)
                        {
                            <MudExpansionPanel Expanded="@(_groups.Count == 1)">
                                <TitleContent>
                                    <div class="d-flex align-center gap-2">
                                        <MudCheckBox T="bool?"
                                                     TriState="true"
                                                     Value="@TenantState(g)"
                                                     ValueChanged="@((bool? v) => OnTenantToggled(g, v))"
                                                     Color="Color.Primary"
                                                     Dense="true"
                                                     @onclick:stopPropagation="true" />
                                        <MudIcon Icon="@Icons.Material.Outlined.Domain" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body2" Class="fw-bold">@g.TenantName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            (@CheckedCount(g)/@g.Subs.Count)
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    @foreach (var s in g.Subs)
                                    {
                                        <div class="d-flex align-center gap-2" style="margin-left:2.25rem">
                                            <MudCheckBox T="bool"
                                                         Value="@IsSubChecked(s.Id)"
                                                         ValueChanged="@((bool v) => OnSubToggled(s.Id, v))"
                                                         Color="Color.Primary"
                                                         Dense="true" />
                                            <div>
                                                <MudText Typo="Typo.body2">@s.Name</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@s.Id</MudText>
                                            </div>
                                        </div>
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudPaper>
            }

            @* ── Global date-range filter ─────────────────────────────────── *@
            <MudPaper data-tour="6"
                      data-tour-title="Date range"
                      data-tour-desc="Set the reporting window for all charts and totals. Use the fit-to-data button to snap to the available range."
                      Class="pa-3 mb-4 d-flex align-center flex-wrap gap-3" Elevation="1">
                <MudIcon Icon="@Icons.Material.Outlined.DateRange" Color="Color.Primary" Class="flex-none" />
                <MudText Typo="Typo.subtitle2" Class="flex-none">Date Range</MudText>
                <MudDateRangePicker DateRange="_dateRange"
                                    DateRangeChanged="OnDateRangeChanged"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    DateFormat="dd MMM yyyy"
                                    AutoClose="true"
                                    PickerVariant="PickerVariant.Dialog"
                                    Style="min-width:240px; max-width:340px" />
                <MudTooltip Text="Fit to available data range">
                    <MudIconButton Icon="@Icons.Material.Filled.FitScreen"
                                   Size="Size.Small"
                                   OnClick="FitToDataRange"
                                   aria-label="Fit to available data range" />
                </MudTooltip>
                @if (_dataMin.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-none">
                        Available: @_dataMin.Value.ToString("d MMM yyyy") – @_dataMax!.Value.ToString("d MMM yyyy")
                    </MudText>
                }
            </MudPaper>

            <LoadingStatus />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private const string ThemeStorageKey = "cmcsp-theme";
    private bool _drawerOpen = true;
    private bool _isDark;
    private bool _prevDark;
    private MudThemeProvider _themeProvider = default!;

    // Phase 9: tenant → subscription view-filter picker (replaces the old customer dropdown and
    // the read-only subscription accordion). Selection drives DashboardStateService.
    private bool _showPicker;
    private readonly List<TenantGroup> _groups = [];
    private readonly HashSet<string> _allSubIds = new(StringComparer.OrdinalIgnoreCase);
    private int _selectedDisplayCount;

    private sealed record SubItem(string Id, string Name);
    private sealed record TenantGroup(long CustomerId, string TenantId, string TenantName, List<SubItem> Subs);

    private DateRange _dateRange = new(
        new DateTime(DateTime.Now.Year - 1, 1, 1),
        DateTime.Now);

    private DateTime? _dataMin;
    private DateTime? _dataMax;

    protected override void OnInitialized()
    {
        SubStore.OnChanged += HandleSubscriptionsChanged;
        State.OnStateChanged += HandleStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await BuildGroupsAsync();
    }

    private void HandleStateChanged() => InvokeAsync(() =>
    {
        RecomputeSelectedCount();
        StateHasChanged();
    });

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDark = !_isDark;

    // ── Tenant → subscription picker ──────────────────────────────────────────

    private async Task BuildGroupsAsync()
    {
        _groups.Clear();
        _allSubIds.Clear();

        Dictionary<string, string> names;
        try { names = await CostService.GetSubscriptionDisplayNamesAsync(); }
        catch { names = []; }

        string NameOf(string id, string? stored) =>
            !string.IsNullOrWhiteSpace(stored) ? stored!
            : names.TryGetValue(id, out var n) ? n
            : id;

        if (Options.MultiTenancy.Enabled && Customers.IsEnabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            if (!scope.IsDenied)
            {
                var active = (await Customers.GetActiveCustomersAsync()).ToList();
                if (!scope.IsUnscoped && !scope.IsPartner)
                    active = active.Where(c => scope.CustomerIds.Contains(c.Id)).ToList();

                var home = await Customers.GetHomeCustomerAsync();
                foreach (var c in active.OrderBy(c => c.Id))
                {
                    var subs = (await Customers.GetSubscriptionsAsync(c.Id))
                        .Select(s => new SubItem(s.SubscriptionId, NameOf(s.SubscriptionId, s.SubscriptionName)))
                        .ToList();

                    // The home customer's subscriptions live in the home registry, not the
                    // per-customer mapping table — fall back to it so they still appear.
                    if (subs.Count == 0 && home is not null && c.Id == home.Id)
                        subs = SubStore.AllIds.Select(id => new SubItem(id, NameOf(id, null))).ToList();

                    if (subs.Count == 0) continue;

                    var tenantName = await TenantName.GetDisplayNameAsync(c.TenantId);
                    if (string.IsNullOrWhiteSpace(tenantName)) tenantName = c.DisplayName;
                    _groups.Add(new TenantGroup(c.Id, c.TenantId, tenantName, subs));
                }
            }
        }

        // Single-tenant (or no customer registry): one synthetic group of all configured subs.
        if (_groups.Count == 0 && SubStore.AllIds.Count > 0)
        {
            _groups.Add(new TenantGroup(0, string.Empty, "All subscriptions",
                SubStore.AllIds.Select(id => new SubItem(id, NameOf(id, null))).ToList()));
        }

        foreach (var id in _groups.SelectMany(g => g.Subs).Select(s => s.Id))
            _allSubIds.Add(id);

        _showPicker = _allSubIds.Count > 0;
        RecomputeSelectedCount();
    }

    private void RecomputeSelectedCount() =>
        _selectedDisplayCount = State.SelectedSubscriptionIds.Count == 0
            ? _allSubIds.Count
            : _allSubIds.Count(State.SelectedSubscriptionIds.Contains);

    private bool IsSubChecked(string id) => State.IsSubscriptionVisible(id);

    private int CheckedCount(TenantGroup g) => g.Subs.Count(s => IsSubChecked(s.Id));

    private bool? TenantState(TenantGroup g)
    {
        var n = CheckedCount(g);
        if (n == 0) return false;
        if (n == g.Subs.Count) return true;
        return null; // indeterminate
    }

    // The "all selected" default is stored as an empty set so newly-added subs stay visible.
    // Translate that to the full universe when the user starts deselecting individual entries.
    private HashSet<string> EffectiveSelected() =>
        State.SelectedSubscriptionIds.Count == 0
            ? new HashSet<string>(_allSubIds, StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(State.SelectedSubscriptionIds, StringComparer.OrdinalIgnoreCase);

    private void Commit(HashSet<string> sel)
    {
        // Normalise "everything selected" back to the empty-set sentinel.
        if (sel.Count >= _allSubIds.Count && _allSubIds.All(sel.Contains))
            State.SetSelectedSubscriptions([]);
        else
            State.SetSelectedSubscriptions(sel);
        RecomputeSelectedCount();
    }

    private void OnSubToggled(string id, bool value)
    {
        var sel = EffectiveSelected();
        if (value) sel.Add(id); else sel.Remove(id);
        Commit(sel);
    }

    private void OnTenantToggled(TenantGroup g, bool? value)
    {
        var select = value != false; // null (indeterminate click) or true → select all in tenant
        var sel = EffectiveSelected();
        foreach (var s in g.Subs)
        {
            if (select) sel.Add(s.Id); else sel.Remove(s.Id);
        }
        Commit(sel);
    }

    private void SelectAllSubs() => Commit(new HashSet<string>(_allSubIds, StringComparer.OrdinalIgnoreCase));
    private void ClearAllSubs() => Commit(new HashSet<string>(StringComparer.OrdinalIgnoreCase));

    private void HandleSubscriptionsChanged(string correlationId)
    {
        _ = InvokeAsync(async () =>
        {
            Logger.LogInformation(
                "MainLayout[{CorrelationId}]: subscriptions changed (active count {Count}). Invalidating cost cache and broadcasting state refresh.",
                correlationId, SubStore.AllIds.Count);
            CostService.InvalidateCache();
            await BuildGroupsAsync();
            State.SetDateRange(State.SelectedRange);
            StateHasChanged();
        });
    }

    private void OnDateRangeChanged(DateRange range)
    {
        _dateRange = range;
        State.SetDateRange(range);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedTheme = await GetStoredThemeAsync();
            if (storedTheme.HasValue)
            {
                _isDark = storedTheme.Value;
            }

            _prevDark = _isDark;
            await ApplyThemeToChartsAsync(_isDark);
            await PersistThemeAsync(_isDark);
            await FitToDataRange();
            await MaybeAutoStartTourAsync();

            if (storedTheme.HasValue)
            {
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        // Fires when MudBlazor restores dark preference from localStorage, or when
        // the user clicks the toggle button.
        if (_isDark != _prevDark)
        {
            _prevDark = _isDark;
            await ApplyThemeToChartsAsync(_isDark);
            await PersistThemeAsync(_isDark);
        }
    }

    private async Task<bool?> GetStoredThemeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("getThemePreference", ThemeStorageKey);
            return stored switch
            {
                "dark" => true,
                "light" => false,
                _ => null
            };
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to read theme preference from local storage.");
            return null;
        }
    }

    private async Task PersistThemeAsync(bool isDark)
    {
        try
        {
            await JS.InvokeVoidAsync("setThemePreference", ThemeStorageKey, isDark);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to persist theme preference to local storage.");
        }
    }

    private async Task ApplyThemeToChartsAsync(bool isDark)
    {
        try
        {
            // Sets window.Apex.theme so charts created on navigation use the right mode.
            // querySelectorAll will find no charts yet on first render - that is fine.
            await JS.InvokeVoidAsync("updateApexChartsTheme", isDark);
        }
        catch (Exception ex)
        {
            // Theme updates should never break data loading or page rendering.
            Logger.LogDebug(ex, "Unable to apply ApexCharts theme update.");
        }
    }

    private async Task StartTourAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cmcspTour.start");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to start the product tour.");
        }
    }

    private async Task MaybeAutoStartTourAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cmcspTour.maybeAutoStart");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to evaluate first-visit product tour.");
        }
    }

    private async Task FitToDataRange()
    {
        try
        {
            var data = await CostService.GetMainCostDataAsync();
            if (data.Count == 0) return;

            _dataMin = data.Min(r => r.Date);
            _dataMax = data.Max(r => r.Date);

            var range = new DateRange(_dataMin.Value, _dataMax.Value);
            _dateRange = range;
            State.SetDateRange(range);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Non-critical – leave the default range if data isn't available yet
        }
    }

    public void Dispose()
    {
        SubStore.OnChanged -= HandleSubscriptionsChanged;
        State.OnStateChanged -= HandleStateChanged;
    }
}
