@inherits LayoutComponentBase
@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject ITenantScopeProvider ScopeProvider
@inject CustomerStore Customers
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3 fw-bold">CSP Cost Dashboard</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mr-1 d-none d-sm-flex">
                    @(context.User.FindFirst("name")?.Value ?? context.User.Identity?.Name)
                </MudText>
                <MudTooltip Text="Sign out">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   Href="/logout"
                                   aria-label="Sign out" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme"
                       aria-label="Toggle dark / light mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-2 fw-bold">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

            @* ── Partner customer picker (multi-tenancy, partner only) ─────── *@
            @if (_showCustomerPicker)
            {
                <MudPaper Class="pa-3 mb-4 d-flex align-center flex-wrap gap-3" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Outlined.Groups" Color="Color.Primary" Class="flex-none" />
                    <MudText Typo="Typo.subtitle2" Class="flex-none">Customer</MudText>
                    <MudSelect T="long?"
                               Value="State.SelectedCustomerId"
                               ValueChanged="OnCustomerChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true"
                               Placeholder="All customers"
                               Style="min-width:260px">
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem T="long?" Value="@c.Id">@c.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-none">
                        @(State.SelectedCustomerId is null ? "Showing all customers" : "Drilled into one customer")
                    </MudText>
                </MudPaper>
            }

            @* ── Global date-range filter ─────────────────────────────────── *@
            <MudPaper Class="pa-3 mb-4 d-flex align-center flex-wrap gap-3" Elevation="1">
                <MudIcon Icon="@Icons.Material.Outlined.DateRange" Color="Color.Primary" Class="flex-none" />
                <MudText Typo="Typo.subtitle2" Class="flex-none">Date Range</MudText>
                <MudDateRangePicker DateRange="_dateRange"
                                    DateRangeChanged="OnDateRangeChanged"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    DateFormat="dd MMM yyyy"
                                    AutoClose="true"
                                    PickerVariant="PickerVariant.Dialog"
                                    Style="min-width:240px; max-width:340px" />
                <MudTooltip Text="Fit to available data range">
                    <MudIconButton Icon="@Icons.Material.Filled.FitScreen"
                                   Size="Size.Small"
                                   OnClick="FitToDataRange"
                                   aria-label="Fit to available data range" />
                </MudTooltip>
                @if (_dataMin.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-none">
                        Available: @_dataMin.Value.ToString("d MMM yyyy") – @_dataMax!.Value.ToString("d MMM yyyy")
                    </MudText>
                }
                <MudDivider Vertical="true" FlexItem="true" Class="d-none d-sm-flex mx-1" />
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.ManageAccounts"
                           EndIcon="@(_showSubs ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                           OnClick="ToggleSubsAsync"
                           Class="flex-none text-lowercase">
                    @SubStore.AllIds.Count subscription(s)
                </MudButton>
            </MudPaper>

            @if (_showSubs)
            {
                <MudPaper Class="pa-3 mb-4" Elevation="1">
                    <MudText Typo="Typo.caption" Class="fw-bold d-block mb-2" Color="Color.Secondary">
                        Configured Subscriptions (@SubStore.AllIds.Count)
                    </MudText>
                    @if (_subNamesLoading)
                    {
                        <MudProgressLinear Indeterminate Color="Color.Primary" />
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                @foreach (var id in SubStore.AllIds)
                                {
                                    var displayName = _subNames.TryGetValue(id, out var n) ? n : id;
                                    <tr>
                                        <td><MudText Typo="Typo.body2">@displayName</MudText></td>
                                        <td><MudText Typo="Typo.caption" Color="Color.Secondary">@id</MudText></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            }

            <LoadingStatus />
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private const string ThemeStorageKey = "cmcsp-theme";
    private bool _drawerOpen = true;
    private bool _isDark;
    private bool _prevDark;
    private MudThemeProvider _themeProvider = default!;

    private bool _showSubs = false;
    private bool _subNamesLoading = false;
    private Dictionary<string, string> _subNames = [];

    // Phase 9: partner customer picker (multi-tenancy, home tenant only).
    private bool _showCustomerPicker;
    private List<CmCSP.Data.CustomerEntity> _customers = [];

    private DateRange _dateRange = new(
        new DateTime(DateTime.Now.Year - 1, 1, 1),
        DateTime.Now);

    private DateTime? _dataMin;
    private DateTime? _dataMax;

    protected override void OnInitialized()
    {
        SubStore.OnChanged += HandleSubscriptionsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Show the customer picker only for the partner (home tenant) when multi-tenancy is on.
        if (Options.MultiTenancy.Enabled && Customers.IsEnabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            if (scope.IsPartner)
            {
                _customers = (await Customers.GetActiveCustomersAsync()).ToList();
                _showCustomerPicker = _customers.Count > 0;
            }
        }
    }

    private void OnCustomerChanged(long? customerId)
    {
        // Narrows (or clears) the partner's drill-in; fires OnStateChanged so all pages re-load.
        State.SetSelectedCustomer(customerId);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDark = !_isDark;

    private async Task ToggleSubsAsync()
    {
        _showSubs = !_showSubs;
        if (_showSubs)
        {
            await RefreshSubNamesAsync(force: true);
        }
    }

    private void HandleSubscriptionsChanged(string correlationId)
    {
        _ = InvokeAsync(async () =>
        {
            Logger.LogInformation(
                "MainLayout[{CorrelationId}]: subscriptions changed (active count {Count}). Invalidating cost cache and broadcasting state refresh.",
                correlationId, SubStore.AllIds.Count);
            CostService.InvalidateCache();
            State.SetDateRange(State.SelectedRange);
            if (_showSubs)
                await RefreshSubNamesAsync(force: true);
            StateHasChanged();
        });
    }

    private async Task RefreshSubNamesAsync(bool force = false)
    {
        var activeIds = SubStore.AllIds;
        if (!force && _subNames.Count > 0 && activeIds.All(id => _subNames.ContainsKey(id)))
            return;

        _subNamesLoading = true;
        StateHasChanged();
        try
        {
            _subNames = await CostService.GetSubscriptionDisplayNamesAsync();
        }
        catch
        {
            // Best-effort; falls back to showing raw IDs from Options
        }
        finally
        {
            _subNamesLoading = false;
        }
    }

    private void OnDateRangeChanged(DateRange range)
    {
        _dateRange = range;
        State.SetDateRange(range);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedTheme = await GetStoredThemeAsync();
            if (storedTheme.HasValue)
            {
                _isDark = storedTheme.Value;
            }

            _prevDark = _isDark;
            await ApplyThemeToChartsAsync(_isDark);
            await PersistThemeAsync(_isDark);
            await FitToDataRange();

            if (storedTheme.HasValue)
            {
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        // Fires when MudBlazor restores dark preference from localStorage, or when
        // the user clicks the toggle button.
        if (_isDark != _prevDark)
        {
            _prevDark = _isDark;
            await ApplyThemeToChartsAsync(_isDark);
            await PersistThemeAsync(_isDark);
        }
    }

    private async Task<bool?> GetStoredThemeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("getThemePreference", ThemeStorageKey);
            return stored switch
            {
                "dark" => true,
                "light" => false,
                _ => null
            };
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to read theme preference from local storage.");
            return null;
        }
    }

    private async Task PersistThemeAsync(bool isDark)
    {
        try
        {
            await JS.InvokeVoidAsync("setThemePreference", ThemeStorageKey, isDark);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Unable to persist theme preference to local storage.");
        }
    }

    private async Task ApplyThemeToChartsAsync(bool isDark)
    {
        try
        {
            // Sets window.Apex.theme so charts created on navigation use the right mode.
            // querySelectorAll will find no charts yet on first render - that is fine.
            await JS.InvokeVoidAsync("updateApexChartsTheme", isDark);
        }
        catch (Exception ex)
        {
            // Theme updates should never break data loading or page rendering.
            Logger.LogDebug(ex, "Unable to apply ApexCharts theme update.");
        }
    }

    private async Task FitToDataRange()
    {
        try
        {
            var data = await CostService.GetMainCostDataAsync();
            if (data.Count == 0) return;

            _dataMin = data.Min(r => r.Date);
            _dataMax = data.Max(r => r.Date);

            var range = new DateRange(_dataMin.Value, _dataMax.Value);
            _dateRange = range;
            State.SetDateRange(range);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Non-critical – leave the default range if data isn't available yet
        }
    }

    public void Dispose()
    {
        SubStore.OnChanged -= HandleSubscriptionsChanged;
    }
}
