@inherits LayoutComponentBase
@inject ThemeService Theme

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Class="pa-3">
            <RadzenIcon Icon="api" />
            <RadzenText TextStyle="TextStyle.H6" Class="fw-bold mb-0">CSP Cost Dashboard — Public API</RadzenText>
            <div style="flex:1"></div>
            <RadzenLink Path="/" Icon="dashboard" Text="Dashboard" />
            <RadzenButton Icon="@(_isDark ? "light_mode" : "dark_mode")"
                          Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                          Click="ToggleTheme" aria-label="Toggle dark / light mode" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private bool _isDark => Theme.Theme?.EndsWith("-dark", StringComparison.OrdinalIgnoreCase) == true;
    private void ToggleTheme() => Theme.SetTheme(_isDark ? "material" : "material-dark");
}
