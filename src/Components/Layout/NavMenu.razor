@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject CustomerStore Customers
@inject ITenantScopeProvider ScopeProvider

<MudNavMenu>
    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Dashboard">
        Cost Overview
    </MudNavLink>

    <MudNavLink Href="/budgets"
                Icon="@Icons.Material.Filled.AccountBalanceWallet">
        Budgets
    </MudNavLink>

    <MudNavLink Href="/subscriptions"
                Icon="@Icons.Material.Filled.CloudCircle">
        Subscription Breakdown
    </MudNavLink>

    <MudNavLink Href="/resource-groups"
                Icon="@Icons.Material.Filled.FolderOpen">
        Resource Group Breakdown
    </MudNavLink>

    <MudNavLink Href="/tags"
                Icon="@Icons.Material.Filled.Label">
        Tag Chargeback
    </MudNavLink>

    <MudNavLink Href="/trend"
                Icon="@Icons.Material.Filled.TrendingUp">
        Trend &amp; Forecast
    </MudNavLink>

    <MudNavLink Href="/waterfall"
                Icon="@Icons.Material.Filled.Equalizer">
        MoM Waterfall
    </MudNavLink>

    <MudNavLink Href="/advisor"
                Icon="@Icons.Material.Filled.Lightbulb">
        Advisor Savings
    </MudNavLink>

    <MudNavLink Href="/reservations"
                Icon="@Icons.Material.Filled.BookmarkAdded">
        Reservations
    </MudNavLink>

    <MudNavLink Href="/marketplace"
                Icon="@Icons.Material.Filled.Storefront">
        Marketplace
    </MudNavLink>

    <MudNavLink Href="/optimization"
                Icon="@Icons.Material.Filled.Savings">
        Optimization
    </MudNavLink>

    <MudNavLink Href="/security"
                Icon="@Icons.Material.Filled.Security">
        Security Posture
    </MudNavLink>

    <MudNavLink Href="/sustainability"
                Icon="@Icons.Material.Filled.EnergySavingsLeaf">
        Sustainability
    </MudNavLink>

    @if (_showCustomers)
    {
        <MudDivider Class="my-2" />
        <MudNavLink Href="/customers"
                    Icon="@Icons.Material.Filled.Groups">
            Customers
        </MudNavLink>
    }

    <MudDivider Class="my-2" />

    <MudNavLink data-tour="90"
                data-tour-title="Refresh data"
                data-tour-desc="Re-fetch the latest collected cost data on demand."
                data-tour-side="right"
                data-tour-align="start"
                Icon="@(_refreshing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Refresh)"
                Disabled="_refreshing"
                @onclick="RefreshAsync">
        @(_refreshing ? "Refreshing…" : "Refresh Data")
    </MudNavLink>
</MudNavMenu>

@code {
    private bool _refreshing;
    private bool _showCustomers;

    protected override async Task OnInitializedAsync()
    {
        // Customers admin link is partner-only and gated behind multi-tenancy.
        if (Options.MultiTenancy.Enabled && Customers.IsEnabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            _showCustomers = scope.IsPartner;
        }
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        CostService.InvalidateCache();
        State.SetDateRange(State.SelectedRange); // fires OnStateChanged → all pages re-fetch
        await Task.Yield();
        _refreshing = false;
    }
}

