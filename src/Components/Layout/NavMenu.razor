@inject ICostManagementService CostService
@inject DashboardStateService State
@inject CostManagementOptions Options
@inject CustomerStore Customers
@inject ITenantScopeProvider ScopeProvider

<RadzenPanelMenu>
    <RadzenPanelMenuItem Path="/" Match="NavLinkMatch.All" Icon="dashboard" Text="Cost Overview" />
    <RadzenPanelMenuItem Path="/budgets" Icon="account_balance_wallet" Text="Budgets" />
    <RadzenPanelMenuItem Path="/subscriptions" Icon="cloud_circle" Text="Subscription Breakdown" />
    <RadzenPanelMenuItem Path="/resource-groups" Icon="folder_open" Text="Resource Group Breakdown" />
    <RadzenPanelMenuItem Path="/tags" Icon="label" Text="Tag Chargeback" />
    <RadzenPanelMenuItem Path="/trend" Icon="trending_up" Text="Trend &amp; Forecast" />
    <RadzenPanelMenuItem Path="/waterfall" Icon="equalizer" Text="MoM Waterfall" />
    <RadzenPanelMenuItem Path="/advisor" Icon="lightbulb" Text="Advisor Savings" />
    <RadzenPanelMenuItem Path="/reservations" Icon="bookmark_added" Text="Reservations" />
    <RadzenPanelMenuItem Path="/marketplace" Icon="storefront" Text="Marketplace" />
    <RadzenPanelMenuItem Path="/optimization" Icon="savings" Text="Optimization" />
    <RadzenPanelMenuItem Path="/security" Icon="security" Text="Security Posture" />
    <RadzenPanelMenuItem Path="/sustainability" Icon="eco" Text="Sustainability" />
    @if (_showCustomers)
    {
        <RadzenPanelMenuItem Path="/customers" Icon="groups" Text="Customers" />
    }
    <RadzenPanelMenuItem Path="/public-api" Icon="api" Text="Public API" />
</RadzenPanelMenu>
<div class="pa-3" data-tour="90" data-tour-title="Refresh data"
     data-tour-desc="Re-fetch the latest collected cost data on demand."
     data-tour-side="right" data-tour-align="start">
    <RadzenButton Icon="refresh" Text="@(_refreshing ? "Refreshing..." : "Refresh Data")"
                  Disabled="_refreshing" Click="RefreshAsync" Variant="Radzen.Variant.Text" />
</div>

@code {
    private bool _refreshing;
    private bool _showCustomers;

    protected override async Task OnInitializedAsync()
    {
        if (Options.MultiTenancy.Enabled && Customers.IsEnabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            _showCustomers = scope.IsPartner;
        }
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        CostService.InvalidateCache();
        State.SetDateRange(State.SelectedRange);
        await Task.Yield();
        _refreshing = false;
    }
}
