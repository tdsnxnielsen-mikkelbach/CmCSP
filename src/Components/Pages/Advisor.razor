@page "/advisor"
@inherits CostPageBase

<PageTitle>Advisor Overview – CSP Dashboard</PageTitle>

<PageTour />

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<RadzenText Class="mb-4 fw-bold" data-tour="10" data-tour-title="Advisor Overview" data-tour-desc="Azure Advisor cost recommendations, category health scores, and estimated savings across your subscriptions." TextStyle="TextStyle.H5">Advisor Overview</RadzenText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_scoredSubCount" />

<RadzenCard Class="pa-4 mb-4" data-tour="12" data-tour-title="Advisor scope" data-tour-desc="Focus the recommendations on one subscription or all selected subscriptions.">
    <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Advisor Scope</RadzenText>
    <RadzenDropDown TValue="string"
                    Value="@_selectedAdvisorSubId"
                    Change="@(value => OnAdvisorSubChanged((string)value))"
                    Data="@AdvisorScopeOptions"
                    TextProperty="Label"
                    ValueProperty="Id"
                    aria-label="Subscription"
                    Class="advisor-scope-select" />
</RadzenCard>

@* ── Category health scores ─────────────────────────────────────────────────── *@
@if (!_loading && (_scores.Count > 0 || _error is null))
{
    <RadzenText Class="mb-2 fw-bold" TextStyle="TextStyle.Subtitle1">Advisor Health Scores</RadzenText>
    <RadzenRow Class="mb-2" Gap="1rem">
        @foreach (var cat in _categoryOrder)
        {
            var score = _avgScores.TryGetValue(cat.Key, out var s) ? s : null;
            var noIssues = score.HasValue && score.Value >= 99.9;
            var noData   = score is null;
            <RadzenColumn Size="12" SizeSM="6" SizeMD="@(12 / _categoryOrder.Count)">
                <RadzenCard Class="pa-4">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@cat.Label</RadzenText>
                    @if (noData)
                    {
                        <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-text-color);">—</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">no data</RadzenText>
                    }
                    else if (noIssues)
                    {
                        <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-success);">✓</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">No open recommendations</RadzenText>
                    }
                    else
                    {
                        <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="@($"color: var(--rz-{(ScoreColor(score!.Value)).ToString().ToLowerInvariant()});")">
                            @score!.Value.ToString("F0")%
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="@($"color: var(--rz-{(ScoreColor(score!.Value)).ToString().ToLowerInvariant()});")">
                            @ScoreLabel(score!.Value)
                        </RadzenText>
                    }
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>

    @* Scope note ────────────────────────────────────────────────────────────── *@
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4" Icon="info"  AllowClose="false">
        KPI cards above are summarized across <strong>all selected subscriptions</strong>.
        Detail scope below: <strong>@_advisorScopeLabel</strong>.
        Score data currently returned for @_scopedScoredSubCount subscription(s) in this scope.
        Detailed recommendations below are limited to the <strong>Cost</strong> category — the only one with direct financial impact
        that belongs in a cost dashboard. <strong>Security</strong> and <strong>Reliability</strong> scores are shown here for
        situational awareness only; act on them in
        <a href="https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/0" target="_blank" rel="noopener">Microsoft Defender for Cloud</a>
        and <a href="https://portal.azure.com/#view/Microsoft_Azure_Monitoring/AzureMonitoringBrowseBlade/~/overview" target="_blank" rel="noopener">Azure Monitor</a>
        respectively.
    </RadzenAlert>
}

@* ── Cost recommendations ───────────────────────────────────────────────────── *@
<RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Cost Recommendations</RadzenText>

@if (!_loading && _summaryRecCount == 0 && _error is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">
        No open Cost recommendations — all resources appear right-sized.
        If you expect recommendations, confirm the <strong>Reader</strong> role is assigned to the app registration
        on each subscription. New resources may take up to 24 hours to appear in Advisor.
    </RadzenAlert>
}
else if (_summaryRecCount > 0)
{
    @* ── KPI cards ─────────────────────────────────────────────────────────── *@
    <RadzenRow Class="mb-4" Gap="1rem">
        <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="pa-4">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Total Potential Annual Savings</RadzenText>
                <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-success);">@Fmt(_totalSavings)</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@_summaryRecCount recommendation(s)</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="pa-4">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">High Impact</RadzenText>
                <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-danger);">@_highCount</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@Fmt(_highSavings) potential saving</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="pa-4">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Medium Impact</RadzenText>
                <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-warning);">@_mediumCount</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@Fmt(_mediumSavings) potential saving</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="pa-4">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Low Impact</RadzenText>
                <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5">@_lowCount</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@Fmt(_lowSavings) potential saving</RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @if (_visibleRecs.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4" AllowClose="false">
            No cost recommendations in the current scope (<strong>@_advisorScopeLabel</strong>).
            KPI cards above still show totals across all selected subscriptions.
        </RadzenAlert>
    }

    @* ── Charts ───────────────────────────────────────────────────────────── *@
    <RadzenRow Class="mb-4" Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Class="pa-4">
                <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Potential Savings by Subscription</RadzenText>
                <ApexChart TItem="SubPoint" Options="_hbarOpts">
                    <ApexPointSeries TItem="SubPoint"
                                     Items="_bySub"
                                     Name="Annual Saving"
                                     XValue="@(e => e.Name)"
                                     YValue="@(e => (decimal?)e.Saving)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Class="pa-4">
                <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Top Resource Types by Saving Opportunity</RadzenText>
                <ApexChart TItem="TypePoint" Options="_hbarOpts2">
                    <ApexPointSeries TItem="TypePoint"
                                     Items="_byType"
                                     Name="Annual Saving"
                                     XValue="@(e => e.Name)"
                                     YValue="@(e => (decimal?)e.Saving)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @* ── Recommendations table ────────────────────────────────────────────── *@
    <RadzenCard Class="pa-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">All Cost Recommendations</RadzenText>
        <RadzenDataGrid FilterMode="Radzen.FilterMode.Simple" TItem="AdvisorGridRow" Data="@AdvisorGridRows" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="true" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="Recommendation.SubscriptionName" Title="Subscription" Sortable="true" TItem="AdvisorGridRow" />
                @if (ShowTenantColumn)
                {
                    <RadzenDataGridColumn Title="Tenant" Sortable="true" TItem="AdvisorGridRow" Property="Tenant">
                        <Template Context="context">@context.Tenant</Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn Property="Recommendation.ImpactedValue" Title="Resource" Sortable="true" TItem="AdvisorGridRow" />
                <RadzenDataGridColumn Title="Resource Type" Sortable="true" TItem="AdvisorGridRow" Property="Recommendation.ImpactedField">
                    <Template Context="context">
                        <RadzenStack Gap="0" MouseEnter="@(element => Tooltips.Open(element, context.Recommendation.ImpactedField))" MouseLeave="@(_ => Tooltips.Close())">
                            <RadzenText TextStyle="TextStyle.Body2">@FormatResourceType(context.Recommendation.ImpactedField)</RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Impact" Sortable="true" TItem="AdvisorGridRow" Property="Recommendation.Impact" SortProperty="ImpactRank">
                    <Template Context="context">
                        <RadzenBadge BadgeStyle="@ImpactColor(context.Recommendation.Impact)" Variant="Variant.Outlined">
                            @context.Recommendation.Impact
                        </RadzenBadge>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Recommendation.Problem" Title="Problem" Sortable="false" TItem="AdvisorGridRow" />
                <RadzenDataGridColumn Title="Annual Saving" Sortable="true" TItem="AdvisorGridRow" Property="Recommendation.NormalizedAnnualSavings">
                    <Template Context="context">
                        <RadzenText Class="fw-bold" TextStyle="TextStyle.Body2" Style="color: var(--rz-success);">
                            @(context.Recommendation.NormalizedAnnualSavings > 0
                                ? Fmt(context.Recommendation.NormalizedAnnualSavings)
                                : "—")
                        </RadzenText>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private const string AllSubsToken = "__all__";
    private IEnumerable<AdvisorScopeOption> AdvisorScopeOptions =>
        new[] { new AdvisorScopeOption(AllSubsToken, "All selected subscriptions") }
            .Concat(GetOrderedSubscriptionIds().Select(id => new AdvisorScopeOption(id, SubChartLabel(id))));
    private record AdvisorScopeOption(string Id, string Label);
    private record AdvisorGridRow(AdvisorRecommendation Recommendation, string Tenant, int ImpactRank);
    private IEnumerable<AdvisorGridRow> AdvisorGridRows => _visibleRecs.Select(recommendation =>
        new AdvisorGridRow(recommendation, SubTenantName(recommendation.SubscriptionId), ImpactOrder(recommendation.Impact)));

    private record SubPoint(string Name, decimal Saving);
    private record TypePoint(string Name, decimal Saving);
    private record CategoryMeta(string Key, string Label);

    private static readonly List<CategoryMeta> _categoryOrder =
    [
        new("advisor",               "Overall"),
        new("cost",                  "Cost"),
        new("security",              "Security"),
        new("reliability",           "Reliability"),
        new("operationalExcellence", "Operational Excellence"),
        new("performance",           "Performance"),
    ];

    private string _selectedAdvisorSubId = AllSubsToken;
    private string _advisorScopeLabel = "All selected subscriptions";

    private List<AdvisorCategoryScore>  _scores = [];
    private List<AdvisorCategoryScore>  _visibleScores = [];
    private List<AdvisorRecommendation> _recs   = [];
    private List<AdvisorRecommendation> _visibleRecs = [];

    // Average score per category across all subscriptions (null = no data returned)
    private Dictionary<string, double?> _avgScores = new(StringComparer.OrdinalIgnoreCase);

    private decimal _totalSavings;
    private int _highCount;   private decimal _highSavings;
    private int _mediumCount; private decimal _mediumSavings;
    private int _lowCount;    private decimal _lowSavings;

    private List<SubPoint>  _bySub  = [];
    private List<TypePoint> _byType = [];
    private int _scoredSubCount;
    private int _scopedScoredSubCount;
    private int _summaryRecCount;

    private readonly ApexChartOptions<SubPoint> _hbarOpts = ApexChartPresets.HorizontalBar<SubPoint>().WithIntXAxis();

    private readonly ApexChartOptions<TypePoint> _hbarOpts2 = ApexChartPresets.HorizontalBar<TypePoint>().WithIntXAxis();

    protected override async Task LoadAsync(CancellationToken ct)
    {
        await RunLoadAsync(async () =>
        {
            // Both calls are likely cache hits after the first load; run concurrently.
            var scoresTask = CostService.GetAdvisorScoresAsync(ct);
            var recsTask   = CostService.GetAdvisorRecommendationsAsync(ct);
            var namesTask  = CostService.GetSubscriptionDisplayNamesAsync(ct);
            _scores = await scoresTask;
            _recs   = await recsTask;
            _subNames = await namesTask;

            if (_selectedAdvisorSubId != AllSubsToken
                && !_scopeSubIds.Contains(_selectedAdvisorSubId))
            {
                _selectedAdvisorSubId = AllSubsToken;
            }

            Compute();
        }, ct);
    }

    private void Compute()
    {
        var allSelectedIds = GetOrderedSubscriptionIds();

        var scopedIds = _selectedAdvisorSubId == AllSubsToken
            ? allSelectedIds
            : [ _selectedAdvisorSubId ];

        _advisorScopeLabel = _selectedAdvisorSubId == AllSubsToken
            ? "All selected subscriptions"
            : SubChartLabel(_selectedAdvisorSubId);

        var summaryScores = _scores
            .Where(s => allSelectedIds.Contains(s.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();
        var summaryRecs = _recs
            .Where(r => allSelectedIds.Contains(r.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();

        _visibleScores = _scores
            .Where(s => scopedIds.Contains(s.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();
        _visibleRecs = _recs
            .Where(r => scopedIds.Contains(r.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();

        _scopedScoredSubCount = _visibleScores
            .Select(s => s.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        _scoredSubCount = summaryScores
            .Select(s => s.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        // Average score per category across all selected subscriptions.
        _avgScores = _categoryOrder
            .Select(c => c.Key)
            .ToDictionary(
                key => key,
                key =>
                {
                    var vals = summaryScores
                        .Where(s => s.Category.Equals(key, StringComparison.OrdinalIgnoreCase)
                                 && s.Score.HasValue)
                        .Select(s => s.Score!.Value)
                        .ToList();
                    return vals.Count > 0 ? (double?)vals.Average() : null;
                },
                StringComparer.OrdinalIgnoreCase);

        _summaryRecCount = summaryRecs.Count;
        _totalSavings = summaryRecs.Sum(r => r.NormalizedAnnualSavings);

        var high   = summaryRecs.Where(r => r.Impact.Equals("High",   StringComparison.OrdinalIgnoreCase)).ToList();
        var medium = summaryRecs.Where(r => r.Impact.Equals("Medium", StringComparison.OrdinalIgnoreCase)).ToList();
        var low    = summaryRecs.Where(r => r.Impact.Equals("Low",    StringComparison.OrdinalIgnoreCase)).ToList();

        _highCount   = high.Count;   _highSavings   = high.Sum(r => r.NormalizedAnnualSavings);
        _mediumCount = medium.Count; _mediumSavings = medium.Sum(r => r.NormalizedAnnualSavings);
        _lowCount    = low.Count;    _lowSavings    = low.Sum(r => r.NormalizedAnnualSavings);

        var savingsBySubId = _visibleRecs
            .GroupBy(r => r.SubscriptionId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => Math.Round(g.Sum(r => r.NormalizedAnnualSavings), 0), StringComparer.OrdinalIgnoreCase);

        _bySub = scopedIds
            .Select(id => new SubPoint(
                SubChartLabel(id),
                savingsBySubId.TryGetValue(id, out var saving) ? saving : 0m))
            .OrderByDescending(p => p.Saving)
            .ToList();

        _byType = _visibleRecs
            .GroupBy(r => FormatResourceType(r.ImpactedField))
            .Select(g => new TypePoint(g.Key, Math.Round(g.Sum(r => r.NormalizedAnnualSavings), 0)))
            .Where(p => p.Saving > 0)
            .OrderByDescending(p => p.Saving)
            .Take(10)
            .ToList();
    }

    private Task OnAdvisorSubChanged(string subId)
    {
        _selectedAdvisorSubId = subId;
        Compute();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string FormatResourceType(string impactedField)
    {
        if (string.IsNullOrWhiteSpace(impactedField)) return "(unknown)";
        return impactedField.StartsWith("Microsoft.", StringComparison.OrdinalIgnoreCase)
            ? impactedField["Microsoft.".Length..]
            : impactedField;
    }

    private static BadgeStyle ScoreColor(double score) => score switch
    {
        >= 80 => BadgeStyle.Success,
        >= 60 => BadgeStyle.Warning,
        _     => BadgeStyle.Danger
    };

    private static string ScoreLabel(double score) => score switch
    {
        >= 80 => "Good",
        >= 60 => "Needs attention",
        _     => "Critical"
    };

    private static BadgeStyle ImpactColor(string impact) => impact switch
    {
        { } s when s.Equals("High",   StringComparison.OrdinalIgnoreCase) => BadgeStyle.Danger,
        { } s when s.Equals("Medium", StringComparison.OrdinalIgnoreCase) => BadgeStyle.Warning,
        _ => BadgeStyle.Base
    };

    private static int ImpactOrder(string impact) => impact switch
    {
        { } s when s.Equals("High",   StringComparison.OrdinalIgnoreCase) => 0,
        { } s when s.Equals("Medium", StringComparison.OrdinalIgnoreCase) => 1,
        _ => 2
    };

}
