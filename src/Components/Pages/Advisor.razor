@page "/advisor"
@inherits CostPageBase

<PageTitle>Advisor Overview – CSP Dashboard</PageTitle>

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Advisor Overview</MudText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_scoredSubCount" />

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Advisor Scope</MudText>
    <MudSelect T="string"
               Value="_selectedAdvisorSubId"
               ValueChanged="OnAdvisorSubChanged"
               Label="Subscription"
               Variant="Variant.Outlined"
               Dense="true"
               Class="advisor-scope-select">
        <MudSelectItem T="string" Value="@AllSubsToken">All selected subscriptions</MudSelectItem>
        @foreach (var id in SubStore.AllIds)
        {
            var capturedId = id;
            <MudSelectItem T="string" Value="@capturedId">@GetSubName(capturedId)</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@* ── Category health scores ─────────────────────────────────────────────────── *@
@if (!_loading && (_scores.Count > 0 || _error is null))
{
    <MudText Typo="Typo.subtitle1" Class="mb-2 fw-bold">Advisor Health Scores</MudText>
    <MudGrid Spacing="3" Class="mb-2">
        @foreach (var cat in _categoryOrder)
        {
            var score = _avgScores.TryGetValue(cat.Key, out var s) ? s : null;
            var noIssues = score.HasValue && score.Value >= 99.9;
            var noData   = score is null;
            <MudItem xs="12" sm="6" md="@(12 / _categoryOrder.Count)">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@cat.Label</MudText>
                    @if (noData)
                    {
                        <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Default">—</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">no data</MudText>
                    }
                    else if (noIssues)
                    {
                        <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Success">✓</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Success">No open recommendations</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="@ScoreColor(score!.Value)">
                            @score!.Value.ToString("F0")%
                        </MudText>
                        <MudText Typo="Typo.caption" Color="@ScoreColor(score!.Value)">
                            @ScoreLabel(score!.Value)
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @* Scope note ────────────────────────────────────────────────────────────── *@
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
        KPI cards above are summarized across <strong>all selected subscriptions</strong>.
        Detail scope below: <strong>@_advisorScopeLabel</strong>.
        Score data currently returned for @_scopedScoredSubCount subscription(s) in this scope.
        Detailed recommendations below are limited to the <strong>Cost</strong> category — the only one with direct financial impact
        that belongs in a cost dashboard. <strong>Security</strong> and <strong>Reliability</strong> scores are shown here for
        situational awareness only; act on them in
        <a href="https://portal.azure.com/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/0" target="_blank" rel="noopener">Microsoft Defender for Cloud</a>
        and <a href="https://portal.azure.com/#view/Microsoft_Azure_Monitoring/AzureMonitoringBrowseBlade/~/overview" target="_blank" rel="noopener">Azure Monitor</a>
        respectively.
    </MudAlert>
}

@* ── Cost recommendations ───────────────────────────────────────────────────── *@
<MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Cost Recommendations</MudText>

@if (!_loading && _summaryRecCount == 0 && _error is null)
{
    <MudAlert Severity="Severity.Success">
        No open Cost recommendations — all resources appear right-sized.
        If you expect recommendations, confirm the <strong>Reader</strong> role is assigned to the app registration
        on each subscription. New resources may take up to 24 hours to appear in Advisor.
    </MudAlert>
}
else if (_summaryRecCount > 0)
{
    @* ── KPI cards ─────────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Potential Annual Savings</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Success">@Fmt(_totalSavings)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_summaryRecCount recommendation(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">High Impact</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Error">@_highCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Fmt(_highSavings) potential saving</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Medium Impact</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Warning">@_mediumCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Fmt(_mediumSavings) potential saving</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Low Impact</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@_lowCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Fmt(_lowSavings) potential saving</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_visibleRecs.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No cost recommendations in the current scope (<strong>@_advisorScopeLabel</strong>).
            KPI cards above still show totals across all selected subscriptions.
        </MudAlert>
    }

    @* ── Charts ───────────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Potential Savings by Subscription</MudText>
                <ApexChart TItem="SubPoint" Options="_hbarOpts">
                    <ApexPointSeries TItem="SubPoint"
                                     Items="_bySub"
                                     Name="Annual Saving"
                                     XValue="@(e => e.Name)"
                                     YValue="@(e => (decimal?)e.Saving)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Top Resource Types by Saving Opportunity</MudText>
                <ApexChart TItem="TypePoint" Options="_hbarOpts2">
                    <ApexPointSeries TItem="TypePoint"
                                     Items="_byType"
                                     Name="Annual Saving"
                                     XValue="@(e => e.Name)"
                                     YValue="@(e => (decimal?)e.Saving)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Recommendations table ────────────────────────────────────────────── *@
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">All Cost Recommendations</MudText>
        <MudDataGrid T="AdvisorRecommendation"
                     Items="_visibleRecs"
                     Filterable="true"
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     SortMode="SortMode.Multiple"
                     Striped="true"
                     Dense="true"
                     Hover="true">
            <Columns>
                <PropertyColumn Property="r => r.SubscriptionName" Title="Subscription" Sortable="true" />
                <PropertyColumn Property="r => r.ImpactedValue" Title="Resource" Sortable="true" />
                <TemplateColumn Title="Resource Type" Sortable="true" SortBy="r => r.ImpactedField">
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.ImpactedField">
                            <MudText Typo="Typo.body2">@FormatResourceType(context.Item.ImpactedField)</MudText>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Impact" Sortable="true" SortBy="r => ImpactOrder(r.Impact)">
                    <CellTemplate>
                        <MudChip T="string"
                                 Color="@ImpactColor(context.Item.Impact)"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined">
                            @context.Item.Impact
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="r => r.Problem" Title="Problem" Sortable="false" />
                <TemplateColumn Title="Annual Saving" Sortable="true" SortBy="r => r.NormalizedAnnualSavings">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Color="Color.Success" Class="fw-bold">
                            @(context.Item.NormalizedAnnualSavings > 0
                                ? Fmt(context.Item.NormalizedAnnualSavings)
                                : "—")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private const string AllSubsToken = "__all__";

    private record SubPoint(string Name, decimal Saving);
    private record TypePoint(string Name, decimal Saving);
    private record CategoryMeta(string Key, string Label);

    private static readonly List<CategoryMeta> _categoryOrder =
    [
        new("advisor",               "Overall"),
        new("cost",                  "Cost"),
        new("security",              "Security"),
        new("reliability",           "Reliability"),
        new("operationalExcellence", "Operational Excellence"),
        new("performance",           "Performance"),
    ];

    private string _selectedAdvisorSubId = AllSubsToken;
    private string _advisorScopeLabel = "All selected subscriptions";

    private List<AdvisorCategoryScore>  _scores = [];
    private List<AdvisorCategoryScore>  _visibleScores = [];
    private List<AdvisorRecommendation> _recs   = [];
    private List<AdvisorRecommendation> _visibleRecs = [];

    // Average score per category across all subscriptions (null = no data returned)
    private Dictionary<string, double?> _avgScores = new(StringComparer.OrdinalIgnoreCase);

    private decimal _totalSavings;
    private int _highCount;   private decimal _highSavings;
    private int _mediumCount; private decimal _mediumSavings;
    private int _lowCount;    private decimal _lowSavings;

    private List<SubPoint>  _bySub  = [];
    private List<TypePoint> _byType = [];
    private int _scoredSubCount;
    private int _scopedScoredSubCount;
    private int _summaryRecCount;

    private readonly ApexChartOptions<SubPoint> _hbarOpts = ApexChartPresets.HorizontalBar<SubPoint>().WithIntXAxis();

    private readonly ApexChartOptions<TypePoint> _hbarOpts2 = ApexChartPresets.HorizontalBar<TypePoint>().WithIntXAxis();

    protected override async Task LoadAsync()
    {
        await RunLoadAsync(async () =>
        {
            // Both calls are likely cache hits after the first load; run concurrently.
            var scoresTask = CostService.GetAdvisorScoresAsync();
            var recsTask   = CostService.GetAdvisorRecommendationsAsync();
            var namesTask  = CostService.GetSubscriptionDisplayNamesAsync();
            _scores = await scoresTask;
            _recs   = await recsTask;
            _subNames = await namesTask;

            if (_selectedAdvisorSubId != AllSubsToken
                && !SubStore.AllIds.Any(id => id.Equals(_selectedAdvisorSubId, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedAdvisorSubId = AllSubsToken;
            }

            Compute();
        });
    }

    private void Compute()
    {
        var allSelectedIds = SubStore.AllIds
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var scopedIds = _selectedAdvisorSubId == AllSubsToken
            ? SubStore.AllIds.Distinct(StringComparer.OrdinalIgnoreCase).ToList()
            : [ _selectedAdvisorSubId ];

        _advisorScopeLabel = _selectedAdvisorSubId == AllSubsToken
            ? "All selected subscriptions"
            : GetSubName(_selectedAdvisorSubId);

        var summaryScores = _scores
            .Where(s => allSelectedIds.Contains(s.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();
        var summaryRecs = _recs
            .Where(r => allSelectedIds.Contains(r.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();

        _visibleScores = _scores
            .Where(s => scopedIds.Contains(s.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();
        _visibleRecs = _recs
            .Where(r => scopedIds.Contains(r.SubscriptionId, StringComparer.OrdinalIgnoreCase))
            .ToList();

        _scopedScoredSubCount = _visibleScores
            .Select(s => s.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        _scoredSubCount = summaryScores
            .Select(s => s.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        // Average score per category across all selected subscriptions.
        _avgScores = _categoryOrder
            .Select(c => c.Key)
            .ToDictionary(
                key => key,
                key =>
                {
                    var vals = summaryScores
                        .Where(s => s.Category.Equals(key, StringComparison.OrdinalIgnoreCase)
                                 && s.Score.HasValue)
                        .Select(s => s.Score!.Value)
                        .ToList();
                    return vals.Count > 0 ? (double?)vals.Average() : null;
                },
                StringComparer.OrdinalIgnoreCase);

        _summaryRecCount = summaryRecs.Count;
        _totalSavings = summaryRecs.Sum(r => r.NormalizedAnnualSavings);

        var high   = summaryRecs.Where(r => r.Impact.Equals("High",   StringComparison.OrdinalIgnoreCase)).ToList();
        var medium = summaryRecs.Where(r => r.Impact.Equals("Medium", StringComparison.OrdinalIgnoreCase)).ToList();
        var low    = summaryRecs.Where(r => r.Impact.Equals("Low",    StringComparison.OrdinalIgnoreCase)).ToList();

        _highCount   = high.Count;   _highSavings   = high.Sum(r => r.NormalizedAnnualSavings);
        _mediumCount = medium.Count; _mediumSavings = medium.Sum(r => r.NormalizedAnnualSavings);
        _lowCount    = low.Count;    _lowSavings    = low.Sum(r => r.NormalizedAnnualSavings);

        var savingsBySubId = _visibleRecs
            .GroupBy(r => r.SubscriptionId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => Math.Round(g.Sum(r => r.NormalizedAnnualSavings), 0), StringComparer.OrdinalIgnoreCase);

        _bySub = scopedIds
            .Select(id =>
            {
                var name = GetSubName(id);
                return new SubPoint(name, savingsBySubId.TryGetValue(id, out var saving) ? saving : 0m);
            })
            .OrderByDescending(p => p.Saving)
            .ToList();

        _byType = _visibleRecs
            .GroupBy(r => FormatResourceType(r.ImpactedField))
            .Select(g => new TypePoint(g.Key, Math.Round(g.Sum(r => r.NormalizedAnnualSavings), 0)))
            .Where(p => p.Saving > 0)
            .OrderByDescending(p => p.Saving)
            .Take(10)
            .ToList();
    }

    private Task OnAdvisorSubChanged(string subId)
    {
        _selectedAdvisorSubId = subId;
        Compute();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string FormatResourceType(string impactedField)
    {
        if (string.IsNullOrWhiteSpace(impactedField)) return "(unknown)";
        return impactedField.StartsWith("Microsoft.", StringComparison.OrdinalIgnoreCase)
            ? impactedField["Microsoft.".Length..]
            : impactedField;
    }

    private static Color ScoreColor(double score) => score switch
    {
        >= 80 => Color.Success,
        >= 60 => Color.Warning,
        _     => Color.Error
    };

    private static string ScoreLabel(double score) => score switch
    {
        >= 80 => "Good",
        >= 60 => "Needs attention",
        _     => "Critical"
    };

    private static Color ImpactColor(string impact) => impact switch
    {
        { } s when s.Equals("High",   StringComparison.OrdinalIgnoreCase) => Color.Error,
        { } s when s.Equals("Medium", StringComparison.OrdinalIgnoreCase) => Color.Warning,
        _ => Color.Default
    };

    private static int ImpactOrder(string impact) => impact switch
    {
        { } s when s.Equals("High",   StringComparison.OrdinalIgnoreCase) => 0,
        { } s when s.Equals("Medium", StringComparison.OrdinalIgnoreCase) => 1,
        _ => 2
    };

}
