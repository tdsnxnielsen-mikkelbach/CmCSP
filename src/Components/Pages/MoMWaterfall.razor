@page "/waterfall"
@inherits CostPageBase

<PageTitle>MoM Waterfall – CSP Dashboard</PageTitle>

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Month-over-Month Waterfall</MudText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_withDataSubCount" />

@* ── Global date-range slicer ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudDateRangePicker Label="Date Range"
                        DateRange="_selectedRange"
                        DateRangeChanged="OnDateRangeChanged"
                        Variant="Variant.Outlined" />
</MudPaper>

@* ── KPI cards ─────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">
    <KpiCard Label="MoM Change" Value="@Fmt(_momChange)" ValueColor="@(_momChange > 0 ? Color.Error : Color.Success)" Sm="6" Md="3" />
    <KpiCard Label="MoM Change %" Value="@($"{_momPct:F1}%")" ValueColor="@(_momPct > 0 ? Color.Error : Color.Success)" Sm="6" Md="3" />
    <KpiCard Label="YoY Change %" Value="@($"{_yoyPct:F1}%")" ValueColor="@(_yoyPct > 0 ? Color.Error : Color.Success)" Sm="6" Md="3" />
    <KpiCard Label="Current Month Spend" Value="@Fmt(_currentMonthCost)" Sm="6" Md="3" />
</MudGrid>

<MudGrid Spacing="3">
    @* MoM Variance – bar chart with conditional colouring (ApexCharts waterfall-style) *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Month-over-Month Cost Change</MudText>
            <ApexChart TItem="MomPoint" Options="_momBarOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="MomPoint"
                                     Items="_momData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Change)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* MoM by Subscription *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">MoM Change by Subscription (latest two months)</MudText>
            <ApexChart TItem="SubMomPoint" Options="_subMomOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="SubMomPoint"
                                     Items="_subMomData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.SubName)"
                                     YValue="@(e => (decimal?)e.Change)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Monthly totals table *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Monthly Summary</MudText>
            <MudDataGrid T="MonthSummaryRow"
                         Items="_monthSummary"
                         Dense
                         SortMode="SortMode.Single">
                <Columns>
                    <PropertyColumn Property="r => r.Label"    Title="Month" />
                    <PropertyColumn Property="r => r.Total"    Title="Total Cost"  Format="N0" />
                    <PropertyColumn Property="r => r.Change"   Title="MoM Change"  Format="N0" />
                    <TemplateColumn Title="MoM %">
                        <CellTemplate>
                            <MudText Color="@(context.Item.ChangePct > 0 ? Color.Error : Color.Success)">
                                @context.Item.ChangePct.ToString("F1")%
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record MomPoint(string Label, string SubscriptionId, decimal Change);
    private record SubMomPoint(string SubscriptionId, string SubName, decimal Change);
    private record MonthSummaryRow(string Label, decimal Total, decimal Change, decimal ChangePct);

    private DateRange _selectedRange = new(
        new DateTime(DateTime.Now.Year - 1, 1, 1),
        DateTime.Now);

    private decimal _momChange;
    private decimal _momPct;
    private decimal _yoyPct;
    private decimal _currentMonthCost;
    private List<string> _seriesSubIds = [];

    private List<MomPoint> _momData = [];
    private List<SubMomPoint> _subMomData = [];
    private List<MonthSummaryRow> _monthSummary = [];

    private readonly ApexChartOptions<MomPoint> _momBarOpts = ApexChartPresets.WaterfallBar<MomPoint>();

    private readonly ApexChartOptions<SubMomPoint> _subMomOpts = ApexChartPresets.WaterfallBar<SubMomPoint>(horizontal: true);

    protected override void OnInitialized()
    {
        _selectedRange = State.SelectedRange;
        base.OnInitialized();
    }

    protected override async Task LoadAsync()
    {
        _selectedRange = State.SelectedRange;
        await RunLoadAsync(async () =>
        {
            var dataTask = CostService.GetMainCostDataAsync();
            var nameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var data  = ApplySubFilter(await dataTask);
            _subNames = await nameTask;
            await IndexSubscriptionData(data);
            // Anchor "today" to the most recent date present in the data rather than the wall
            // clock. Azure cost data lags by 1-3 days and a brand-new calendar month often has
            // no rows yet, which would otherwise make Current Month Spend read 0. Fall back to
            // UtcNow only when there is no data at all.
            var today = data.Count > 0 ? data.Max(r => r.Date) : DateTime.UtcNow;
            _seriesSubIds = GetOrderedSubscriptionIds();

            var rangeStart = _selectedRange.Start ?? today.AddYears(-1);
            var rangeEnd   = _selectedRange.End   ?? today;
            var rangeFiltered = data.Where(r => r.Date >= rangeStart && r.Date <= rangeEnd).ToList();

            // Monthly totals (all data, for rolling MoM)
            var monthlyTotals = rangeFiltered
                .GroupBy(r => new { r.Date.Year, r.Date.Month })
                .Select(g => (
                    Year:  g.Key.Year,
                    Month: g.Key.Month,
                    Date:  new DateTime(g.Key.Year, g.Key.Month, 1),
                    Cost:  g.Sum(r => r.NormalizedCost)))
                .OrderBy(x => x.Date)
                .ToList();

            _withDataSubCount = rangeFiltered
                .Where(r => !string.IsNullOrWhiteSpace(r.SubscriptionId))
                .Select(r => r.SubscriptionId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

            var monthStarts = monthlyTotals.Select(x => x.Date).ToList();
            var monthlyBySub = rangeFiltered
                .GroupBy(r => new { r.SubscriptionId, r.Date.Year, r.Date.Month })
                .ToDictionary(
                    g => (SubId: g.Key.SubscriptionId, MonthStart: new DateTime(g.Key.Year, g.Key.Month, 1)),
                    g => g.Sum(r => r.NormalizedCost));

            // Build per-subscription MoM change series with zero-filled months.
            _momData = _seriesSubIds
                .SelectMany(subId => monthStarts.Skip(1).Select((monthStart, i) =>
                {
                    var priorStart = monthStarts[i];
                    var current = monthlyBySub.TryGetValue((subId, monthStart), out var currentCost) ? currentCost : 0m;
                    var prior = monthlyBySub.TryGetValue((subId, priorStart), out var priorCost) ? priorCost : 0m;
                    return new MomPoint(monthStart.ToString("MMM yy"), subId, current - prior);
                }))
                .ToList();

            // Monthly summary table
            _monthSummary = monthlyTotals
                .Skip(1)
                .Select((x, i) =>
                {
                    var change = x.Cost - monthlyTotals[i].Cost;
                    var pct    = monthlyTotals[i].Cost > 0
                        ? change / monthlyTotals[i].Cost * 100m
                        : 0m;
                    return new MonthSummaryRow(x.Date.ToString("MMM yy"), x.Cost, change, pct);
                })
                .OrderByDescending(r => DateTime.ParseExact(r.Label, "MMM yy", null))
                .ToList();

            // Latest MoM stats
            var curMonth   = monthlyTotals.LastOrDefault(x => x.Year == today.Year && x.Month == today.Month);
            var priorMonth = monthlyTotals.LastOrDefault(x =>
                (x.Year == today.Year && x.Month == today.Month - 1) ||
                (today.Month == 1 && x.Year == today.Year - 1 && x.Month == 12));

            _currentMonthCost = curMonth != default ? curMonth.Cost : 0m;
            _momChange = (curMonth != default && priorMonth != default)
                ? curMonth.Cost - priorMonth.Cost
                : 0m;
            _momPct = (priorMonth != default && priorMonth.Cost > 0)
                ? _momChange / priorMonth.Cost * 100m
                : 0m;

            // YoY: same month last year
            var priorYearSameMonth = monthlyTotals
                .LastOrDefault(x => x.Year == today.Year - 1 && x.Month == today.Month);
            _yoyPct = (priorYearSameMonth != default && priorYearSameMonth.Cost > 0 && curMonth != default)
                ? (curMonth.Cost - priorYearSameMonth.Cost) / priorYearSameMonth.Cost * 100m
                : 0m;

            // MoM by subscription (current month vs prior month)
            var priorYear  = today.Month == 1 ? today.Year - 1 : today.Year;
            var priorMonth2 = today.Month == 1 ? 12 : today.Month - 1;

            var subMomActual = rangeFiltered
                .Where(r => (r.Date.Year == today.Year && r.Date.Month == today.Month) ||
                             (r.Date.Year == priorYear && r.Date.Month == priorMonth2))
                .GroupBy(r => r.SubscriptionId)
                .Select(g => new SubMomPoint(
                    g.Key,
                    GetSubName(g.Key),
                    g.Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month).Sum(r => r.NormalizedCost)
                    - g.Where(r => !(r.Date.Year == today.Year && r.Date.Month == today.Month)).Sum(r => r.NormalizedCost)))
                .ToDictionary(x => x.SubscriptionId, x => x.Change, StringComparer.OrdinalIgnoreCase);

            _subMomData = _seriesSubIds
                .Select(id => new SubMomPoint(
                    id,
                    GetSubName(id),
                    subMomActual.TryGetValue(id, out var change) ? change : 0m))
                .OrderBy(x => x.Change)
                .ToList();
        });
    }

    private async Task OnDateRangeChanged(DateRange range)
    {
        State.SetDateRange(range);
        _selectedRange = range;
        await LoadAsync();
    }
}
