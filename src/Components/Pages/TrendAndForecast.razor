@page "/trend"
@inherits CostPageBase

<PageTitle>Trend &amp; Forecast – CSP Dashboard</PageTitle>

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Trend &amp; Forecast</MudText>
<SubscriptionScopeBadge SelectedCount="SubStore.AllIds.Count" WithDataCount="_withDataSubCount" />

@* ── Cost metric toggle ──────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-3 mb-4" Elevation="2">
    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.body2">Cost metric:</MudText>
        <MudChipSet T="string" @bind-SelectedValue="_metric" SelectionMode="SelectionMode.SingleSelection"
                    CheckMark>
            <MudChip T="string" Value=@("ActualCost") Color="Color.Primary" Variant="Variant.Filled"
                     OnClick="OnMetricChangedAsync">
                Actual Cost
            </MudChip>
            <MudChip T="string" Value=@("AmortizedCost") Color="Color.Secondary" Variant="Variant.Filled"
                     OnClick="OnMetricChangedAsync">
                Amortized Cost
            </MudChip>
        </MudChipSet>
        <MudTooltip Text="Amortized Cost spreads reservation purchase costs evenly over the term, 
giving a smoother daily trend. Useful for comparing periods fairly when reservation 
purchases skew ActualCost." Arrow>
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
        </MudTooltip>
    </MudStack>
</MudPaper>

@* ── Global date-range slicer ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudDateRangePicker Label="Date Range"
                        DateRange="_selectedRange"
                        DateRangeChanged="OnDateRangeChanged"
                        Variant="Variant.Outlined" />
</MudPaper>

@* ── KPI cards ─────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">
    <KpiCard Label="Cost MTD" Value="@Fmt(_costMtd)" Sm="6" Md="3" />
    <KpiCard Label="Month-End Forecast" Value="@Fmt(_forecast)" Sm="6" Md="3" />
    <KpiCard Label="Rolling 3-Month Avg" Value="@Fmt(_rolling3m)" Sm="6" Md="3" />
    <KpiCard Label="YoY Change %" Value="@($"{_yoyPct:F1}%")" ValueColor="@(_yoyPct > 0 ? Color.Error : Color.Success)" Sm="6" Md="3" />
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Subscription Visibility (Selected Range)</MudText>
    <MudDataGrid T="SubRangePoint"
                 Items="_subRangeData"
                 Dense
                 SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="s => s.SubscriptionName" Title="Subscription" />
            <PropertyColumn Property="s => s.SubscriptionId" Title="Subscription ID" />
            <PropertyColumn Property="s => s.Cost" Title="Range Cost" Format="N0" />
        </Columns>
    </MudDataGrid>
</MudPaper>

<MudGrid Spacing="3">
    @* Actual vs Forecast (daily) *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Actual vs Month-End Forecast (daily)</MudText>
            <ApexChart TItem="DailyPoint" Options="_forecastOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_actualDaily.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Date)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                }
                <ApexPointSeries TItem="DailyPoint"
                                 Items="_forecastDaily"
                                 Name="Forecast (total)"
                                 XValue="@(e => e.Date)"
                                 YValue="@(e => (decimal?)e.Cost)"
                                 SeriesType="SeriesType.Line" />
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Monthly trend + Rolling 3M Avg *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Monthly Cost + Rolling 3-Month Avg</MudText>
            <ApexChart TItem="MonthlyPoint" Options="_rollingOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthlyTrend.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@GetSubName(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
                <ApexPointSeries TItem="MonthlyPoint"
                                 Items="_rolling3mLine"
                                 Name="3-Month Avg (total)"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => (decimal?)e.Cost)"
                                 SeriesType="SeriesType.Line" />
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* YoY Comparison *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Year-over-Year Comparison</MudText>
            <ApexChart TItem="MonthlyPoint" Options="_yoyOpts">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_currentYearMonthly.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{GetSubName(capturedSubId)} (Current)")"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_priorYearMonthly.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{GetSubName(capturedSubId)} (Prior)")"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                }
            </ApexChart>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record DailyPoint(DateTime Date, string SubscriptionId, decimal Cost);
    private record MonthlyPoint(string Label, string SubscriptionId, decimal Cost);
    private record SubRangePoint(string SubscriptionId, string SubscriptionName, decimal Cost);

    private string _metric = "ActualCost";
    private DateRange _selectedRange = new(
        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
        DateTime.Now);

    private decimal _costMtd;
    private decimal _forecast;
    private decimal _rolling3m;
    private decimal _yoyPct;
    private List<string> _seriesSubIds = [];

    private List<DailyPoint> _actualDaily = [];
    private List<DailyPoint> _forecastDaily = [];
    private List<MonthlyPoint> _monthlyTrend = [];
    private List<MonthlyPoint> _rolling3mLine = [];
    private List<MonthlyPoint> _currentYearMonthly = [];
    private List<MonthlyPoint> _priorYearMonthly = [];
    private List<SubRangePoint> _subRangeData = [];

    private readonly ApexChartOptions<DailyPoint> _forecastOpts = ApexChartPresets.SmoothLine<DailyPoint>(dashArray: [0, 5]);

    private readonly ApexChartOptions<MonthlyPoint> _rollingOpts = ApexChartPresets.StackedBar<MonthlyPoint>();

    private readonly ApexChartOptions<MonthlyPoint> _yoyOpts = ApexChartPresets.SmoothLine<MonthlyPoint>();

    protected override void OnInitialized()
    {
        _selectedRange = State.SelectedRange;
        base.OnInitialized();
    }

    private async Task OnDateRangeChanged(DateRange range)
    {
        State.SetDateRange(range);   // broadcasts to all other pages
        _selectedRange = range;
        await LoadAsync();
    }

    // TrendAndForecast overrides LoadAsync to also sync _selectedRange from State
    // when triggered by a global date-range broadcast.
    protected override async Task LoadAsync()
    {
        _selectedRange = State.SelectedRange;
        await RunLoadAsync(async () =>
        {
            var dataTask = _metric == "AmortizedCost"
                ? CostService.GetAmortizedMainCostDataAsync()
                : CostService.GetMainCostDataAsync();
            var nameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var data  = await dataTask;
            _subNames = await nameTask;
            // Anchor the forecast month to the real current calendar month when it has data.
            // Azure cost data lags by 1-3 days and a brand-new calendar month often has no rows
            // yet; in that case fall back to the latest month present in the data so Cost MTD
            // doesn't read 0. Using the wall clock (rather than data.Max) for the *month* avoids
            // showing a completed prior month as if it were the current one.
            var wallToday      = DateTime.UtcNow.Date;
            var latestDataDate = data.Count > 0 ? data.Max(r => r.Date) : wallToday;
            var hasCurrentMonth = data.Any(r => r.Date.Year == wallToday.Year && r.Date.Month == wallToday.Month);
            var today = hasCurrentMonth ? wallToday : latestDataDate;
            _seriesSubIds = GetOrderedSubscriptionIds();

            // ── Forecast ──────────────────────────────────────────────────────
            var curMonthData = data
                .Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                .ToList();
            _costMtd = curMonthData.Sum(r => r.NormalizedCost);

            var daysInMonth   = DateTime.DaysInMonth(today.Year, today.Month);
            // How far through the month we actually are. Take the smaller of the wall-clock day
            // and the latest day that has cost data so that (a) normal data lag still yields an
            // accurate daily average, and (b) a single stray month-end row can't inflate the
            // elapsed-day count and collapse the forecast down to exactly Cost MTD before the
            // month is over.
            var latestDataDay = curMonthData.Count > 0 ? curMonthData.Max(r => r.Date.Day) : today.Day;
            var daysElapsed   = Math.Max(1, Math.Min(today.Day, latestDataDay));
            var dailyAvg      = _costMtd / daysElapsed;
            _forecast         = dailyAvg * daysInMonth;

            // Actual daily (current month)
            var monthDays = Enumerable.Range(1, today.Day)
                .Select(day => new DateTime(today.Year, today.Month, day))
                .ToList();
            var actualBySubDay = curMonthData
                .GroupBy(r => new { r.SubscriptionId, Day = r.Date.Date })
                .ToDictionary(g => (SubId: g.Key.SubscriptionId, Day: g.Key.Day), g => g.Sum(r => r.NormalizedCost));

            _actualDaily = _seriesSubIds
                .SelectMany(subId => monthDays.Select(day => new DailyPoint(
                    day,
                    subId,
                    actualBySubDay.TryGetValue((subId, day), out var cost) ? cost : 0m)))
                .ToList();

            // Forecast line: extend from today to end of month
            _forecastDaily = Enumerable.Range(daysElapsed, daysInMonth - daysElapsed + 1)
                .Select(d =>
                {
                    var date = new DateTime(today.Year, today.Month, d);
                    return new DailyPoint(date, "__forecast", dailyAvg * d);
                })
                .ToList();

            // ── Monthly totals (scoped to the selected date range) ──────────────
            var rangeStart = _selectedRange.Start ?? today.AddYears(-1);
            var rangeEnd   = _selectedRange.End   ?? today;
            var rangeFiltered = data
                .Where(r => r.Date >= rangeStart && r.Date <= rangeEnd)
                .ToList();

            _subRangeData = SubStore.AllIds
                .Select(id =>
                {
                    var cost = rangeFiltered
                        .Where(r => r.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase))
                        .Sum(r => r.NormalizedCost);
                    var name = _subNames.TryGetValue(id, out var n) ? n : id;
                    return new SubRangePoint(id, name, cost);
                })
                .OrderByDescending(s => s.Cost)
                .ToList();

            _withDataSubCount = _subRangeData.Count(s => s.Cost > 0);

            var monthStarts = rangeFiltered
                .Where(r => r.Date >= rangeStart && r.Date <= rangeEnd)
                .GroupBy(r => new { r.Date.Year, r.Date.Month })
                .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
                .OrderBy(d => d)
                .ToList();

            var monthlyBySub = rangeFiltered
                .GroupBy(r => new { r.SubscriptionId, r.Date.Year, r.Date.Month })
                .ToDictionary(
                    g => (SubId: g.Key.SubscriptionId, MonthStart: new DateTime(g.Key.Year, g.Key.Month, 1)),
                    g => g.Sum(r => r.NormalizedCost));

            _monthlyTrend = _seriesSubIds
                .SelectMany(subId => monthStarts.Select(month => new MonthlyPoint(
                    month.ToString("MMM yy"),
                    subId,
                    monthlyBySub.TryGetValue((subId, month), out var cost) ? cost : 0m)))
                .ToList();

            var monthlyTotalSeries = monthStarts
                .Select(month => new
                {
                    Month = month,
                    Cost = _seriesSubIds.Sum(subId => monthlyBySub.TryGetValue((subId, month), out var cost) ? cost : 0m)
                })
                .ToList();

            // ── Rolling 3-month avg ───────────────────────────────────────────
            _rolling3mLine = monthlyTotalSeries
                .Select((x, i) =>
                {
                    var window  = monthlyTotalSeries.Skip(Math.Max(0, i - 2)).Take(Math.Min(3, i + 1));
                    var rolling = window.Average(w => w.Cost);
                    return new MonthlyPoint(
                        x.Month.ToString("MMM yy"), "__rolling", rolling);
                })
                .ToList();

            _rolling3m = _rolling3mLine.Count > 0
                ? _rolling3mLine[^1].Cost
                : 0m;

            // ── YoY ──────────────────────────────────────────────────────────
            var yearMonths = Enumerable.Range(1, 12).ToList();
            var currentBySubMonth = rangeFiltered
                .Where(r => r.Date.Year == today.Year)
                .GroupBy(r => new { r.SubscriptionId, r.Date.Month })
                .ToDictionary(g => (SubId: g.Key.SubscriptionId, Month: g.Key.Month), g => g.Sum(r => r.NormalizedCost));
            var priorBySubMonth = rangeFiltered
                .Where(r => r.Date.Year == today.Year - 1)
                .GroupBy(r => new { r.SubscriptionId, r.Date.Month })
                .ToDictionary(g => (SubId: g.Key.SubscriptionId, Month: g.Key.Month), g => g.Sum(r => r.NormalizedCost));

            _currentYearMonthly = _seriesSubIds
                .SelectMany(subId => yearMonths.Select(month => new MonthlyPoint(
                    new DateTime(today.Year, month, 1).ToString("MMM"),
                    subId,
                    currentBySubMonth.TryGetValue((subId, month), out var cost) ? cost : 0m)))
                .ToList();

            _priorYearMonthly = _seriesSubIds
                .SelectMany(subId => yearMonths.Select(month => new MonthlyPoint(
                    new DateTime(today.Year, month, 1).ToString("MMM"),
                    subId,
                    priorBySubMonth.TryGetValue((subId, month), out var cost) ? cost : 0m)))
                .ToList();

            var curTotal   = _currentYearMonthly.Sum(p => p.Cost);
            var priorTotal = _priorYearMonthly.Sum(p => p.Cost);
            _yoyPct = priorTotal > 0 ? (curTotal - priorTotal) / priorTotal * 100m : 0m;
        });
    }

    private async Task OnMetricChangedAsync() => await LoadAsync();
}
