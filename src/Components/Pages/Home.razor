@page "/"
@inject ExportProvisioningService ExportProvisioner
@inject JobControlService JobControl
@inject CollectionAuditService Audit
@inject ILogger<Home> Logger
@inherits CostPageBase

<PageTitle>Cost Overview – CSP Dashboard</PageTitle>

<PageTour />

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_withDataSubCount" />

@* ── Summary cards ────────────────────────────────────────────────────────── *@
<RadzenRow data-tour="10" data-tour-title="Headline numbers" data-tour-desc="At-a-glance totals for the selected range, month-to-date, year-to-date and average daily cost." Class="mb-4" Gap="1rem">
    <KpiCard Label="Total Cost (selected range)" Value="@Fmt(_totalCost)" Sm="6" Md="3" />
    <KpiCard Label="Cost Month-to-Date" Value="@Fmt(_costMtd)" Sm="6" Md="3" />
    <KpiCard Label="Cost Year-to-Date" Value="@Fmt(_costYtd)" Sm="6" Md="3" />
    <KpiCard Label="Avg Daily Cost" Value="@Fmt(_avgDailyCost)" Sm="6" Md="3" />
</RadzenRow>

@* ── Ion margin strip (portfolio buy price / margin) ───────────────────── *@

@* ── Charts ───────────────────────────────────────────────────────────────── *@
<RadzenRow data-tour="12" data-tour-title="Cost charts" data-tour-desc="Interactive trends and breakdowns. Charts update automatically as you change the filters above." Gap="1rem">
    @* Cost vs Prior Month *@
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Daily Cost – Current vs Prior Month</RadzenText>
            <ApexChart TItem="DailyPoint" Options="_twoLineOpts" @key="ChartKey">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_currentMonthDaily.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{SubChartLabel(capturedSubId)} (Current)")"
                                     XValue="@(e => e.Day)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_priorMonthDaily.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@($"{SubChartLabel(capturedSubId)} (Prior)")"
                                     XValue="@(e => e.Day)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Line" />
                }
            </ApexChart>
        </RadzenCard>
    </RadzenColumn>

    @* Monthly Trend *@
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Monthly Cost Trend</RadzenText>
            <ApexChart TItem="MonthlyPoint" Options="_barOpts" @key="ChartKey">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthlyTrend.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </RadzenCard>
    </RadzenColumn>

    @* Top 10 Services *@
    <RadzenColumn Size="12">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Top 10 Services by Cost</RadzenText>
            <ApexChart TItem="ServicePoint" Options="_hbarOpts" @key="ChartKey">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="ServicePoint"
                                     Items="_topServices.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@* ── Cost anomalies ───────────────────────────────────────────────────────── *@
@if (_anomalies.Count > 0)
{
    <RadzenCard Class="pa-4 mt-4">
        <RadzenStack AlignItems="AlignItems.Center" Class="mb-3" Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem">
            <RadzenIcon Icon="warning"  IconColor="var(--rz-warning)" />
            <RadzenText Class="fw-bold" TextStyle="TextStyle.Subtitle1">Cost Anomalies</RadzenText>
            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat">
                @_anomalies.Count detected
            </RadzenBadge>
            <RadzenStack Gap="0" MouseEnter="@(element => Tooltips.Open(element, "Daily spend per subscription + service that is statistically unusual versus its trailing 30-day baseline (z-score ≥ 2.5). Recent days only."))" MouseLeave="@(_ => Tooltips.Close())">
                <RadzenIcon Icon="info"  IconColor="var(--rz-base)" />
            </RadzenStack>
        </RadzenStack>
        <RadzenDataGrid TItem="CostAnomaly" Data="_anomalies" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="false" FilterMode="Radzen.FilterMode.Simple" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="Date" Title="Date" TItem="CostAnomaly" FormatString="{0:yyyy-MM-dd}" />
                <RadzenDataGridColumn Property="SubscriptionName" Title="Subscription" TItem="CostAnomaly" />
                <RadzenDataGridColumn Property="ServiceName" Title="Service" TItem="CostAnomaly" />
                <RadzenDataGridColumn Property="Cost" Title="@($"Cost ({Options.TargetCurrency})")" TItem="CostAnomaly" FormatString="{0:N0}" />
                <RadzenDataGridColumn Property="Baseline" Title="@($"Baseline ({Options.TargetCurrency})")" TItem="CostAnomaly" FormatString="{0:N0}" />
                <RadzenDataGridColumn Title="Δ %" TItem="CostAnomaly" Property="DeltaPct">
                    <Template Context="context">
                        <RadzenText Style="color: var(--rz-danger);">+@context.DeltaPct.ToString("F0")%</RadzenText>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="ZScore" Title="z-score" TItem="CostAnomaly" FormatString="{0:F1}" />
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@* ── Subscription Management ─────────────────────────────────────────────── *@
<div class="mt-4">
    <RadzenPanel Text="Manage Subscriptions" Icon="manage_accounts"  AllowCollapse="true" Collapsed="true">

        @* Active subscription chips *@
        <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Active Subscriptions (@SubStore.AllIds.Count)</RadzenText>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var sub in SubStore.AllIds)
            {
                var capturedId  = sub;
                var displayName = _subNames.TryGetValue(capturedId, out var n) ? n : capturedId;
                var isConfig    = SubStore.ConfiguredIds.Any(c => c.Equals(capturedId, StringComparison.OrdinalIgnoreCase));
                @if (isConfig)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Base" title="@($"{capturedId} — defined in configuration, not removable at runtime")"><RadzenIcon Icon="lock" />
                        @displayName
                    </RadzenBadge>
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" title="@capturedId">
                        @displayName
                        <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Light" Disabled="_subBusy"
                                      Click="@(() => RemoveSubAsync(capturedId))"
                                      aria-label="@($"Remove {displayName}")" />
                    </RadzenBadge>
                }
            }
            @if (!SubStore.AllIds.Any())
            {
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">(none configured)</RadzenText>
            }
        </div>

        @if (Options.ExportBlob.Enabled && SubStore.AllIds.Any())
        {
            <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Export Provisioning</RadzenText>
            <div class="d-flex flex-column gap-2 mb-4">
                @foreach (var sub in SubStore.AllIds)
                {
                    var capturedId = sub;
                    var displayName = _subNames.TryGetValue(capturedId, out var name) ? name : capturedId;
                    var isProvisionBusy = _provisionBusy.Contains(capturedId);
                    <div class="d-flex align-center justify-space-between gap-2 flex-wrap">
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <RadzenText TextStyle="TextStyle.Body2">@displayName</RadzenText>
                            @if (_exportPaths.TryGetValue(capturedId, out var path))
                            {
                                <RadzenBadge BadgeStyle="@ExportPathColor(path.State)" title="@path.Detail" Variant="Variant.Flat"><RadzenIcon Icon="@ExportPathIcon(path.State)" />
                                    @path.ShortLabel
                                </RadzenBadge>
                            }
                            else if (_exportPathsBusy)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">checking…</RadzenText>
                            }
                        </div>
                        <RadzenButton Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@(_subBusy || isProvisionBusy)" ButtonStyle="ButtonStyle.Secondary" Click="@(async () => await ReprovisionExportAsync(capturedId))" Icon="sync" Text="@(isProvisionBusy ? "Re-provisioning..." : "Re-provision Export")" />
                    </div>
                }
            </div>
        }

        @* Status alert *@
        @if (_subResult is not null)
        {
            <RadzenAlert AlertStyle="@_subResult.AlertStyle" Class="mb-3" AllowClose="true" Close="@(() => _subResult = null)">
                @_subResult.Message
            </RadzenAlert>
        }

        <RadzenRow Gap="1rem">
            @* ── Add manually ───────────────────────────────────────────────── *@
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard Class="pa-3">
                    <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Add Manually</RadzenText>
                    <RadzenFormField Text="Subscription ID (GUID)" Style="width:100%;">
                        <RadzenTextBox @bind-Value="_newSubId" Immediate="true" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" aria-label="Subscription ID (GUID)" @onkeydown="@OnSubKeyDown" Style="width:100%;" />
                    </RadzenFormField>
                    <RadzenButton Variant="Variant.Filled" Class="mt-2" Disabled="_subBusy" ButtonStyle="ButtonStyle.Primary" Click="AddManualAsync" Text="Add" />
                </RadzenCard>
            </RadzenColumn>

            @* ── Import from CSV / paste ─────────────────────────────────────── *@
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard Class="pa-3">
                    <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Import from CSV / Text</RadzenText>
                    <RadzenText Class="mb-1" TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">
                        Paste subscription IDs (one per line, or any CSV — GUIDs are extracted automatically)
                    </RadzenText>
                    <RadzenTextArea @bind-Value="_csvPaste" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" Rows="4" Style="width:100%;" />
                    <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                        <RadzenButton Variant="Variant.Filled" Disabled="_subBusy" ButtonStyle="ButtonStyle.Secondary" Click="ImportPastedAsync" Text="Import Pasted" />
                        <RadzenText TextStyle="TextStyle.Caption">— or —</RadzenText>
                        <InputFile id="subCsvFile" OnChange="ImportFileAsync" accept=".csv,.txt" disabled="@_subBusy" style="display:none" />
                        <label class="rz-button rz-variant-outlined rz-secondary rz-shade-default" for="subCsvFile" aria-disabled="@_subBusy">
                            Upload .csv / .txt
                        </label>
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenPanel>
</div>

@* ── Data Collection ─────────────────────────────────────────────────────── *@
<div class="mt-4">
    <RadzenPanel Text="Data Collection" Icon="cloud_sync"  AllowCollapse="true" Collapsed="true">

        <div class="d-flex align-center justify-space-between gap-2 flex-wrap mb-3">
            <RadzenText TextStyle="TextStyle.Body2">
                Refresh the shared cost cache from the latest exports. Runs automatically every night;
                trigger an on-demand refresh here.
            </RadzenText>
            <RadzenButton Variant="Variant.Filled"  Disabled="@(_collectBusy || !JobControl.IsConfigured)" ButtonStyle="ButtonStyle.Primary" Click="CollectNowAsync" Icon="play_arrow" Text="@(_collectBusy ? "Collecting…" : "Collect now")" />
        </div>

        @if (!JobControl.IsConfigured)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-3" AllowClose="false">
                On-demand collection isn't configured in this environment (the job coordinates are not set).
            </RadzenAlert>
        }

        @if (_collectMessage is not null)
        {
            <RadzenAlert AlertStyle="@_collectSeverity" Class="mb-3" AllowClose="true" Close="@(() => _collectMessage = null)">
                @_collectMessage
            </RadzenAlert>
        }

        @if (_lastRun is not null)
        {
            <RadzenText Class="mb-2" TextStyle="TextStyle.Subtitle2">Last run</RadzenText>
            <div class="d-flex align-center gap-2 flex-wrap mb-1">
                <RadzenBadge BadgeStyle="@(_lastRun.Status == "Success" ? BadgeStyle.Success : BadgeStyle.Danger)" Variant="Variant.Flat"><RadzenIcon Icon="@(_lastRun.Status == "Success" ? "check_circle" : "error")" />
                    @_lastRun.Status
                </RadzenBadge>
                <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Flat">
                    @_lastRun.Trigger
                </RadzenBadge>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">
                    @_lastRun.FinishedUtc.ToLocalTime().ToString("g")
                    · @($"{_lastRun.DurationMs / 1000.0:N1}s")
                    · @($"{_lastRun.MainRows + _lastRun.RgRows + _lastRun.TagRows + _lastRun.AmortRows:N0} rows")
                </RadzenText>
            </div>
            @if (!string.IsNullOrWhiteSpace(_lastRun.Error))
            {
                <RadzenText Class="mb-1" TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">@_lastRun.Error</RadzenText>
            }
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">No collection runs recorded yet.</RadzenText>
        }

        @if (JobControl.PortalExecutionHistoryUrl is { } logUrl)
        {
            <div class="mt-2">
                <RadzenLink Target="_blank" Path="@logUrl">
                    <RadzenIcon Icon="open_in_new"  Class="me-1" />
                    View job logs &amp; execution history
                </RadzenLink>
            </div>
        }
    </RadzenPanel>
</div>

@code {
    private record DailyPoint(int Day, string SubscriptionId, decimal Cost);
    private record MonthlyPoint(string Label, string SubscriptionId, decimal Cost);
    private record ServicePoint(string ServiceName, string SubscriptionId, string Label, decimal Cost);

    private List<CostRow> _data = [];
    private bool _subNamesBusy;

    private decimal _totalCost;
    private decimal _costMtd;
    private decimal _costYtd;
    private decimal _avgDailyCost;

    private List<DailyPoint> _currentMonthDaily = [];
    private List<DailyPoint> _priorMonthDaily = [];
    private List<MonthlyPoint> _monthlyTrend = [];
    private List<ServicePoint> _topServices = [];
    private List<string> _seriesSubIds = [];
    private IReadOnlyList<CostAnomaly> _anomalies = [];

    private readonly ApexChartOptions<DailyPoint> _twoLineOpts = ApexChartPresets.SmoothLine<DailyPoint>();

    private readonly ApexChartOptions<MonthlyPoint> _barOpts = ApexChartPresets.StackedBar<MonthlyPoint>();

    private readonly ApexChartOptions<ServicePoint> _hbarOpts = ApexChartPresets.HorizontalBar<ServicePoint>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshSubNamesAsync();
        await DetectExportPathsAsync();
        await LoadLastRunAsync();
    }

    // ── Data collection (CostCollectorJob) ──────────────────────────────────
    private bool _collectBusy;
    private string? _collectMessage;
    private AlertStyle _collectSeverity = AlertStyle.Info;
    private CollectionAuditRecord? _lastRun;

    private async Task LoadLastRunAsync()
    {
        try { _lastRun = await Audit.GetLatestAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to load last collection run."); }
    }

    private async Task CollectNowAsync()
    {
        if (_collectBusy) return;
        _collectBusy = true;
        _collectMessage = null;
        try
        {
            var status = await JobControl.StartScaledAsync(JobControl.DefaultPartitionCount);

            switch (status.Status)
            {
                case "NotConfigured":
                    _collectSeverity = AlertStyle.Warning;
                    _collectMessage = "On-demand collection isn't configured in this environment.";
                    return;
                case "StartFailed":
                    _collectSeverity = AlertStyle.Danger;
                    _collectMessage = "Failed to start the collection job. Check the app's permissions on the job.";
                    return;
            }

            _collectSeverity = AlertStyle.Info;
            _collectMessage = status.Coalesced
                ? "A collection run is already in progress — showing its status."
                : "Collection started. This can take a few minutes.";
            StateHasChanged();

            // Poll for completion (bounded to ~3.5 min so we don't hold the circuit forever).
            for (var i = 0; i < 40; i++)
            {
                await Task.Delay(5000);
                var latest = await JobControl.GetLatestAsync();
                if (latest is null || !latest.IsInProgress)
                {
                    await LoadLastRunAsync();
                    var ok = _lastRun?.Status == "Success";
                    _collectSeverity = ok ? AlertStyle.Success : AlertStyle.Warning;
                    _collectMessage = ok
                        ? "Collection complete — dashboards now show the latest data."
                        : "Collection finished. See the last-run status below.";
                    return;
                }
                StateHasChanged();
            }

            _collectSeverity = AlertStyle.Info;
            _collectMessage = "Collection is still running. Refresh later to see the result.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Collect-now failed.");
            _collectSeverity = AlertStyle.Danger;
            _collectMessage = "Something went wrong starting collection.";
        }
        finally
        {
            _collectBusy = false;
        }
    }

    protected override async Task LoadAsync()
    {
        await RunLoadAsync(async () =>
        {
            _data = ApplySubFilter(await CostService.GetMainCostDataAsync()).ToList();
            await IndexSubscriptionData(_data);
            Compute();

            // The landing page is the natural place to warm every dataset so the loading
            // banner reflects reality without the user having to visit each page. The Resource
            // Groups and Tag Chargeback datasets are already populated in the same SQL pass as
            // Main (PopulateAllCachesAsync), but their per-dataset status only flips to Ready
            // when something queries them — so touch them here. On a warm cache these are
            // instant hits; on a cold cache they share Main's single load.
            await Task.WhenAll(
                CostService.GetRgCostDataAsync(),
                CostService.GetTagCostDataAsync());
        });
    }

    private void Compute()
    {
        var start  = State.SelectedRange.Start ?? DateTime.Now.AddYears(-1);
        var end    = State.SelectedRange.End   ?? DateTime.Now;
        // Anchor "today" to the most recent date present in the data rather than the wall
        // clock. Azure cost data lags by 1-3 days and a brand-new calendar month often has
        // no rows yet, which would otherwise make Month-to-Date read 0. Fall back to UtcNow
        // only when there is no data at all.
        var today  = _data.Count > 0 ? _data.Max(r => r.Date) : DateTime.UtcNow;
        var filtered = _data.Where(r => r.Date >= start && r.Date <= end).ToList();
        _seriesSubIds = GetOrderedSubscriptionIds();

        _totalCost    = filtered.Sum(r => r.NormalizedCost);
        _withDataSubCount = filtered
            .Where(r => !string.IsNullOrWhiteSpace(r.SubscriptionId))
            .Select(r => r.SubscriptionId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        // MTD and YTD are relative to the latest data date (see `today` above) — do NOT use
        // the range-filtered set so they remain correct even when the date picker spans
        // multiple years.
        _costMtd      = _data.Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                             .Sum(r => r.NormalizedCost);
        _costYtd      = _data.Where(r => r.Date.Year == today.Year)
                             .Sum(r => r.NormalizedCost);
        var distinctDays = filtered.Select(r => r.Date.Date).Distinct().Count();
        _avgDailyCost = distinctDays > 0 ? _totalCost / distinctDays : 0m;

        // Daily data for current and prior month
        var curMonth  = new DateTime(today.Year, today.Month, 1);
        var priorMonth = curMonth.AddMonths(-1);
        var curDays = Enumerable.Range(1, DateTime.DaysInMonth(curMonth.Year, curMonth.Month)).ToList();
        var priorDays = Enumerable.Range(1, DateTime.DaysInMonth(priorMonth.Year, priorMonth.Month)).ToList();
        var curBySubDay = filtered
            .Where(r => r.Date.Year == curMonth.Year && r.Date.Month == curMonth.Month)
            .GroupBy(r => new { r.SubscriptionId, Day = r.Date.Day })
            .ToDictionary(g => (SubId: g.Key.SubscriptionId, g.Key.Day), g => g.Sum(r => r.NormalizedCost));
        var priorBySubDay = filtered
            .Where(r => r.Date.Year == priorMonth.Year && r.Date.Month == priorMonth.Month)
            .GroupBy(r => new { r.SubscriptionId, Day = r.Date.Day })
            .ToDictionary(g => (SubId: g.Key.SubscriptionId, g.Key.Day), g => g.Sum(r => r.NormalizedCost));

        _currentMonthDaily = _seriesSubIds
            .SelectMany(subId => curDays.Select(day => new DailyPoint(
                day,
                subId,
                curBySubDay.TryGetValue((subId, day), out var cost) ? cost : 0m)))
            .ToList();

        _priorMonthDaily = _seriesSubIds
            .SelectMany(subId => priorDays.Select(day => new DailyPoint(
                day,
                subId,
                priorBySubDay.TryGetValue((subId, day), out var cost) ? cost : 0m)))
            .ToList();

        // Monthly trend
        var monthlyTotals = filtered
            .GroupBy(r => new { r.Date.Year, r.Date.Month })
            .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1))
            .OrderBy(d => d)
            .ToList();

        var monthlyBySub = filtered
            .GroupBy(r => new { r.SubscriptionId, r.Date.Year, r.Date.Month })
            .ToDictionary(
                g => (SubId: g.Key.SubscriptionId, MonthStart: new DateTime(g.Key.Year, g.Key.Month, 1)),
                g => g.Sum(r => r.NormalizedCost));

        _monthlyTrend = _seriesSubIds
            .SelectMany(subId => monthlyTotals.Select(month => new MonthlyPoint(
                month.ToString("MMM yy"),
                subId,
                monthlyBySub.TryGetValue((subId, month), out var cost) ? cost : 0m)))
            .ToList();

        // Top 10 services by overall cost, then split into per-subscription series.
        var topServiceNames = filtered
            .GroupBy(r => string.IsNullOrWhiteSpace(r.ServiceName) ? "(unassigned)" : r.ServiceName)
            .Select(g => new { Service = g.Key, Cost = g.Sum(r => r.NormalizedCost) })
            .OrderByDescending(x => x.Cost)
            .Take(10)
            .Select(x => x.Service)
            .ToList();

        var serviceBySub = filtered
            .GroupBy(r => new
            {
                ServiceName = string.IsNullOrWhiteSpace(r.ServiceName) ? "(unassigned)" : r.ServiceName,
                r.SubscriptionId
            })
            .ToDictionary(g => (Service: g.Key.ServiceName, SubId: g.Key.SubscriptionId), g => g.Sum(r => r.NormalizedCost));

        _topServices = _seriesSubIds
            .SelectMany(subId => topServiceNames.Select(service => new ServicePoint(
                service,
                subId,
                service,
                serviceBySub.TryGetValue((service, subId), out var cost) ? cost : 0m)))
            .ToList();

        // Statistical spike detection over the full dataset (per subscription + service),
        // independent of the selected date range so a quiet picker window can't hide a
        // recent anomaly.
        _anomalies = CostAnomalyDetector.Detect(_data, GetSubName);
    }

    // ── Subscription management ──────────────────────────────────────────────

    private async Task RefreshSubNamesAsync()
    {
        if (_subNamesBusy) return;
        _subNamesBusy = true;
        try   { _subNames = await CostService.GetSubscriptionDisplayNamesAsync(); }
        catch  { /* non-fatal — chips fall back to showing the GUID */ }
        finally { _subNamesBusy = false; }
    }

    private string _newSubId  = string.Empty;
    private string _csvPaste  = string.Empty;
    private bool   _subBusy   = false;
    private readonly HashSet<string> _provisionBusy = new(StringComparer.OrdinalIgnoreCase);

    // Detected export-provisioning path per subscription, shown as a short chip in the UI.
    private readonly Dictionary<string, ExportPathStatus> _exportPaths = new(StringComparer.OrdinalIgnoreCase);
    private bool _exportPathsBusy;

    private async Task DetectExportPathsAsync()
    {
        if (!Options.ExportBlob.Enabled || !SubStore.AllIds.Any()) return;

        _exportPathsBusy = true;
        try
        {
            var ids = SubStore.AllIds.ToList();
            var results = await Task.WhenAll(ids.Select(async id => (Id: id, Status: await SafeDetectAsync(id))));
            foreach (var (id, status) in results)
            {
                if (status is not null) _exportPaths[id] = status;
            }
        }
        finally
        {
            _exportPathsBusy = false;
        }
    }

    private async Task<ExportPathStatus?> SafeDetectAsync(string id)
    {
        try
        {
            return await ExportProvisioner.DetectAsync(id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Home: could not detect export path for subscription {SubId}", id);
            return null;
        }
    }

    private static BadgeStyle ExportPathColor(ExportPathState state) => state switch
    {
        ExportPathState.Provisioned   => BadgeStyle.Success,
        ExportPathState.Reused        => BadgeStyle.Info,
        ExportPathState.NoIdentity    => BadgeStyle.Warning,
        ExportPathState.NotProvisioned => BadgeStyle.Danger,
        ExportPathState.Misconfigured => BadgeStyle.Danger,
        ExportPathState.Unknown       => BadgeStyle.Base,
        _                             => BadgeStyle.Base
    };

    private static string ExportPathIcon(ExportPathState state) => state switch
    {
        ExportPathState.Provisioned    => "check_circle",
        ExportPathState.Reused         => "link",
        ExportPathState.NoIdentity     => "warning",
        ExportPathState.NotProvisioned => "error_outline",
        ExportPathState.Misconfigured  => "report_problem",
        ExportPathState.Unknown        => "help_outline",
        _                              => "remove_circle_outline"
    };

    private sealed record SubResult(AlertStyle AlertStyle, string Message);
    private SubResult? _subResult;

    private async Task AddManualAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSubId)) return;
        var correlationId = Guid.NewGuid().ToString("N");
        _subBusy = true;
        try
        {
            var (added, invalid) = await SubStore.AddAsync([_newSubId.Trim()], correlationId);
            if (invalid.Count > 0)
                _subResult = new(AlertStyle.Danger, $"Not a valid GUID: {invalid[0]}");
            else if (added == 0)
                _subResult = new(AlertStyle.Info, "Subscription ID is already in the list.");
            else
            {
                await RefreshSubNamesAsync();
                await InvalidateAndRefreshAllAsync(correlationId);
                var id   = _newSubId.Trim().ToLowerInvariant();
                var name = _subNames.TryGetValue(id, out var n) ? n : id;
                _subResult = new(AlertStyle.Success,
                    name != id ? $"Subscription '{name}' added." : "Subscription added.");
                _newSubId = string.Empty;
                await DetectExportPathsAsync();
            }
        }
        finally { _subBusy = false; }
    }

    private async Task OnSubKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddManualAsync();
    }

    private async Task ImportPastedAsync()
    {
        if (string.IsNullOrWhiteSpace(_csvPaste)) return;
        var ids = ExtractGuids(_csvPaste);
        await BulkImportAsync(ids);
        _csvPaste = string.Empty;
    }

    private async Task ImportFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            // 1 MB max; subscription ID files are tiny in practice
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 1_048_576);
            using var reader       = new StreamReader(stream);
            var text               = await reader.ReadToEndAsync();
            await BulkImportAsync(ExtractGuids(text));
        }
        catch (Exception ex)
        {
            _subResult = new(AlertStyle.Danger, $"Could not read file: {ex.Message}");
        }
    }

    private async Task BulkImportAsync(List<string> ids)
    {
        if (ids.Count == 0)
        {
            _subResult = new(AlertStyle.Warning, "No subscription IDs (GUIDs) found in the input.");
            return;
        }
        var correlationId = Guid.NewGuid().ToString("N");
        _subBusy = true;
        try
        {
            var (added, invalid) = await SubStore.AddAsync(ids, correlationId);
            var parts = new List<string>();
            if (added   > 0) parts.Add($"{added} added");
            if (invalid.Count > 0)
            {
                var preview = string.Join(", ", invalid.Take(3));
                if (invalid.Count > 3) preview += "...";
                parts.Add($"{invalid.Count} invalid ({preview})");
            }
            var skipped = ids.Count - added - invalid.Count;
            if (skipped > 0) parts.Add($"{skipped} already present");
            _subResult = new(
                added > 0 ? AlertStyle.Success : AlertStyle.Warning,
                string.Join("; ", parts));

            if (added > 0)
            {
                await RefreshSubNamesAsync();
                await InvalidateAndRefreshAllAsync(correlationId);
                await DetectExportPathsAsync();
            }
        }
        finally { _subBusy = false; }
    }

    private async Task RemoveSubAsync(string id)
    {
        var correlationId = Guid.NewGuid().ToString("N");
        await SubStore.RemoveAsync(id, correlationId);
        _exportPaths.Remove(id);
        await RefreshSubNamesAsync();
        await InvalidateAndRefreshAllAsync(correlationId);
    }

    private async Task ReprovisionExportAsync(string id)
    {
        if (!_provisionBusy.Add(id)) return;

        var correlationId = Guid.NewGuid().ToString("N");
        var displayName = _subNames.TryGetValue(id, out var name) ? name : id;

        try
        {
            var result = await ExportProvisioner.ProvisionAsync(id, correlationId);
            _subResult = result switch
            {
                { Succeeded: true } => new(AlertStyle.Success, $"{displayName}: {result.Message}"),
                { Skipped: true } => new(AlertStyle.Info, $"{displayName}: {result.Message}"),
                _ => new(AlertStyle.Danger, $"{displayName}: {result.Message}")
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Home[{CorrelationId}]: export re-provisioning failed for {SubId}", correlationId, id);
            _subResult = new(AlertStyle.Danger, $"{displayName}: export re-provisioning failed - {ex.Message}");
        }
        finally
        {
            _provisionBusy.Remove(id);
            var refreshed = await SafeDetectAsync(id);
            if (refreshed is not null) _exportPaths[id] = refreshed;
        }
    }

    private Task InvalidateAndRefreshAllAsync(string correlationId)
    {
        Logger.LogInformation(
            "Home[{CorrelationId}]: invalidating cost cache and broadcasting refresh after subscription change (active count {Count}).",
            correlationId, SubStore.AllIds.Count);
        CostService.InvalidateCache();
        State.SetDateRange(State.SelectedRange);
        return Task.CompletedTask;
    }

    /// <summary>Extracts all GUIDs found anywhere in <paramref name="text"/>.</summary>
    private static List<string> ExtractGuids(string text)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(
            text,
            @"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b");
        return matches
            .Select(m => m.Value.ToLowerInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
