@page "/optimization"
@inject OptimizationService Opt
@inject ICostManagementService CostService
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject CustomerStore Customers
@inject TenantNameService TenantNames

<PageTitle>Optimization – CSP Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudText Typo="Typo.h5" Class="mb-1 fw-bold">Optimization</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Live Azure inventory joined to cost data — orphaned resources to remove and tag-governance gaps.
</MudText>

@if (!_loading && Opt.LastAccessDenied)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Outlined.Lock">
        This page reads <strong>live Azure resource inventory</strong> via Azure Resource Graph, which
        requires the app identity to have the <strong>Reader</strong> role on the target subscriptions
        to populate it.
    </MudAlert>
}

@* ── KPI summary ────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">
    <KpiCard Label="Total Resources" Value="@_totalResources.ToString("N0")" Md="3" />
    <KpiCard Label="Orphaned Resources" Value="@_orphans.Count.ToString("N0")"
             ValueColor="@(_orphans.Count > 0 ? Color.Error : Color.Success)" Md="3" />
    <KpiCard Label="Untagged Resources" Value="@_untaggedCount.ToString("N0")"
             ValueColor="@(_untaggedCount > 0 ? Color.Warning : Color.Success)" Md="3" />
    <KpiCard Label="Tagged %" Value="@($"{_taggedPct:F1}%")"
             ValueColor="@(_taggedPct >= 80 ? Color.Success : Color.Warning)" Md="3" />
</MudGrid>

@* ── Orphaned resources ─────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Orphaned &amp; Idle Resources</MudText>
    @if (!_loading && _orphans.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Dense>
            No unattached disks, idle public IPs, orphaned NICs, empty App Service plans or
            stopped-but-allocated VMs were found. Nice and tidy.
        </MudAlert>
    }
    else
    {
        <MudDataGrid T="OrphanedResource"
                     Items="_orphans"
                     SortMode="SortMode.Multiple"
                     Filterable
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     Dense>
            <Columns>
                <PropertyColumn Property="r => r.Name"          Title="Name" />
                <TemplateColumn Title="Reason">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@ReasonColor(context.Item.Reason)">
                            @context.Item.Reason
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="r => r.Type"          Title="Type" />
                <PropertyColumn Property="r => r.ResourceGroup" Title="Resource Group" />
                <PropertyColumn Property="r => r.Location"      Title="Region" />
                <TemplateColumn Title="Subscription">
                    <CellTemplate>@SubName(context.Item.SubscriptionId)</CellTemplate>
                </TemplateColumn>
                @if (ShowTenant)
                {
                    <TemplateColumn Title="Tenant">
                        <CellTemplate>@SubTenant(context.Item.SubscriptionId)</CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@* ── Untagged resources by type ─────────────────────────────────────────────── *@
@if (_untaggedByType.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Untagged Resources by Type</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            Stacked by subscription so you can see which subscription@(ShowTenant ? " and tenant" : "") each gap belongs to.
        </MudText>
        <ApexChart TItem="TypeSubCount" Options="_barOpts">
            @foreach (var subId in _untaggedSubIds)
            {
                var capturedSubId = subId;
                <ApexPointSeries TItem="TypeSubCount"
                                 Items="_untaggedByType.Where(t => t.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                 Name="@SubLabel(capturedSubId)"
                                 XValue="@(e => e.Type)"
                                 YValue="@(e => (decimal?)e.Count)"
                                 SeriesType="SeriesType.Bar" />
            }
        </ApexChart>
    </MudPaper>
}

@code {
    private record TypeSubCount(string Type, string SubscriptionId, int Count);

    private bool    _loading = true;
    private string? _error;

    private int _totalResources;
    private int _untaggedCount;
    private double _taggedPct;
    private List<OrphanedResource> _orphans = [];
    private List<TypeSubCount>     _untaggedByType = [];
    private List<string>          _untaggedSubIds = [];
    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _subTenant = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowTenant => Options.MultiTenancy.Enabled;

    private readonly ApexChartOptions<TypeSubCount> _barOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Stacked = true },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 3 } },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var inventoryTask = Opt.GetInventoryAsync();
            var coverageTask  = Opt.GetTagCoverageAsync();
            var orphansTask   = Opt.GetOrphanedResourcesAsync();
            var namesTask     = Opt.GetSubscriptionNamesAsync();

            var inventory = await inventoryTask;
            var coverage  = await coverageTask;
            _orphans      = await orphansTask;
            _subNames     = new Dictionary<string, string>(await namesTask, StringComparer.OrdinalIgnoreCase);

            await BuildTenantMapAsync();

            _totalResources = coverage.TotalResources;
            _untaggedCount  = coverage.UntaggedResources;
            _taggedPct      = coverage.TaggedPercent;

            // Keep the 15 highest-count resource types, then split each type's bar by
            // subscription so a partner can see which subscription/tenant owns the gap.
            var topTypes = inventory
                .Where(r => r.IsUntagged)
                .GroupBy(r => ShortType(r.Type))
                .Select(g => new { Type = g.Key, Count = g.Count() })
                .OrderByDescending(t => t.Count)
                .Take(15)
                .Select(t => t.Type)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            _untaggedByType = inventory
                .Where(r => r.IsUntagged && topTypes.Contains(ShortType(r.Type)))
                .GroupBy(r => new { Type = ShortType(r.Type), r.SubscriptionId })
                .Select(g => new TypeSubCount(g.Key.Type, g.Key.SubscriptionId, g.Count()))
                .ToList();

            _untaggedSubIds = _untaggedByType
                .Select(t => t.SubscriptionId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(id => SubName(id), StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load optimization data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string SubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) ? name : subscriptionId;

    private string SubTenant(string subscriptionId) =>
        _subTenant.TryGetValue(subscriptionId, out var tid) ? TenantNames.GetCachedOrId(tid) : string.Empty;

    // Chart legend label: subscription name, plus its tenant when multi-tenancy is on and known.
    private string SubLabel(string subscriptionId)
    {
        var name = SubName(subscriptionId);
        if (!ShowTenant) return name;
        var tenant = SubTenant(subscriptionId);
        return string.IsNullOrWhiteSpace(tenant) || tenant.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? name
            : $"{name} · {tenant}";
    }

    // Builds subId -> tenantId from the customer registry and merges any missing subscription
    // names. Home subscriptions map to the home tenant; no-op when multi-tenancy is disabled.
    private async Task BuildTenantMapAsync()
    {
        if (!Customers.IsEnabled) return;
        var customers = await Customers.GetActiveCustomersAsync();
        foreach (var c in customers)
        {
            if (!string.IsNullOrWhiteSpace(c.TenantId))
                await TenantNames.GetDisplayNameAsync(c.TenantId);

            foreach (var sub in await Customers.GetSubscriptionsAsync(c.Id))
            {
                if (!string.IsNullOrWhiteSpace(c.TenantId))
                    _subTenant[sub.SubscriptionId] = c.TenantId;
                if (!_subNames.ContainsKey(sub.SubscriptionId) && !string.IsNullOrWhiteSpace(sub.SubscriptionName))
                    _subNames[sub.SubscriptionId] = sub.SubscriptionName;
            }
        }
    }

    private static string ShortType(string type)
    {
        var slash = type.LastIndexOf('/');
        return slash >= 0 && slash < type.Length - 1 ? type[(slash + 1)..] : type;
    }

    private static Color ReasonColor(string reason) => reason switch
    {
        "Unattached managed disk"        => Color.Error,
        "Stopped but allocated VM"       => Color.Error,
        "Empty App Service plan (no sites)" => Color.Warning,
        _                                 => Color.Warning
    };
}
