@page "/security"
@inject SecurityPostureService Sec
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject CustomerStore Customers
@inject TenantNameService TenantNames

<PageTitle>Security Posture – CSP Dashboard</PageTitle>

<PageTour />

@if (_loading)
{
    <RadzenProgressBar Class="mb-4" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
}
@if (_error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-4" AllowClose="false">@_error</RadzenAlert>
}

<RadzenText Class="mb-1 fw-bold" data-tour="10" data-tour-title="Security Posture" data-tour-desc="Microsoft Defender for Cloud secure score per subscription and the top control gaps to fix." TextStyle="TextStyle.H5">Security Posture</RadzenText>
<RadzenText Class="mb-4" TextStyle="TextStyle.Body2" Style="color: var(--rz-secondary);">
    Microsoft Defender for Cloud secure score per subscription and the top control gaps to fix.
    Azure security posture only — not Microsoft 365 Secure Score.
</RadzenText>

@if (!_loading && Sec.LastAccessDenied)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" Icon="lock"  AllowClose="false">
        This page reads <strong>Microsoft Defender for Cloud</strong> secure scores, which require the app
        identity to have the <strong>Security Reader</strong> (or Reader) role on the target subscriptions.
        Grant it via the Phase 7 Reader assignment or assign Security Reader to populate this page.
    </RadzenAlert>
}

@* ── KPI summary ────────────────────────────────────────────────────────────── *@
<RadzenRow Class="mb-4" data-tour="12" data-tour-title="Security summary" data-tour-desc="Security summary &mdash; average secure score, subscriptions scored, and findings to address." Gap="1rem">
    <KpiCard Label="Average Secure Score" Value="@($"{_avgPercent:F0}%")"
             ValueColor="@ScoreColor(_avgPercent)" Md="3" />
    <KpiCard Label="Subscriptions Scored" Value="@_scores.Count.ToString("N0")" Md="3" />
    <KpiCard Label="Findings to Address" Value="@_findings.Count.ToString("N0")"
             ValueColor="@(_findings.Count > 0 ? BadgeStyle.Warning : BadgeStyle.Success)" Md="3" />
    <KpiCard Label="Unhealthy Resources" Value="@_totalUnhealthy.ToString("N0")"
             ValueColor="@(_totalUnhealthy > 0 ? BadgeStyle.Danger : BadgeStyle.Success)" Md="3" />
</RadzenRow>

@* ── Secure score per subscription ──────────────────────────────────────────── *@
<RadzenCard Class="pa-4 mb-4">
    <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Secure Score by Subscription</RadzenText>
    @if (!_loading && _scores.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">
            No secure scores were returned. Defender for Cloud may not be enabled on these subscriptions,
            or the app identity lacks Security Reader access.
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid TItem="SecureScoreSummary" Data="_scores" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="false" FilterMode="Radzen.FilterMode.Simple" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="DisplayName" Title="Subscription" TItem="SecureScoreSummary" />
                @if (ShowTenant)
                {
                    <RadzenDataGridColumn Title="Tenant" TItem="SecureScoreSummary" Sortable="false" Filterable="false">
                        <Template Context="context">@SubTenant(context.SubscriptionId)</Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn Title="Secure Score" TItem="SecureScoreSummary" Property="Percentage">
                    <Template Context="context">
                        <div class="d-flex align-center" style="gap:12px; min-width:220px;">
                            <RadzenProgressBar Value="context.Percentage" Class="flex-grow-1" Style="height:8px;" ShowValue="false" ProgressBarStyle="@(Enum.Parse<ProgressBarStyle>((ScoreColor(context.Percentage)).ToString()))" />
                            <RadzenText Class="fw-bold" TextStyle="TextStyle.Body2">@($"{context.Percentage:F0}%")</RadzenText>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Points" TItem="SecureScoreSummary" Property="Current">
                    <Template Context="context">@($"{context.Current:F1} / {context.Max}")</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@* ── Top findings ───────────────────────────────────────────────────────────── *@
<RadzenCard Class="pa-4 mb-4">
    <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Top Security Findings</RadzenText>
    @if (!_loading && _findings.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">
            No controls with unhealthy resources were found. Your tracked recommendations are healthy.
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid FilterMode="Radzen.FilterMode.Simple" TItem="SecurityControlFinding" Data="_findings" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="true" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="ControlName" Title="Recommendation" TItem="SecurityControlFinding" />
                <RadzenDataGridColumn Title="Unhealthy" TItem="SecurityControlFinding" Property="Unhealthy">
                    <Template Context="context">
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger">@context.Unhealthy</RadzenBadge>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Healthy" Title="Healthy" TItem="SecurityControlFinding" />
                <RadzenDataGridColumn Property="Weight" Title="Weight" TItem="SecurityControlFinding" />
                <RadzenDataGridColumn Title="Subscription" TItem="SecurityControlFinding" Sortable="false" Filterable="false">
                    <Template Context="context">@SubName(context.SubscriptionId)</Template>
                </RadzenDataGridColumn>
                @if (ShowTenant)
                {
                    <RadzenDataGridColumn Title="Tenant" TItem="SecurityControlFinding" Sortable="false" Filterable="false">
                        <Template Context="context">@SubTenant(context.SubscriptionId)</Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private bool    _loading = true;
    private string? _error;

    private double _avgPercent;
    private int    _totalUnhealthy;
    private List<SecureScoreSummary>     _scores   = [];
    private List<SecurityControlFinding> _findings = [];
    private Dictionary<string, string>   _subNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var scoresTask   = Sec.GetSecureScoresAsync();
            var findingsTask = Sec.GetTopFindingsAsync();
            var namesTask    = Sec.GetSubscriptionNamesAsync();

            _scores   = await scoresTask;
            _findings = await findingsTask;
            _subNames = await namesTask;
            await BuildTenantMapAsync();

            _avgPercent     = _scores.Count > 0 ? _scores.Average(s => s.Percentage) : 0;
            _totalUnhealthy = _findings.Sum(f => f.Unhealthy);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load security posture data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string SubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : subscriptionId;

    private bool ShowTenant => Options.MultiTenancy.Enabled;

    private string SubTenant(string subscriptionId) =>
        _subTenant.TryGetValue(subscriptionId, out var tid) ? TenantNames.GetCachedOrId(tid) : string.Empty;

    private readonly Dictionary<string, string> _subTenant = new(StringComparer.OrdinalIgnoreCase);

    // Builds subId -> tenantId from the customer registry and merges missing subscription names.
    private async Task BuildTenantMapAsync()
    {
        if (!Customers.IsEnabled) return;
        foreach (var c in await Customers.GetActiveCustomersAsync())
        {
            if (!string.IsNullOrWhiteSpace(c.TenantId))
                await TenantNames.GetDisplayNameAsync(c.TenantId);

            foreach (var sub in await Customers.GetSubscriptionsAsync(c.Id))
            {
                if (!string.IsNullOrWhiteSpace(c.TenantId))
                    _subTenant[sub.SubscriptionId] = c.TenantId;
                if (!_subNames.ContainsKey(sub.SubscriptionId) && !string.IsNullOrWhiteSpace(sub.SubscriptionName))
                    _subNames[sub.SubscriptionId] = sub.SubscriptionName;
            }
        }

        await MapHomeSubscriptionsAsync();
    }

    // The home/partner's own subscriptions live in the SubStore registry, not the
    // CustomerSubscription table, so attribute them to the home tenant explicitly — otherwise
    // home subscriptions render without a [tenant] label while customer ones have it, making it
    // look like only one subscription per tenant is labelled.
    private async Task MapHomeSubscriptionsAsync()
    {
        var home = await Customers.GetHomeCustomerAsync();
        var homeTenant = !string.IsNullOrWhiteSpace(home?.TenantId)
            ? home!.TenantId
            : !string.IsNullOrWhiteSpace(Options.MultiTenancy.HomeTenantId)
                ? Options.MultiTenancy.HomeTenantId
                : Options.TenantId;
        if (string.IsNullOrWhiteSpace(homeTenant)) return;

        await TenantNames.GetDisplayNameAsync(homeTenant);
        foreach (var id in SubStore.AllIds)
            if (!_subTenant.ContainsKey(id))
                _subTenant[id] = homeTenant;
    }

    private static BadgeStyle ScoreColor(double percent) => percent switch
    {
        >= 70 => BadgeStyle.Success,
        >= 40 => BadgeStyle.Warning,
        _     => BadgeStyle.Danger
    };
}
