@page "/customers"
@using CmCSP.Data
@inject CustomerStore Store
@inject GdapOnboardingService Gdap
@inject TenantNameService TenantName
@inject CostManagementOptions Options
@inject ITenantScopeProvider ScopeProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService Notifications

<PageTitle>Customers – CSP Dashboard</PageTitle>

<PageTour />

<RadzenText Class="mb-1 fw-bold" data-tour="10" data-tour-title="Customers" data-tour-desc="CSP multi-tenancy: onboard customers, map their Azure subscriptions, and manage delegated access." TextStyle="TextStyle.H5">Customers</RadzenText>
<RadzenText Class="mb-4" TextStyle="TextStyle.Body2" Style="color: var(--rz-secondary);">
    CSP multi-tenancy: onboard a customer (one Entra tenant), map its Azure subscriptions, and
    suspend or reactivate access. A customer's users sign in from their own tenant and see only
    their own data.
</RadzenText>

@if (!_ready)
{
    <RadzenProgressBar Class="my-4" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
}
else if (!Options.MultiTenancy.Enabled)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4" Icon="info"  AllowClose="false">
        Multi-tenancy is disabled. Set <code>AzureCostManagement:MultiTenancy:Enabled = true</code>
        (and provision the SQL data platform) to onboard customers.
    </RadzenAlert>
}
else if (!Store.IsEnabled)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" Icon="storage"  AllowClose="false">
        The SQL data platform is required for the customer registry but is not configured.
    </RadzenAlert>
}
else if (!_isPartner)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" Icon="lock"  AllowClose="false">
        Customer management is available to the partner (home tenant) only.
    </RadzenAlert>
}
else
{
    @* ── Onboard a customer ─────────────────────────────────────────────────── *@
    <RadzenCard Class="pa-4 mb-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Onboard a customer</RadzenText>
        <div class="d-flex flex-wrap gap-3 align-center">
            <RadzenFormField Text="Customer tenant GUID">
                <RadzenTextBox @bind-Value="_newTenantId" Style="min-width:330px" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" aria-label="Customer tenant GUID" />
            </RadzenFormField>
            <RadzenFormField Text="Display name">
                <RadzenTextBox @bind-Value="_newDisplayName" Style="min-width:240px" aria-label="Display name" />
            </RadzenFormField>
            <RadzenFormField Text="GDAP relationship id (optional)">
                <RadzenTextBox @bind-Value="_newGdapId" Style="min-width:280px" aria-label="GDAP relationship id (optional)" />
            </RadzenFormField>
            <RadzenButton Variant="Variant.Filled"  Disabled="_busy" ButtonStyle="ButtonStyle.Primary" Click="OnboardAsync" Icon="person_add" Text="Onboard" />
        </div>
        <RadzenText Class="mt-3 d-block" TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">
            After onboarding, send the customer admin the <b>consent link</b> and then use
            <b>Discover subscriptions</b> to map their Azure subscriptions automatically (GDAP).
        </RadzenText>
        @if (!Gdap.CanAcquireCrossTenantTokens)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Class="mt-2" Icon="info"  AllowClose="false">
                The app is running on a managed identity, which cannot read across tenants. Configure the
                Entra app client secret to enable GDAP consent links and subscription auto-discovery;
                otherwise map subscriptions manually below.
            </RadzenAlert>
        }
    </RadzenCard>

    @* ── Customer list ──────────────────────────────────────────────────────── *@
    <RadzenCard Class="pa-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Registered customers (@_customers.Count)</RadzenText>
        @if (_customers.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-secondary);">No customers onboarded yet.</RadzenText>
        }
        else
        {
            <div class="">
                @foreach (var c in _customers)
                {
                    <RadzenPanel @key="c.Id" AllowCollapse="true" Collapsed="true">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-2">
                                <RadzenBadge BadgeStyle="@(c.Status == "active" ? BadgeStyle.Success : BadgeStyle.Base)" Variant="Variant.Flat">
                                    @c.Status
                                </RadzenBadge>
                                <RadzenText Class="fw-bold" TextStyle="TextStyle.Body1">@c.DisplayName</RadzenText>
                                <RadzenText title="@c.TenantId" TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">
                                    @(_tenantNames.GetValueOrDefault(c.TenantId) ?? c.TenantId)
                                </RadzenText>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (c.Status == "active")
                                {
                                    <RadzenButton Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_busy" ButtonStyle="ButtonStyle.Warning" Click="@(() => SetStatusAsync(c.Id, "suspended"))" Icon="block" Text="Suspend" />
                                }
                                else
                                {
                                    <RadzenButton Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_busy" ButtonStyle="ButtonStyle.Success" Click="@(() => SetStatusAsync(c.Id, "active"))" Icon="check_circle" Text="Reactivate" />
                                }
                            </div>

                            @* ── GDAP onboarding ───────────────────────────────────────── *@
                            <RadzenText Class="mb-2 fw-bold" TextStyle="TextStyle.Subtitle2">Delegated access (GDAP)</RadzenText>
                            <div class="d-flex flex-wrap gap-2 align-center mb-2">
                                <RadzenButton Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" Click="@(() => CopyConsentLinkAsync(c.TenantId))" Icon="link" Text="Copy consent link" />
                                <RadzenButton Size="ButtonSize.Small" Variant="Variant.Filled" Disabled="@(_busy || !Gdap.CanAcquireCrossTenantTokens)" ButtonStyle="ButtonStyle.Secondary" Click="@(() => DiscoverSubsAsync(c.Id, c.TenantId))" Icon="sync" Text="Discover subscriptions" />
                                <RadzenButton Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="@(_busy || !Gdap.CanAcquireCrossTenantTokens)" ButtonStyle="ButtonStyle.Success" Click="@(() => GrantReaderAsync(c.Id, c.TenantId))" Icon="key" Text="Grant Cost Reader" />
                                @if (!string.IsNullOrWhiteSpace(c.GdapRelationshipId))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Flat"><RadzenIcon Icon="verified_user" />
                                        @c.GdapRelationshipId
                                    </RadzenBadge>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-center mb-4">
                                <RadzenFormField Text="GDAP relationship id">
                                    <RadzenTextBox @bind-Value="_gdapId[c.Id]" Style="min-width:300px" aria-label="GDAP relationship id" />
                                </RadzenFormField>
                                <RadzenButton Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" Click="@(() => SaveGdapIdAsync(c.Id))" Icon="save" Text="Save id" />
                            </div>

                            <RadzenText Class="mb-2 fw-bold" TextStyle="TextStyle.Subtitle2">Subscriptions</RadzenText>
                            <RadzenText Class="mb-2 d-block" TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">
                                Use <b>Discover subscriptions</b> above to map automatically (needs the app to
                                hold <b>Reader</b> in the customer tenant). Can't use discovery? Map a
                                subscription <b>manually</b> below by pasting its GUID. Note: mapping only links
                                the subscription here &mdash; cost data still requires the app to have
                                <b>Reader</b> (or <b>Cost Management Reader</b>) on that subscription so the
                                collector can read its usage. For CSP / Azure&nbsp;Plan customers where you hold
                                Owner via AOBO, <b>Grant Cost Reader</b> assigns that role to the app
                                automatically on every mapped subscription.
                            </RadzenText>
                            @{
                                var subs = _subsByCustomer.TryGetValue(c.Id, out var s) ? s : [];
                            }
                            @if (subs.Count == 0)
                            {
                                <RadzenText Class="mb-2" TextStyle="TextStyle.Body2" Style="color: var(--rz-secondary);">
                                    No subscriptions mapped.
                                </RadzenText>
                            }
                            else
                            {
                                <table class="rz-data-grid-data mb-2">
                                    <tbody>
                                        @foreach (var sub in subs)
                                        {
                                            <tr @key="sub.SubscriptionId">
                                                <td>
                                                    <RadzenText TextStyle="TextStyle.Body2">
                                                        @(string.IsNullOrWhiteSpace(sub.SubscriptionName) ? "(unnamed)" : sub.SubscriptionName)
                                                    </RadzenText>
                                                </td>
                                                <td>
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">@sub.SubscriptionId</RadzenText>
                                                </td>
                                                <td style="width:1%">
                                                    <RadzenButton Icon="delete"  Size="ButtonSize.Small" Disabled="_busy" aria-label="Remove subscription" ButtonStyle="ButtonStyle.Danger" Click="@(() => RemoveSubAsync(c.Id, sub.SubscriptionId))" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            <div class="d-flex flex-wrap gap-2 align-center">
                                <RadzenFormField Text="Subscription GUID">
                                    <RadzenTextBox @bind-Value="_newSubId[c.Id]" Style="min-width:320px" Placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" aria-label="Subscription GUID" />
                                </RadzenFormField>
                                <RadzenFormField Text="Name (optional)">
                                    <RadzenTextBox @bind-Value="_newSubName[c.Id]" Style="min-width:200px" aria-label="Name (optional)" />
                                </RadzenFormField>
                                <RadzenButton Size="ButtonSize.Small" Variant="Variant.Filled" Disabled="_busy" ButtonStyle="ButtonStyle.Primary" Click="@(() => AddSubAsync(c.Id))" Icon="add" Text="Map subscription" />
                            </div>
                        </ChildContent>
                    </RadzenPanel>
                }
            </div>
        }
    </RadzenCard>
}

@code {
    private void Notify(string message, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage { Severity = severity, Detail = message, Duration = 6000 });
    private bool _ready;
    private bool _busy;
    private bool _isPartner;

    private string _newTenantId = string.Empty;
    private string _newDisplayName = string.Empty;
    private string _newGdapId = string.Empty;

    private readonly Dictionary<long, string> _newSubId = new();
    private readonly Dictionary<long, string> _newSubName = new();
    private readonly Dictionary<long, string> _gdapId = new();

    private List<CustomerEntity> _customers = [];
    private readonly Dictionary<long, List<CustomerSubscriptionEntity>> _subsByCustomer = new();

    // Resolved organisation display names keyed by tenant GUID (best-effort, via Microsoft Graph).
    private readonly Dictionary<string, string> _tenantNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (Options.MultiTenancy.Enabled && Store.IsEnabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            _isPartner = scope.IsPartner;
            if (_isPartner)
            {
                await ReloadAsync();
            }
            else
            {
                // Customer management is partner-only. A signed-in customer user has no business
                // here, so send them back to their dashboard rather than rendering a dead page.
                Nav.NavigateTo("/", forceLoad: false, replace: true);
                return;
            }
        }
        _ready = true;
    }

    private async Task ReloadAsync()
    {
        _customers = (await Store.GetAllCustomersAsync()).ToList();        _subsByCustomer.Clear();
        foreach (var c in _customers)
        {
            _subsByCustomer[c.Id] = (await Store.GetSubscriptionsAsync(c.Id)).ToList();
            _newSubId.TryAdd(c.Id, string.Empty);
            _newSubName.TryAdd(c.Id, string.Empty);
            _gdapId[c.Id] = c.GdapRelationshipId ?? string.Empty;
        }

        await ResolveTenantNamesAsync();
    }

    /// <summary>
    /// Best-effort resolution of each customer tenant's organisation display name (via Graph), so
    /// the list shows a friendly tenant name rather than a raw GUID. Failures are silent — the UI
    /// falls back to the tenant GUID. Already-resolved tenants are skipped.
    /// </summary>
    private async Task ResolveTenantNamesAsync()
    {
        foreach (var c in _customers)
        {
            if (string.IsNullOrWhiteSpace(c.TenantId) || _tenantNames.ContainsKey(c.TenantId))
                continue;

            // Go through the process-wide cache so names resolved once (this circuit or another)
            // are reused instead of re-issuing a Graph call on every import / reload.
            var name = await TenantName.GetDisplayNameAsync(c.TenantId);
            if (!string.IsNullOrWhiteSpace(name))
            {
                _tenantNames[c.TenantId] = name;
                StateHasChanged();
            }
        }
    }

    private async Task OnboardAsync()
    {
        _busy = true;
        try
        {
            await Store.OnboardCustomerAsync(
                _newTenantId,
                _newDisplayName,
                string.IsNullOrWhiteSpace(_newGdapId) ? null : _newGdapId.Trim());
            Notify($"Onboarded {_newDisplayName}.", NotificationSeverity.Success);
            _newTenantId = string.Empty;
            _newDisplayName = string.Empty;
            _newGdapId = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetStatusAsync(long customerId, string status)
    {
        _busy = true;
        try
        {
            await Store.SetCustomerStatusAsync(customerId, status);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddSubAsync(long customerId)
    {
        _busy = true;
        try
        {
            await Store.AddSubscriptionAsync(
                customerId,
                _newSubId.GetValueOrDefault(customerId, string.Empty),
                _newSubName.GetValueOrDefault(customerId, string.Empty));
            _newSubId[customerId] = string.Empty;
            _newSubName[customerId] = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveSubAsync(long customerId, string subscriptionId)
    {
        _busy = true;
        try
        {
            await Store.RemoveSubscriptionAsync(customerId, subscriptionId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyConsentLinkAsync(string tenantId)
    {
        try
        {
            var redirect = Nav.ToAbsoluteUri("/gdap/consent-callback").ToString();
            var url = Gdap.BuildAdminConsentUrl(tenantId, redirect);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Notify("Admin-consent link copied to clipboard. Send it to the customer admin.", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
    }

    private async Task DiscoverSubsAsync(long customerId, string tenantId)
    {
        _busy = true;
        try
        {
            var result = await Gdap.SyncSubscriptionsAsync(customerId, tenantId);
            if (result.Discovered == 0)
                Notify(
                    "No subscriptions found. Admin consent only grants Microsoft Graph access — it does " +
                    "NOT grant Azure resource access. The customer must also assign this app the " +
                    "'Reader' (or 'Cost Management Reader') role on their subscription(s) or management " +
                    "group in Access control (IAM), or include those Azure roles in the GDAP relationship.",
                    NotificationSeverity.Warning);
            else
                Notify($"Discovered {result.Discovered} subscription(s); mapped {result.Added} new.", NotificationSeverity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GrantReaderAsync(long customerId, string tenantId)
    {
        _busy = true;
        try
        {
            var result = await Gdap.GrantCostReaderAsync(customerId, tenantId);
            if (result.Total == 0)
            {
                Notify(
                    result.Messages.Count > 0 ? result.Messages[0] : "Nothing to grant.",
                    NotificationSeverity.Warning);
            }
            else if (result.Failed == 0)
            {
                Notify(
                    $"Cost Management Reader ensured on {result.Total} subscription(s) " +
                    $"({result.Granted} newly granted, {result.AlreadyPresent} already in place).",
                    NotificationSeverity.Success);
            }
            else
            {
                var detail = result.Messages.Count > 0 ? " " + string.Join(" ", result.Messages) : string.Empty;
                Notify(
                    $"Granted {result.Granted}, already {result.AlreadyPresent}, failed {result.Failed} " +
                    $"of {result.Total}.{detail}",
                    NotificationSeverity.Warning);
            }
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveGdapIdAsync(long customerId)
    {
        _busy = true;
        try
        {
            await Store.UpdateGdapRelationshipAsync(customerId, _gdapId.GetValueOrDefault(customerId, string.Empty));
            Notify("GDAP relationship id saved.", NotificationSeverity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, NotificationSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
