@page "/reservations"
@inject ICostDetailsService CostDetails
@inject ICostManagementService CostService
@inject OptimizationService Optimization
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject CustomerStore Customers
@inject TenantNameService TenantNames
@implements IDisposable

<PageTitle>Reservations – CSP Dashboard</PageTitle>

<PageTour />

@if (_loading)
{
    <RadzenProgressBar Class="mb-4" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
}
@if (_error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-4" AllowClose="false">@_error</RadzenAlert>
}

<RadzenText Class="mb-4 fw-bold" data-tour="10" data-tour-title="Reservations" data-tour-desc="Reservation and savings-plan utilisation, purchase recommendations, and upcoming expiries." TextStyle="TextStyle.H5">Reservations</RadzenText>

@* ── Scope info banner ──────────────────────────────────────────────────────── *@
@if (CostDetails.HasBillingAccountAccess)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4" AllowClose="false">
        Fetching data at <strong>billing-account / customer scope</strong> — full Used/Unused
        breakdown per customer is available.
    </RadzenAlert>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" AllowClose="false">
        <strong>Billing account not configured.</strong> Showing reservation data at
        <strong>subscription scope</strong> only — reservations shared across customers
        are not visible. Configure <code>AzureCostManagement:BillingAccount</code> to
        enable per-customer billing-scope queries.
    </RadzenAlert>
}

@if (!Options.CostDetails.Enabled)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" AllowClose="false">
        <RadzenStack AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenText>
                Cost Details API is disabled. Enable it to fetch reservation and amortized-cost data.
            </RadzenText>
            <RadzenButton Variant="Variant.Filled" Size="ButtonSize.Small"  Disabled="_enabling" ButtonStyle="ButtonStyle.Warning" Click="EnableCostDetailsAsync" Icon="power_settings_new" Text="@(_enabling ? "Enabling…" : "Enable Now")" />
        </RadzenStack>
    </RadzenAlert>
}

@* ── Controls ───────────────────────────────────────────────────────────────── *@
<RadzenCard Class="pa-4 mb-4">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeSM="4">
            <RadzenDatePicker TValue="DateTime?" Value="_selectedMonth" Change="OnMonthChanged" DateFormat="MMMM yyyy" ShowDays="false" AllowClear="false" />
        </RadzenColumn>
        @if (CostDetails.HasBillingAccountAccess)
        {
            <RadzenColumn Size="12" SizeSM="4">
                <RadzenDropDown TValue="string" Value="@_selectedScope"
                                Change="@(value => OnScopeChanged((string)value))"
                                Data="@(new[] { new { Id = "billing", Label = "Billing Account (all customers)" }, new { Id = "subscription", Label = "Subscriptions" } })"
                                TextProperty="Label" ValueProperty="Id" aria-label="Scope" />
            </RadzenColumn>
        }
        <RadzenColumn Size="12" SizeSM="4">
            <RadzenButton Variant="Variant.Outlined"  Disabled="_loading" ButtonStyle="ButtonStyle.Primary" Click="LoadAsync" Icon="refresh" Text="Refresh" />
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@* ── KPI cards ──────────────────────────────────────────────────────────────── *@
<RadzenRow Class="mb-4" Gap="1rem">
    <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
        <RadzenCard Class="pa-4">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Total RI Cost</RadzenText>
            <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5">@Fmt(_totalCost)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
        <RadzenCard Class="pa-4">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Used Cost</RadzenText>
            <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-success);">@Fmt(_usedCost)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
        <RadzenCard Class="pa-4">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Unused Cost</RadzenText>
            <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="color: var(--rz-danger);">@Fmt(_unusedCost)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
        <RadzenCard Class="pa-4">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary);">Overall Utilisation</RadzenText>
            <RadzenText Class="mt-1 fw-bold" TextStyle="TextStyle.H5" Style="@($"color: var(--rz-{(_utilPct >= 80 ? BadgeStyle.Success : _utilPct >= 50 ? BadgeStyle.Warning : BadgeStyle.Danger).ToString().ToLowerInvariant()});")">
                @_utilPct.ToString("F1")%
            </RadzenText>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@* ── Utilisation chart ──────────────────────────────────────────────────────── *@
@if (_chartData.Count > 0)
{
    <RadzenCard Class="pa-4 mb-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Used vs Unused by Reservation</RadzenText>
        <ApexChart TItem="ChartPoint" Options="_barOpts">
            <ApexPointSeries TItem="ChartPoint"
                             Items="_chartData.OrderByDescending(x => x.UsedCost).Take(20).ToList()"
                             Name="Used"
                             XValue="@(e => e.Label)"
                             YValue="@(e => (decimal?)e.UsedCost)"
                             SeriesType="SeriesType.Bar" />
            <ApexPointSeries TItem="ChartPoint"
                             Items="_chartData.OrderByDescending(x => x.UsedCost).Take(20).ToList()"
                             Name="Unused"
                             XValue="@(e => e.Label)"
                             YValue="@(e => (decimal?)e.UnusedCost)"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </RadzenCard>
}

@* ── Utilisation trend (last 6 months) ──────────────────────────────────────── *@
@if (_trendLoading || _trendData.Count > 0)
{
    <RadzenCard Class="pa-4 mb-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Utilisation Trend (last 6 months)</RadzenText>
        @if (_trendLoading)
        {
            <RadzenProgressBar Class="my-4" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <ApexChart TItem="TrendPoint" Options="_trendOpts">
                <ApexPointSeries TItem="TrendPoint"
                                 Items="_trendData"
                                 Name="Utilisation %"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => (decimal?)e.UtilPct)"
                                 SeriesType="SeriesType.Line" />
            </ApexChart>
        }
    </RadzenCard>
}

@* ── Detail table ──────────────────────────────────────────────────────────── *@
<RadzenCard Class="pa-4">
    <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">
        Reservation Detail
        @if (!string.IsNullOrEmpty(_scopeLabel))
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Class="ml-2">@_scopeLabel</RadzenBadge>
        }
    </RadzenText>

    @if (!_loading && _rows.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">
            No reservation data found for @_selectedMonth?.ToString("MMMM yyyy").
            Ensure the service principal has Cost Management Reader access and that
            reservations exist in the selected period.
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid FilterMode="Radzen.FilterMode.Simple" TItem="ReservationRow" Data="_rows" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="true" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                @if (CostDetails.HasBillingAccountAccess && _selectedScope == "billing")
                {
                    <RadzenDataGridColumn Property="CustomerName" Title="Customer" TItem="ReservationRow" />
                }
                <RadzenDataGridColumn Property="ReservationName" Title="Reservation" TItem="ReservationRow" />
                <RadzenDataGridColumn Property="MeterCategory" Title="Service" TItem="ReservationRow" />
                <RadzenDataGridColumn Property="Term" Title="Term" TItem="ReservationRow" />
                <RadzenDataGridColumn Property="SubscriptionName" Title="Subscription" TItem="ReservationRow" />
                <RadzenDataGridColumn Property="NormalizedUsedCost" Title="@($"Used ({Options.TargetCurrency})")" TItem="ReservationRow" FormatString="{0:N0}" />
                <RadzenDataGridColumn Property="NormalizedUnusedCost" Title="@($"Unused ({Options.TargetCurrency})")" TItem="ReservationRow" FormatString="{0:N0}" />
                <RadzenDataGridColumn Property="NormalizedTotalCost" Title="@($"Total ({Options.TargetCurrency})")" TItem="ReservationRow" FormatString="{0:N0}" />
                <RadzenDataGridColumn Title="Utilisation %" TItem="ReservationRow" Sortable="false" Filterable="false">
                    <Template Context="context">
                        <RadzenProgressBar Value="(double)context.UtilizationPct" Class="my-1" ShowValue="false" ProgressBarStyle="@(Enum.Parse<ProgressBarStyle>((UtilColor(context.UtilizationPct)).ToString()))" />
                        <RadzenText TextStyle="TextStyle.Caption">@context.UtilizationPct.ToString("F1")%</RadzenText>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@* ── Phase 7: purchase recommendations + expiry (Cost Management Reader / Reservations Reader) ── *@
@if (Optimization.LastAccessDenied)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mt-4" Icon="lock"  AllowClose="false">
        Purchase recommendations need <strong>Cost Management Reader</strong> on the target
        subscriptions. Reservation expiry needs <strong>Reservations Reader</strong> at tenant level
        (<code>/providers/Microsoft.Capacity</code>) or on each reservation order &mdash; reservations
        do not inherit subscription roles. Assign these to the app's service principal in each tenant.
    </RadzenAlert>
}

<RadzenCard Class="pa-4 mt-4">
    <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Purchase Recommendations</RadzenText>
    @if (_recommendations.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">
            No reservation or savings-plan purchase recommendations were returned. This is normal
            when usage is already well covered, or when the identity lacks Cost Management Reader.
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid FilterMode="Radzen.FilterMode.Simple" TItem="ReservationPurchaseRecommendation" Data="_recommendations" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="true" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="Sku" Title="SKU" TItem="ReservationPurchaseRecommendation" />
                <RadzenDataGridColumn Property="ResourceType" Title="Resource Type" TItem="ReservationPurchaseRecommendation" />
                <RadzenDataGridColumn Property="Term" Title="Term" TItem="ReservationPurchaseRecommendation" />
                <RadzenDataGridColumn Property="Scope" Title="Scope" TItem="ReservationPurchaseRecommendation" />
                <RadzenDataGridColumn Title="Subscription" TItem="ReservationPurchaseRecommendation" Sortable="false" Filterable="false">
                    <Template Context="context">@SubName(context.SubscriptionId)</Template>
                </RadzenDataGridColumn>
                @if (ShowTenant)
                {
                    <RadzenDataGridColumn Title="Tenant" TItem="ReservationPurchaseRecommendation" Sortable="false" Filterable="false">
                        <Template Context="context">@SubTenant(context.SubscriptionId)</Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn Property="RecommendedQuantity" Title="Qty" TItem="ReservationPurchaseRecommendation" FormatString="{0:N0}" />
                <RadzenDataGridColumn Property="NormalizedNetSavings" Title="@($"Est. Savings ({Options.TargetCurrency})")" TItem="ReservationPurchaseRecommendation" FormatString="{0:N0}" />
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@if (_orders.Count > 0)
{
    <RadzenCard Class="pa-4 mt-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Reservation Expiry</RadzenText>
        <RadzenDataGrid TItem="ReservationOrderInfo" Data="_orders" AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="false" FilterMode="Radzen.FilterMode.Simple" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="DisplayName" Title="Reservation" TItem="ReservationOrderInfo" />
                <RadzenDataGridColumn Property="Term" Title="Term" TItem="ReservationOrderInfo" />
                <RadzenDataGridColumn Property="Quantity" Title="Qty" TItem="ReservationOrderInfo" FormatString="{0:N0}" />
                <RadzenDataGridColumn Property="ProvisioningState" Title="State" TItem="ReservationOrderInfo" />
                <RadzenDataGridColumn Title="Expires" TItem="ReservationOrderInfo" Sortable="false" Filterable="false">
                    <Template Context="context">
                        @(context.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Days Left" TItem="ReservationOrderInfo" Sortable="false" Filterable="false">
                    <Template Context="context">
                        @if (context.DaysUntilExpiry is { } d)
                        {
                            <RadzenBadge BadgeStyle="@(d < 0 ? BadgeStyle.Danger : d <= 30 ? BadgeStyle.Warning : BadgeStyle.Success)">
                                @(d < 0 ? "Expired" : $"{d} d")
                            </RadzenBadge>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private record ChartPoint(string Label, decimal UsedCost, decimal UnusedCost);
    private record TrendPoint(string Label, decimal UtilPct, decimal TotalCost);

    private bool    _loading  = true;
    private bool    _enabling = false;
    private string? _error;

    // Phase 7: reservation purchase recommendations + expiry (Microsoft.Consumption / Capacity).
    private List<ReservationPurchaseRecommendation> _recommendations = [];
    private List<ReservationOrderInfo>              _orders          = [];

    private DateTime? _selectedMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private string    _selectedScope = "billing";
    private string    _scopeLabel    = string.Empty;

    private List<ReservationRow> _rows      = [];
    private List<ChartPoint>     _chartData = [];

    private bool             _trendLoading;
    private List<TrendPoint> _trendData = [];

    private decimal _totalCost;
    private decimal _usedCost;
    private decimal _unusedCost;
    private decimal _utilPct;

    private readonly ApexChartOptions<ChartPoint> _barOpts = new()
    {
        Chart       = new Chart { Toolbar = new Toolbar { Show = false }, Stacked = true },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 2 } },
        Yaxis       = [new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(0) : ''; }" } }]
    };

    private readonly ApexChartOptions<TrendPoint> _trendOpts = new()
    {
        Chart  = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
        Yaxis  = [new YAxis { Min = 0, Max = 100, Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(0) + '%' : ''; }" } }]
    };

    protected override void OnInitialized()
    {
        // Default scope: billing if available, else subscription
        _selectedScope = CostDetails.HasBillingAccountAccess ? "billing" : "subscription";
    }

    protected override async Task OnInitializedAsync()
    {
        // Purchase recommendations + expiry come from Resource Graph / Consumption / Capacity and
        // are independent of the Cost Details API, so load them regardless of that toggle.
        _ = LoadOptimizationAsync();

        if (Options.CostDetails.Enabled)
            await LoadAsync();
        else
            _loading = false;
    }

    private async Task LoadOptimizationAsync()
    {
        try
        {
            var recsTask   = Optimization.GetReservationRecommendationsAsync();
            var ordersTask = Optimization.GetReservationOrdersAsync();
            var namesTask  = Optimization.GetSubscriptionNamesAsync();
            _recommendations = await recsTask;
            _orders          = await ordersTask;
            _subNames        = await namesTask;
            await BuildTenantMapAsync();
        }
        catch
        {
            // Non-fatal — the recommendation / expiry sections simply stay empty.
            _recommendations = [];
            _orders          = [];
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnMonthChanged(DateTime? date)
    {
        _selectedMonth = date;
        if (Options.CostDetails.Enabled)
            await LoadAsync();
    }

    private async Task OnScopeChanged(string scope)
    {
        _selectedScope = scope;
        if (Options.CostDetails.Enabled)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();
        try
        {
            var month  = _selectedMonth ?? DateTime.UtcNow;
            var from   = DateOnly.FromDateTime(new DateTime(month.Year, month.Month, 1));
            var to     = from.AddMonths(1).AddDays(-1);

            List<ReservationRow> rows;

            if (_selectedScope == "billing" && CostDetails.HasBillingAccountAccess)
            {
                rows         = await CostDetails.GetAllCustomerReservationsAsync(from, to);
                _scopeLabel  = "Billing Account";
            }
            else
            {
                rows         = await CostDetails.GetAllSubscriptionReservationsAsync(from, to);
                _scopeLabel  = "Subscription";
            }

            _rows = rows;

            _usedCost   = rows.Sum(r => r.NormalizedUsedCost);
            _unusedCost = rows.Sum(r => r.NormalizedUnusedCost);
            _totalCost  = rows.Sum(r => r.NormalizedTotalCost);
            _utilPct    = _totalCost > 0
                ? Math.Round(_usedCost / _totalCost * 100m, 1)
                : 0m;

            // Chart: aggregate by reservation (sum across subscriptions / customers)
            _chartData = rows
                .GroupBy(r => r.ReservationId)
                .Select(g => new ChartPoint(
                    g.First().ReservationName is { Length: > 0 } n ? n : g.Key,
                    g.Sum(r => r.NormalizedUsedCost),
                    g.Sum(r => r.NormalizedUnusedCost)))
                .OrderByDescending(x => x.UsedCost + x.UnusedCost)
                .ToList();

            // Kick off the 6-month trend separately so it doesn't delay the month view.
            // CostDetails caches per month (4h TTL), so repeat refreshes are cheap.
            _ = LoadTrendAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load reservation data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTrendAsync()
    {
        _trendLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var anchor = _selectedMonth ?? DateTime.UtcNow;
            var points = new List<TrendPoint>();
            for (var i = 5; i >= 0; i--)
            {
                var month = new DateTime(anchor.Year, anchor.Month, 1).AddMonths(-i);
                var from  = DateOnly.FromDateTime(month);
                var to    = from.AddMonths(1).AddDays(-1);

                var rows = _selectedScope == "billing" && CostDetails.HasBillingAccountAccess
                    ? await CostDetails.GetAllCustomerReservationsAsync(from, to)
                    : await CostDetails.GetAllSubscriptionReservationsAsync(from, to);

                var total = rows.Sum(r => r.NormalizedTotalCost);
                var used  = rows.Sum(r => r.NormalizedUsedCost);
                var pct   = total > 0 ? Math.Round(used / total * 100m, 1) : 0m;
                points.Add(new TrendPoint(month.ToString("MMM yy"), pct, total));
            }

            // Only surface periods that actually have reservation spend.
            _trendData = points.Any(p => p.TotalCost > 0) ? points : [];
        }
        catch
        {
            // Non-fatal — the trend chart simply stays hidden.
            _trendData = [];
        }
        finally
        {
            _trendLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnableCostDetailsAsync()
    {
        _enabling = true;
        StateHasChanged();
        try
        {
            await SubStore.EnableCostDetailsAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to enable Cost Details API: {ex.Message}";
        }
        finally
        {
            _enabling = false;
        }
    }

    private string Fmt(decimal value) =>
        $"{Options.TargetCurrency} {value:N0}";

    private string SubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : subscriptionId;

    private bool ShowTenant => Options.MultiTenancy.Enabled;

    private string SubTenant(string subscriptionId) =>
        _subTenant.TryGetValue(subscriptionId, out var tid) ? TenantNames.GetCachedOrId(tid) : string.Empty;

    private readonly Dictionary<string, string> _subTenant = new(StringComparer.OrdinalIgnoreCase);

    // Builds subId -> tenantId from the customer registry and merges missing subscription names.
    private async Task BuildTenantMapAsync()
    {
        if (!Customers.IsEnabled) return;
        foreach (var c in await Customers.GetActiveCustomersAsync())
        {
            if (!string.IsNullOrWhiteSpace(c.TenantId))
                await TenantNames.GetDisplayNameAsync(c.TenantId);

            foreach (var sub in await Customers.GetSubscriptionsAsync(c.Id))
            {
                if (!string.IsNullOrWhiteSpace(c.TenantId))
                    _subTenant[sub.SubscriptionId] = c.TenantId;
                if (!_subNames.ContainsKey(sub.SubscriptionId) && !string.IsNullOrWhiteSpace(sub.SubscriptionName))
                    _subNames[sub.SubscriptionId] = sub.SubscriptionName;
            }
        }

        await MapHomeSubscriptionsAsync();
    }

    // The home/partner's own subscriptions live in the SubStore registry, not the
    // CustomerSubscription table, so attribute them to the home tenant explicitly — otherwise
    // home subscriptions render without a [tenant] label while customer ones have it, making it
    // look like only one subscription per tenant is labelled.
    private async Task MapHomeSubscriptionsAsync()
    {
        var home = await Customers.GetHomeCustomerAsync();
        var homeTenant = !string.IsNullOrWhiteSpace(home?.TenantId)
            ? home!.TenantId
            : !string.IsNullOrWhiteSpace(Options.MultiTenancy.HomeTenantId)
                ? Options.MultiTenancy.HomeTenantId
                : Options.TenantId;
        if (string.IsNullOrWhiteSpace(homeTenant)) return;

        await TenantNames.GetDisplayNameAsync(homeTenant);
        foreach (var id in SubStore.AllIds)
            if (!_subTenant.ContainsKey(id))
                _subTenant[id] = homeTenant;
    }

    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);

    private static BadgeStyle UtilColor(decimal pct) =>
        pct >= 80 ? BadgeStyle.Success : pct >= 50 ? BadgeStyle.Warning : BadgeStyle.Danger;

    public void Dispose() { }
}
