@page "/reservations"
@inject ICostDetailsService CostDetails
@inject ICostManagementService CostService
@inject OptimizationService Optimization
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject CustomerStore Customers
@inject TenantNameService TenantNames
@implements IDisposable

<PageTitle>Reservations – CSP Dashboard</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudText Typo="Typo.h5" Class="mb-4 fw-bold">Reservations</MudText>

@* ── Scope info banner ──────────────────────────────────────────────────────── *@
@if (CostDetails.HasBillingAccountAccess)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense>
        Fetching data at <strong>billing-account / customer scope</strong> — full Used/Unused
        breakdown per customer is available.
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense>
        <strong>Billing account not configured.</strong> Showing reservation data at
        <strong>subscription scope</strong> only — reservations shared across customers
        are not visible. Configure <code>AzureCostManagement:BillingAccount</code> to
        enable per-customer billing-scope queries.
    </MudAlert>
}

@if (!Options.CostDetails.Enabled)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText>
                Cost Details API is disabled. Enable it to fetch reservation and amortized-cost data.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PowerSettingsNew"
                       Disabled="_enabling"
                       OnClick="EnableCostDetailsAsync">
                @(_enabling ? "Enabling…" : "Enable Now")
            </MudButton>
        </MudStack>
    </MudAlert>
}

@* ── Controls ───────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Period (month)"
                           Date="_selectedMonth"
                           DateChanged="OnMonthChanged"
                           OpenTo="OpenTo.Month"
                           FixDay="1"
                           Variant="Variant.Outlined" />
        </MudItem>
        @if (CostDetails.HasBillingAccountAccess)
        {
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Scope" Value="_selectedScope"
                           ValueChanged="OnScopeChanged"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value=@("billing")>Billing Account (all customers)</MudSelectItem>
                    <MudSelectItem Value=@("subscription")>Subscriptions</MudSelectItem>
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadAsync"
                       Disabled="_loading">
                Refresh
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── KPI cards ──────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total RI Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold">@Fmt(_totalCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Used Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Success">@Fmt(_usedCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Unused Cost</MudText>
            <MudText Typo="Typo.h5" Class="mt-1 fw-bold" Color="Color.Error">@Fmt(_unusedCost)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Overall Utilisation</MudText>
            <MudText Typo="Typo.h5"
                     Class="mt-1 fw-bold"
                     Color="@(_utilPct >= 80 ? Color.Success : _utilPct >= 50 ? Color.Warning : Color.Error)">
                @_utilPct.ToString("F1")%
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── Utilisation chart ──────────────────────────────────────────────────────── *@
@if (_chartData.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Used vs Unused by Reservation</MudText>
        <ApexChart TItem="ChartPoint" Options="_barOpts">
            <ApexPointSeries TItem="ChartPoint"
                             Items="_chartData.OrderByDescending(x => x.UsedCost).Take(20).ToList()"
                             Name="Used"
                             XValue="@(e => e.Label)"
                             YValue="@(e => (decimal?)e.UsedCost)"
                             SeriesType="SeriesType.Bar" />
            <ApexPointSeries TItem="ChartPoint"
                             Items="_chartData.OrderByDescending(x => x.UsedCost).Take(20).ToList()"
                             Name="Unused"
                             XValue="@(e => e.Label)"
                             YValue="@(e => (decimal?)e.UnusedCost)"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </MudPaper>
}

@* ── Utilisation trend (last 6 months) ──────────────────────────────────────── *@
@if (_trendLoading || _trendData.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Utilisation Trend (last 6 months)</MudText>
        @if (_trendLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
        }
        else
        {
            <ApexChart TItem="TrendPoint" Options="_trendOpts">
                <ApexPointSeries TItem="TrendPoint"
                                 Items="_trendData"
                                 Name="Utilisation %"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => (decimal?)e.UtilPct)"
                                 SeriesType="SeriesType.Line" />
            </ApexChart>
        }
    </MudPaper>
}

@* ── Detail table ──────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">
        Reservation Detail
        @if (!string.IsNullOrEmpty(_scopeLabel))
        {
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-2">@_scopeLabel</MudChip>
        }
    </MudText>

    @if (!_loading && _rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No reservation data found for @_selectedMonth?.ToString("MMMM yyyy").
            Ensure the service principal has Cost Management Reader access and that
            reservations exist in the selected period.
        </MudAlert>
    }
    else
    {
        <MudDataGrid T="ReservationRow"
                     Items="_rows"
                     SortMode="SortMode.Multiple"
                     Filterable
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     Dense>
            <Columns>
                @if (CostDetails.HasBillingAccountAccess && _selectedScope == "billing")
                {
                    <PropertyColumn Property="r => r.CustomerName" Title="Customer" />
                }
                <PropertyColumn Property="r => r.ReservationName" Title="Reservation" />
                <PropertyColumn Property="r => r.MeterCategory"   Title="Service" />
                <PropertyColumn Property="r => r.Term"            Title="Term" />
                <PropertyColumn Property="r => r.SubscriptionName" Title="Subscription" />
                <PropertyColumn Property="r => r.NormalizedUsedCost"
                                Title=@($"Used ({Options.TargetCurrency})")
                                Format="N0" />
                <PropertyColumn Property="r => r.NormalizedUnusedCost"
                                Title=@($"Unused ({Options.TargetCurrency})")
                                Format="N0" />
                <PropertyColumn Property="r => r.NormalizedTotalCost"
                                Title=@($"Total ({Options.TargetCurrency})")
                                Format="N0" />
                <TemplateColumn Title="Utilisation %">
                    <CellTemplate>
                        <MudProgressLinear Value="(double)context.Item.UtilizationPct"
                                           Color="@UtilColor(context.Item.UtilizationPct)"
                                           Rounded Striped Size="Size.Medium"
                                           Class="my-1" />
                        <MudText Typo="Typo.caption">@context.Item.UtilizationPct.ToString("F1")%</MudText>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@* ── Phase 7: purchase recommendations + expiry (Reader / Consumption read) ──── *@
@if (Optimization.LastAccessDenied)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4" Icon="@Icons.Material.Outlined.Lock">
        Reservation purchase recommendations and expiry need the app identity to have the
        <strong>Reader</strong> role (and <code>Microsoft.Consumption</code> read) on the target
        subscriptions to populate these sections.
    </MudAlert>
}

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Purchase Recommendations</MudText>
    @if (_recommendations.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense>
            No reservation or savings-plan purchase recommendations were returned. This is normal
            when usage is already well covered, or when the identity lacks Reader / Consumption read.
        </MudAlert>
    }
    else
    {
        <MudDataGrid T="ReservationPurchaseRecommendation"
                     Items="_recommendations"
                     SortMode="SortMode.Multiple"
                     Filterable
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     Dense>
            <Columns>
                <PropertyColumn Property="r => r.Sku"           Title="SKU" />
                <PropertyColumn Property="r => r.ResourceType"  Title="Resource Type" />
                <PropertyColumn Property="r => r.Term"          Title="Term" />
                <PropertyColumn Property="r => r.Scope"         Title="Scope" />
                <TemplateColumn Title="Subscription">
                    <CellTemplate>@SubName(context.Item.SubscriptionId)</CellTemplate>
                </TemplateColumn>
                @if (ShowTenant)
                {
                    <TemplateColumn Title="Tenant">
                        <CellTemplate>@SubTenant(context.Item.SubscriptionId)</CellTemplate>
                    </TemplateColumn>
                }
                <PropertyColumn Property="r => r.RecommendedQuantity" Title="Qty" Format="N0" />
                <PropertyColumn Property="r => r.NormalizedNetSavings"
                                Title=@($"Est. Savings ({Options.TargetCurrency})")
                                Format="N0" />
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@if (_orders.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Reservation Expiry</MudText>
        <MudDataGrid T="ReservationOrderInfo"
                     Items="_orders"
                     SortMode="SortMode.Multiple"
                     Dense>
            <Columns>
                <PropertyColumn Property="o => o.DisplayName" Title="Reservation" />
                <PropertyColumn Property="o => o.Term"        Title="Term" />
                <PropertyColumn Property="o => o.Quantity"    Title="Qty" Format="N0" />
                <PropertyColumn Property="o => o.ProvisioningState" Title="State" />
                <TemplateColumn Title="Expires">
                    <CellTemplate>
                        @(context.Item.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Days Left">
                    <CellTemplate>
                        @if (context.Item.DaysUntilExpiry is { } d)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(d < 0 ? Color.Error : d <= 30 ? Color.Warning : Color.Success)">
                                @(d < 0 ? "Expired" : $"{d} d")
                            </MudChip>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private record ChartPoint(string Label, decimal UsedCost, decimal UnusedCost);
    private record TrendPoint(string Label, decimal UtilPct, decimal TotalCost);

    private bool    _loading  = true;
    private bool    _enabling = false;
    private string? _error;

    // Phase 7: reservation purchase recommendations + expiry (Microsoft.Consumption / Capacity).
    private List<ReservationPurchaseRecommendation> _recommendations = [];
    private List<ReservationOrderInfo>              _orders          = [];

    private DateTime? _selectedMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private string    _selectedScope = "billing";
    private string    _scopeLabel    = string.Empty;

    private List<ReservationRow> _rows      = [];
    private List<ChartPoint>     _chartData = [];

    private bool             _trendLoading;
    private List<TrendPoint> _trendData = [];

    private decimal _totalCost;
    private decimal _usedCost;
    private decimal _unusedCost;
    private decimal _utilPct;

    private readonly ApexChartOptions<ChartPoint> _barOpts = new()
    {
        Chart       = new Chart { Toolbar = new Toolbar { Show = false }, Stacked = true },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 2 } },
        Yaxis       = [new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(0) : ''; }" } }]
    };

    private readonly ApexChartOptions<TrendPoint> _trendOpts = new()
    {
        Chart  = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
        Yaxis  = [new YAxis { Min = 0, Max = 100, Labels = new YAxisLabels { Formatter = "function(val) { return val != null ? val.toFixed(0) + '%' : ''; }" } }]
    };

    protected override void OnInitialized()
    {
        // Default scope: billing if available, else subscription
        _selectedScope = CostDetails.HasBillingAccountAccess ? "billing" : "subscription";
    }

    protected override async Task OnInitializedAsync()
    {
        // Purchase recommendations + expiry come from Resource Graph / Consumption / Capacity and
        // are independent of the Cost Details API, so load them regardless of that toggle.
        _ = LoadOptimizationAsync();

        if (Options.CostDetails.Enabled)
            await LoadAsync();
        else
            _loading = false;
    }

    private async Task LoadOptimizationAsync()
    {
        try
        {
            var recsTask   = Optimization.GetReservationRecommendationsAsync();
            var ordersTask = Optimization.GetReservationOrdersAsync();
            var namesTask  = Optimization.GetSubscriptionNamesAsync();
            _recommendations = await recsTask;
            _orders          = await ordersTask;
            _subNames        = await namesTask;
            await BuildTenantMapAsync();
        }
        catch
        {
            // Non-fatal — the recommendation / expiry sections simply stay empty.
            _recommendations = [];
            _orders          = [];
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnMonthChanged(DateTime? date)
    {
        _selectedMonth = date;
        if (Options.CostDetails.Enabled)
            await LoadAsync();
    }

    private async Task OnScopeChanged(string scope)
    {
        _selectedScope = scope;
        if (Options.CostDetails.Enabled)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();
        try
        {
            var month  = _selectedMonth ?? DateTime.UtcNow;
            var from   = DateOnly.FromDateTime(new DateTime(month.Year, month.Month, 1));
            var to     = from.AddMonths(1).AddDays(-1);

            List<ReservationRow> rows;

            if (_selectedScope == "billing" && CostDetails.HasBillingAccountAccess)
            {
                rows         = await CostDetails.GetAllCustomerReservationsAsync(from, to);
                _scopeLabel  = "Billing Account";
            }
            else
            {
                rows         = await CostDetails.GetAllSubscriptionReservationsAsync(from, to);
                _scopeLabel  = "Subscription";
            }

            _rows = rows;

            _usedCost   = rows.Sum(r => r.NormalizedUsedCost);
            _unusedCost = rows.Sum(r => r.NormalizedUnusedCost);
            _totalCost  = rows.Sum(r => r.NormalizedTotalCost);
            _utilPct    = _totalCost > 0
                ? Math.Round(_usedCost / _totalCost * 100m, 1)
                : 0m;

            // Chart: aggregate by reservation (sum across subscriptions / customers)
            _chartData = rows
                .GroupBy(r => r.ReservationId)
                .Select(g => new ChartPoint(
                    g.First().ReservationName is { Length: > 0 } n ? n : g.Key,
                    g.Sum(r => r.NormalizedUsedCost),
                    g.Sum(r => r.NormalizedUnusedCost)))
                .OrderByDescending(x => x.UsedCost + x.UnusedCost)
                .ToList();

            // Kick off the 6-month trend separately so it doesn't delay the month view.
            // CostDetails caches per month (4h TTL), so repeat refreshes are cheap.
            _ = LoadTrendAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load reservation data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTrendAsync()
    {
        _trendLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var anchor = _selectedMonth ?? DateTime.UtcNow;
            var points = new List<TrendPoint>();
            for (var i = 5; i >= 0; i--)
            {
                var month = new DateTime(anchor.Year, anchor.Month, 1).AddMonths(-i);
                var from  = DateOnly.FromDateTime(month);
                var to    = from.AddMonths(1).AddDays(-1);

                var rows = _selectedScope == "billing" && CostDetails.HasBillingAccountAccess
                    ? await CostDetails.GetAllCustomerReservationsAsync(from, to)
                    : await CostDetails.GetAllSubscriptionReservationsAsync(from, to);

                var total = rows.Sum(r => r.NormalizedTotalCost);
                var used  = rows.Sum(r => r.NormalizedUsedCost);
                var pct   = total > 0 ? Math.Round(used / total * 100m, 1) : 0m;
                points.Add(new TrendPoint(month.ToString("MMM yy"), pct, total));
            }

            // Only surface periods that actually have reservation spend.
            _trendData = points.Any(p => p.TotalCost > 0) ? points : [];
        }
        catch
        {
            // Non-fatal — the trend chart simply stays hidden.
            _trendData = [];
        }
        finally
        {
            _trendLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnableCostDetailsAsync()
    {
        _enabling = true;
        StateHasChanged();
        try
        {
            await SubStore.EnableCostDetailsAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to enable Cost Details API: {ex.Message}";
        }
        finally
        {
            _enabling = false;
        }
    }

    private string Fmt(decimal value) =>
        $"{Options.TargetCurrency} {value:N0}";

    private string SubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : subscriptionId;

    private bool ShowTenant => Options.MultiTenancy.Enabled;

    private string SubTenant(string subscriptionId) =>
        _subTenant.TryGetValue(subscriptionId, out var tid) ? TenantNames.GetCachedOrId(tid) : string.Empty;

    private readonly Dictionary<string, string> _subTenant = new(StringComparer.OrdinalIgnoreCase);

    // Builds subId -> tenantId from the customer registry and merges missing subscription names.
    private async Task BuildTenantMapAsync()
    {
        if (!Customers.IsEnabled) return;
        foreach (var c in await Customers.GetActiveCustomersAsync())
        {
            if (!string.IsNullOrWhiteSpace(c.TenantId))
                await TenantNames.GetDisplayNameAsync(c.TenantId);

            foreach (var sub in await Customers.GetSubscriptionsAsync(c.Id))
            {
                if (!string.IsNullOrWhiteSpace(c.TenantId))
                    _subTenant[sub.SubscriptionId] = c.TenantId;
                if (!_subNames.ContainsKey(sub.SubscriptionId) && !string.IsNullOrWhiteSpace(sub.SubscriptionName))
                    _subNames[sub.SubscriptionId] = sub.SubscriptionName;
            }
        }

        await MapHomeSubscriptionsAsync();
    }

    // The home/partner's own subscriptions live in the SubStore registry, not the
    // CustomerSubscription table, so attribute them to the home tenant explicitly — otherwise
    // home subscriptions render without a [tenant] label while customer ones have it, making it
    // look like only one subscription per tenant is labelled.
    private async Task MapHomeSubscriptionsAsync()
    {
        var home = await Customers.GetHomeCustomerAsync();
        var homeTenant = !string.IsNullOrWhiteSpace(home?.TenantId)
            ? home!.TenantId
            : !string.IsNullOrWhiteSpace(Options.MultiTenancy.HomeTenantId)
                ? Options.MultiTenancy.HomeTenantId
                : Options.TenantId;
        if (string.IsNullOrWhiteSpace(homeTenant)) return;

        await TenantNames.GetDisplayNameAsync(homeTenant);
        foreach (var id in SubStore.AllIds)
            if (!_subTenant.ContainsKey(id))
                _subTenant[id] = homeTenant;
    }

    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);

    private static Color UtilColor(decimal pct) =>
        pct >= 80 ? Color.Success : pct >= 50 ? Color.Warning : Color.Error;

    public void Dispose() { }
}
