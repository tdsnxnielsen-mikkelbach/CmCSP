@page "/sustainability"
@inject SustainabilityService Carbon
@inject CostManagementOptions Options
@inject SubscriptionStoreService SubStore
@inject CustomerStore Customers
@inject TenantNameService TenantNames

<PageTitle>Sustainability – CSP Dashboard</PageTitle>

<PageTour />

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudText Typo="Typo.h5" Class="mb-1 fw-bold"
         data-tour="10"
         data-tour-title="Sustainability"
         data-tour-desc="Estimated Azure carbon emissions (kg CO₂e) from the Carbon Optimization API, with month-over-month trend.">Sustainability</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Estimated Azure carbon emissions (kg CO₂e, scopes 1–3) from the Carbon Optimization API.
    Data covers a rolling ~12-month window with roughly a one-month lag.
</MudText>

@if (!_loading && Carbon.LastAccessDenied)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Outlined.Lock">
        This page reads the <strong>Carbon Optimization</strong> emissions API, which requires the app
        identity to have <strong>Reader</strong> (or the dedicated <strong>Carbon Optimization Reader</strong>)
        role on the target subscriptions. Grant it to populate this page.
    </MudAlert>
}

@* ── KPI summary ────────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4"
         data-tour="12"
         data-tour-title="Emissions summary"
         data-tour-desc="Emissions summary &mdash; latest month, previous month, and the month-over-month change.">
    <KpiCard Label="@($"Latest Month ({_latestLabel})")"
             Value="@($"{_latest:N2} kg")" Md="4" />
    <KpiCard Label="Previous Month" Value="@($"{_previous:N2} kg")" Md="4" />
    <KpiCard Label="Month-over-Month"
             Value="@($"{(_momPercent >= 0 ? "+" : "")}{_momPercent:F1}%")"
             ValueColor="@(_momPercent > 0 ? Color.Error : Color.Success)" Md="4" />
</MudGrid>

@* ── Monthly trend ──────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Monthly Emissions Trend (kg CO₂e)</MudText>
    @if (!_loading && _monthly.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense>
            No emissions data was returned. Carbon Optimization data is unavailable for these
            subscriptions, or the app identity lacks emissions access.
        </MudAlert>
    }
    else
    {
        <ApexChart TItem="CarbonEmissionMonth" Options="_lineOpts">
            <ApexPointSeries TItem="CarbonEmissionMonth"
                             Items="_monthly"
                             Name="Emissions"
                             XValue="@(e => e.Month.ToString("MMM yyyy"))"
                             YValue="@(e => (decimal?)Math.Round(e.Emissions, 3))"
                             SeriesType="SeriesType.Line" />
        </ApexChart>
    }
</MudPaper>

@* ── Emissions by resource type ─────────────────────────────────────────────── *@
@if (_byType.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Emissions by Resource Type (latest month)</MudText>
        <ApexChart TItem="CarbonEmissionByType" Options="_barOpts">
            <ApexPointSeries TItem="CarbonEmissionByType"
                             Items="_byType"
                             Name="kg CO₂e"
                             XValue="@(e => ShortType(e.ItemName))"
                             YValue="@(e => (decimal?)Math.Round(e.LatestMonthEmissions, 3))"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </MudPaper>
}
@* ── Emissions by subscription ───────────────────────────────── *@
@if (_bySub.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Emissions by Subscription (latest month)</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            Shows which subscription@(ShowTenant ? " and tenant" : "") each emission total comes from.
        </MudText>
        <ApexChart TItem="CarbonEmissionBySubscription" Options="_subBarOpts">
            <ApexPointSeries TItem="CarbonEmissionBySubscription"
                             Items="_bySub"
                             Name="kg CO₂e"
                             XValue="@(e => SubLabel(e.SubscriptionId))"
                             YValue="@(e => (decimal?)Math.Round(e.LatestMonthEmissions, 3))"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </MudPaper>
}
@code {
    private bool    _loading = true;
    private string? _error;

    private double _latest;
    private double _previous;
    private double _momPercent;
    private string _latestLabel = "—";
    private List<CarbonEmissionMonth>  _monthly = [];
    private List<CarbonEmissionByType> _byType  = [];
    private List<CarbonEmissionBySubscription> _bySub = [];
    private Dictionary<string, string> _subNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _subTenant = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowTenant => Options.MultiTenancy.Enabled;

    private readonly ApexChartOptions<CarbonEmissionMonth>  _lineOpts = ApexChartPresets.SmoothLine<CarbonEmissionMonth>();
    private readonly ApexChartOptions<CarbonEmissionByType> _barOpts  = ApexChartPresets.HorizontalBar<CarbonEmissionByType>();
    private readonly ApexChartOptions<CarbonEmissionBySubscription> _subBarOpts = ApexChartPresets.HorizontalBar<CarbonEmissionBySubscription>();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            var summaryTask = Carbon.GetEmissionSummaryAsync();
            var monthlyTask = Carbon.GetMonthlyEmissionsAsync();
            var byTypeTask  = Carbon.GetEmissionsByTypeAsync();
            var bySubTask   = Carbon.GetEmissionsBySubscriptionAsync();
            var namesTask   = Carbon.GetSubscriptionNamesAsync();

            var summary = await summaryTask;
            _monthly    = await monthlyTask;
            _byType     = await byTypeTask;
            _bySub      = await bySubTask;
            _subNames   = new Dictionary<string, string>(await namesTask, StringComparer.OrdinalIgnoreCase);

            await BuildTenantMapAsync();

            if (summary is not null)
            {
                _latest      = summary.LatestMonthEmissions;
                _previous    = summary.PreviousMonthEmissions;
                _momPercent  = summary.MonthOverMonthChangePercent;
                _latestLabel = summary.LatestMonthLabel;
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load sustainability data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ShortType(string type)
    {
        var slash = type.LastIndexOf('/');
        return slash >= 0 && slash < type.Length - 1 ? type[(slash + 1)..] : type;
    }

    private string SubName(string subscriptionId) =>
        _subNames.TryGetValue(subscriptionId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : subscriptionId;

    private string SubTenant(string subscriptionId) =>
        _subTenant.TryGetValue(subscriptionId, out var tid) ? TenantNames.GetCachedOrId(tid) : string.Empty;

    // Chart label: subscription name, plus its tenant when multi-tenancy is on and known.
    private string SubLabel(string subscriptionId)
    {
        var name = SubName(subscriptionId);
        if (!ShowTenant) return name;
        var tenant = SubTenant(subscriptionId);
        return string.IsNullOrWhiteSpace(tenant) || tenant.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? name
            : $"{name} [{tenant}]";
    }

    // Builds subId -> tenantId from the customer registry and merges missing subscription names.
    private async Task BuildTenantMapAsync()
    {
        if (!Customers.IsEnabled) return;
        foreach (var c in await Customers.GetActiveCustomersAsync())
        {
            if (!string.IsNullOrWhiteSpace(c.TenantId))
                await TenantNames.GetDisplayNameAsync(c.TenantId);

            foreach (var sub in await Customers.GetSubscriptionsAsync(c.Id))
            {
                if (!string.IsNullOrWhiteSpace(c.TenantId))
                    _subTenant[sub.SubscriptionId] = c.TenantId;
                if (!_subNames.ContainsKey(sub.SubscriptionId) && !string.IsNullOrWhiteSpace(sub.SubscriptionName))
                    _subNames[sub.SubscriptionId] = sub.SubscriptionName;
            }
        }

        await MapHomeSubscriptionsAsync();
    }

    // The home/partner's own subscriptions live in the SubStore registry, not the
    // CustomerSubscription table, so attribute them to the home tenant explicitly — otherwise
    // home subscriptions render without a [tenant] label while customer ones have it, making it
    // look like only one subscription per tenant is labelled.
    private async Task MapHomeSubscriptionsAsync()
    {
        var home = await Customers.GetHomeCustomerAsync();
        var homeTenant = !string.IsNullOrWhiteSpace(home?.TenantId)
            ? home!.TenantId
            : !string.IsNullOrWhiteSpace(Options.MultiTenancy.HomeTenantId)
                ? Options.MultiTenancy.HomeTenantId
                : Options.TenantId;
        if (string.IsNullOrWhiteSpace(homeTenant)) return;

        await TenantNames.GetDisplayNameAsync(homeTenant);
        foreach (var id in SubStore.AllIds)
            if (!_subTenant.ContainsKey(id))
                _subTenant[id] = homeTenant;
    }
}
