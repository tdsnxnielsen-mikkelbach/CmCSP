@page "/tags"
@inherits CostPageBase
@inject OptimizationService Optimization

<PageTitle>Tag Chargeback – CSP Dashboard</PageTitle>

<PageTour />

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<RadzenText Class="mb-4 fw-bold" data-tour="10" data-tour-title="Tag Chargeback" data-tour-desc="Cost allocated by resource tags for chargeback / showback, plus live tag-coverage gaps." TextStyle="TextStyle.H5">Tag Chargeback</RadzenText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_withDataSubCount" />

@if (!_loading && !Options.ExportBlob.Enabled)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4" Icon="info"  AllowClose="false">
        Tag Chargeback data is <strong>not available via the Cost Management Query API</strong>.
        Azure does not expose tag-key grouping through the Query API endpoint — tags are only included
        in scheduled <strong>Cost Management Exports</strong> written to blob storage.
        Enable <code>AzureCostManagement:ExportBlob:Enabled = true</code> and deploy the export
        infrastructure (<code>bicep/export-sub.bicep</code>) to populate this page.
    </RadzenAlert>
}

<RadzenRow Class="mb-4" data-tour="12" data-tour-title="Tag coverage" data-tour-desc="Tagged vs untagged cost and the number of distinct tag keys in use." Gap="1rem">
    <KpiCard Label="Total Tagged Cost" Value="@Fmt(_taggedCost)" Md="4" />
    <KpiCard Label="Untagged Cost" Value="@Fmt(_untaggedCost)" ValueColor="BadgeStyle.Warning" Md="4" />
    <KpiCard Label="Distinct Tag Keys" Value="@_tagData.Count.ToString()" Md="4" />
</RadzenRow>

@if (!_loading && Optimization.LastAccessDenied)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4" Icon="lock"  AllowClose="false">
        Live resource inventory is unavailable because the app identity is missing the
        <strong>Reader</strong> role on the target subscriptions. Grant Reader to see real tag
        coverage alongside cost data.
    </RadzenAlert>
}
else if (!_loading && _tagCoverage is { } cov && cov.TotalResources > 0)
{
    <RadzenCard Class="pa-4 mb-4">
        <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Live Resource Inventory — Tag Coverage</RadzenText>
        <RadzenRow Class="mb-3" Gap="1rem">
            <KpiCard Label="Resources" Value="@cov.TotalResources.ToString("N0")" Md="4" />
            <KpiCard Label="Untagged Resources" Value="@cov.UntaggedResources.ToString("N0")"
                     ValueColor="BadgeStyle.Warning" Md="4" />
            <KpiCard Label="Tagged %" Value="@($"{cov.TaggedPercent:F1}%")"
                     ValueColor="@(cov.TaggedPercent >= 80 ? BadgeStyle.Success : BadgeStyle.Warning)" Md="4" />
        </RadzenRow>
        <RadzenDataGrid TItem="KeyValuePair<string, int>" Data="_tagKeyCounts" AllowSorting="true" AllowMultiColumnSorting="false" AllowFiltering="false" FilterMode="Radzen.FilterMode.Simple" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn Property="Key" Title="Tag Key" TItem="KeyValuePair<string, int>" />
                <RadzenDataGridColumn Property="Value" Title="Resources With This Tag" TItem="KeyValuePair<string, int>" FormatString="{0:N0}" />
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

<RadzenCard Class="pa-4 mb-4">
    <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Subscription Coverage</RadzenText>
    <RadzenDataGrid TItem="SubCoverage" Data="_subCoverage" AllowSorting="true" AllowMultiColumnSorting="false" AllowFiltering="false" FilterMode="Radzen.FilterMode.Simple" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
        <Columns>
            <RadzenDataGridColumn Property="SubscriptionName" Title="Subscription" TItem="SubCoverage" />
            @if (ShowTenantColumn)
            {
                <RadzenDataGridColumn Property="Tenant" Title="Tenant" TItem="SubCoverage" />
            }
            <RadzenDataGridColumn Property="SubscriptionId" Title="Subscription ID" TItem="SubCoverage" />
            <RadzenDataGridColumn Property="TotalCost" Title="Total Cost" TItem="SubCoverage" FormatString="{0:N0}" />
            <RadzenDataGridColumn Property="TaggedCost" Title="Tagged Cost" TItem="SubCoverage" FormatString="{0:N0}" />
            <RadzenDataGridColumn Property="UntaggedCost" Title="Untagged Cost" TItem="SubCoverage" FormatString="{0:N0}" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

<RadzenRow Gap="1rem">
    @* Cost distribution – horizontal bar instead of treemap (treemap not in SeriesType) *@
    <RadzenColumn Size="12" SizeMD="8">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Cost Distribution by Tag</RadzenText>
            <ApexChart TItem="TagSeriesPoint" Options="_treemapOpts" @key="ChartKey">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="TagSeriesPoint"
                                     Items="_tagSeriesData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.Tag)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </RadzenCard>
    </RadzenColumn>

    @* Horizontal bar – top tags ranked *@
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Tag Cost Ranked</RadzenText>
            <ApexChart TItem="TagSeriesPoint" Options="_hbarOpts" @key="ChartKey">
                @foreach (var subId in _seriesSubIds)
                {
                    var capturedSubId = subId;
                    <ApexPointSeries TItem="TagSeriesPoint"
                                     Items="_tagSeriesData.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                     Name="@SubChartLabel(capturedSubId)"
                                     XValue="@(e => e.Tag)"
                                     YValue="@(e => (decimal?)e.Cost)"
                                     SeriesType="SeriesType.Bar" />
                }
            </ApexChart>
        </RadzenCard>
    </RadzenColumn>

    @* Table *@
    <RadzenColumn Size="12">
        <RadzenCard Class="pa-4">
            <RadzenText Class="mb-3 fw-bold" TextStyle="TextStyle.Subtitle1">Tag Reference Table</RadzenText>
            <RadzenDataGrid FilterMode="Radzen.FilterMode.Simple" TItem="TagPoint" Data="_tagData" AllowSorting="true" AllowMultiColumnSorting="false" AllowFiltering="true" Density="Density.Compact" AllowPaging="true" PageSize="25" PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" ShowPagingSummary="true">
                <Columns>
                    <RadzenDataGridColumn Property="Tag" Title="Tag Key" TItem="TagPoint" />
                    <RadzenDataGridColumn Property="Cost" Title="Total Cost" TItem="TagPoint" FormatString="{0:N0}" />
                    <RadzenDataGridColumn Title="Share %" TItem="TagPoint" Sortable="false" Filterable="false">
                        <Template Context="context">
                            @context.SharePct.ToString("F1")%
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private record TagPoint(string Tag, decimal Cost, decimal SharePct);
    private record TagSeriesPoint(string Tag, string SubscriptionId, decimal Cost);
    private record SubCoverage(string SubscriptionId, string SubscriptionName, string Tenant, decimal TotalCost, decimal TaggedCost, decimal UntaggedCost);

    private decimal _taggedCost;
    private decimal _untaggedCost;
    private InventoryTagCoverage? _tagCoverage;
    private List<KeyValuePair<string, int>> _tagKeyCounts = [];
    private List<TagPoint> _tagData = [];
    private List<TagSeriesPoint> _tagSeriesData = [];
    private List<SubCoverage> _subCoverage = [];
    private List<string> _seriesSubIds = [];

    private readonly ApexChartOptions<TagSeriesPoint> _treemapOpts = ApexChartPresets.VerticalBar<TagSeriesPoint>();

    private readonly ApexChartOptions<TagSeriesPoint> _hbarOpts = ApexChartPresets.HorizontalBar<TagSeriesPoint>();

    protected override async Task LoadAsync()
    {
        await RunLoadAsync(async () =>
        {
            var dataTask = CostService.GetTagCostDataAsync();
            var nameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var coverageTask = Optimization.GetTagCoverageAsync();
            var data  = ApplySubFilter(await dataTask);
            _subNames = await nameTask;
            await IndexSubscriptionData(data);
            _tagCoverage = await coverageTask;
            _tagKeyCounts = _tagCoverage.ResourcesPerTagKey
                .OrderByDescending(kv => kv.Value)
                .ToList();
            var start = RangeStart;
            var end   = RangeEnd;

            var filtered = data.Where(r => r.Date >= start && r.Date <= end).ToList();
            var total    = filtered.Sum(r => r.NormalizedCost);

            var tagged   = filtered.Where(r => !string.IsNullOrWhiteSpace(r.Tag)).ToList();
            var untagged = filtered.Where(r => string.IsNullOrWhiteSpace(r.Tag)).ToList();

            _taggedCost   = tagged.Sum(r => r.NormalizedCost);
            _untaggedCost = untagged.Sum(r => r.NormalizedCost);

            _tagData = tagged
                .GroupBy(r => r.Tag)
                .Select(g =>
                {
                    var cost = g.Sum(r => r.NormalizedCost);
                    return new TagPoint(g.Key, cost, total > 0 ? cost / total * 100m : 0m);
                })
                .OrderByDescending(t => t.Cost)
                .ToList();

            _seriesSubIds = GetOrderedSubscriptionIds();

            var topTags = _tagData.Select(t => t.Tag).ToList();
            var tagBySub = tagged
                .GroupBy(r => new { r.Tag, r.SubscriptionId })
                .ToDictionary(g => (Tag: g.Key.Tag, SubId: g.Key.SubscriptionId), g => g.Sum(r => r.NormalizedCost));

            _tagSeriesData = _seriesSubIds
                .SelectMany(subId => topTags.Select(tag => new TagSeriesPoint(
                    tag,
                    subId,
                    tagBySub.TryGetValue((tag, subId), out var cost) ? cost : 0m)))
                .ToList();

            // Span every subscription in scope (home + customers) that is selected, unioned with
            // any subscription actually present in the data — so a partner sees customer
            // subscriptions here, not just the home registry.
            var coverageSubIds = filtered.Select(r => r.SubscriptionId)
                .Concat(GetOrderedSubscriptionIds())
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct(StringComparer.OrdinalIgnoreCase);

            _subCoverage = coverageSubIds
                .Select(id =>
                {
                    var rows = filtered.Where(r => r.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase)).ToList();
                    var subTotal = rows.Sum(r => r.NormalizedCost);
                    var subTagged = rows.Where(r => !string.IsNullOrWhiteSpace(r.Tag)).Sum(r => r.NormalizedCost);
                    var subUntagged = rows.Where(r => string.IsNullOrWhiteSpace(r.Tag)).Sum(r => r.NormalizedCost);
                    var name = GetSubName(id);
                    return new SubCoverage(id, name, SubTenantName(id), subTotal, subTagged, subUntagged);
                })
                .OrderByDescending(s => s.TotalCost)
                .ToList();

            _withDataSubCount = _subCoverage.Count(s => s.TotalCost > 0);
        });
    }
}

