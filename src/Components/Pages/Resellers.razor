@page "/resellers"
@using CmCSP.Models
@inject IonEnrichmentService Ion
@inject IonGatewayService Gateway
@inject CostManagementOptions Options
@inject ITenantScopeProvider ScopeProvider
@inject NavigationManager Nav

<PageTitle>Resellers – CSP Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 fw-bold">Resellers</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Indirect resellers sourced from TD SYNNEX StreamOne (Ion) and Microsoft Partner Center.
    Expand an Ion account to see its customers' crawled orders with line-level
    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Ion</MudChip>
    transacted price, cost and margin.
</MudText>

@if (!_ready)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
}
else if (!Ion.IsConfigured)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
        The Ion Gateway / Partner Center integration is not configured. Set
        <code>IonGateway:ApiKey</code> (and optionally <code>PartnerCenter:ApiKey</code>) via user-secrets
        or Key Vault to enable reseller and margin data.
    </MudAlert>
}
else
{
    <div class="d-flex flex-wrap gap-3 align-center mb-4">
        <MudTextField @bind-Value="_search"
                      Label="Search resellers"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Style="min-width:280px"
                      Immediate="true"
                      OnKeyUp="@(e => { if (e.Key == "Enter") return LoadAsync(); return Task.CompletedTask; })" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search" Disabled="_busy" OnClick="LoadAsync">
            Search
        </MudButton>
    </div>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Reseller directory (@_resellers.Count)</MudText>
        @if (_resellers.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No resellers found.</MudText>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                @foreach (var r in _resellers)
                {
                    <MudExpansionPanel @key="@($"{r.Name}-{r.IonAccountId}")"
                                       Expanded="false"
                                       ExpandedChanged="@(expanded => OnExpandAsync(r, expanded))">
                        <TitleContent>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.body1" Class="fw-bold">@r.Name</MudText>
                                @if (r.Source.Contains("ion"))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Ion</MudChip>
                                }
                                @if (r.Source.Contains("pct"))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">Partner Center</MudChip>
                                }
                                @if (r.DelegatedAdminEnabled)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Delegated admin</MudChip>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div class="d-flex flex-wrap gap-4 mb-3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Ion account: <b>@(r.IonAccountId?.ToString() ?? "—")</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    MPN: <b>@(r.MpnId ?? "—")</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Contact: <b>@(r.PrimaryContactEmail ?? "—")</b>
                                </MudText>
                            </div>

                            @if (r.IonAccountId is null)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Outlined.Info">
                                    This reseller is only known to Partner Center — order pricing requires a matched
                                    Ion account.
                                </MudAlert>
                            }
                            else if (_ordersLoading.Contains(r.IonAccountId.Value))
                            {
                                <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-2" />
                            }
                            else if (_orders.TryGetValue(r.IonAccountId.Value, out var orders))
                            {
                                @if (orders.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        No crawled orders yet for this account.
                                    </MudText>
                                }
                                else
                                {
                                    var lineCount = orders.Sum(o => o.Lines?.Count ?? 0);
                                    var totalMargin = orders.Sum(o => o.Margin ?? 0m);
                                    <div class="d-flex flex-wrap gap-4 mb-2">
                                        <MudText Typo="Typo.body2"><b>@orders.Count</b> orders</MudText>
                                        <MudText Typo="Typo.body2"><b>@lineCount</b> lines</MudText>
                                        <MudText Typo="Typo.body2">
                                            Total Ion margin: <b>@totalMargin.ToString("N2")</b>
                                            @(orders.FirstOrDefault()?.CurrencyCode)
                                        </MudText>
                                    </div>
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="overflow-x:auto">
                                        <thead>
                                            <tr>
                                                <th>Customer</th>
                                                <th>Mfg part number</th>
                                                <th style="text-align:right">Qty</th>
                                                <th style="text-align:right">Ion price</th>
                                                <th style="text-align:right">Ion cost</th>
                                                <th style="text-align:right">Ion margin</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var o in orders)
                                            {
                                                @foreach (var l in o.Lines ?? [])
                                                {
                                                    <tr @key="@($"{o.OrderId}-{l.MfgPartNumber}-{l.SkuId}")">
                                                        <td>@(o.CustomerName ?? o.CustomerId?.ToString() ?? "—")</td>
                                                        <td><code>@(l.MfgPartNumber ?? "—")</code></td>
                                                        <td style="text-align:right">@(l.Quantity?.ToString() ?? "—")</td>
                                                        <td style="text-align:right">@Money(l.Price)</td>
                                                        <td style="text-align:right">@Money(l.Cost)</td>
                                                        <td style="text-align:right">@Money(l.Margin)</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudPaper>
}

@code {
    private bool _ready;
    private bool _busy;
    private string _search = string.Empty;

    private List<IonResellerSummary> _resellers = [];
    private readonly Dictionary<long, List<IonOrder>> _orders = new();
    private readonly HashSet<long> _ordersLoading = [];

    protected override async Task OnInitializedAsync()
    {
        // Reseller/margin data is a partner-level (portfolio) view. Customer users are redirected.
        if (Options.MultiTenancy.Enabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            if (!scope.IsPartner)
            {
                Nav.NavigateTo("/", forceLoad: false, replace: true);
                return;
            }
        }

        if (Ion.IsConfigured)
            await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _resellers = await Ion.GetResellerDirectoryAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnExpandAsync(IonResellerSummary r, bool expanded)
    {
        if (!expanded || r.IonAccountId is null) return;
        var id = r.IonAccountId.Value;
        if (_orders.ContainsKey(id) || _ordersLoading.Contains(id)) return;

        _ordersLoading.Add(id);
        try
        {
            _orders[id] = await Gateway.GetResellerOrdersAsync(id);
        }
        finally
        {
            _ordersLoading.Remove(id);
            StateHasChanged();
        }
    }

    private static string Money(decimal? v) => v?.ToString("N2") ?? "—";
}
