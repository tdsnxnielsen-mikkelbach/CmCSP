@page "/budgets"
@inherits CostPageBase

<PageTitle>Budgets – CSP Dashboard</PageTitle>

<PageTour />

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<MudText Typo="Typo.h5" Class="mb-4 fw-bold"
         data-tour="10"
         data-tour-title="Budgets"
         data-tour-desc="Track Azure Cost Management budgets &mdash; spend vs limit, variance, and burn-down per subscription.">Budgets</MudText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_withDataSubCount" />

@if (!_loading && _budgets.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No subscription-scope budgets found. Create a budget in Azure Portal
        (<strong>Cost Management &rarr; Budgets</strong>) on one or more subscriptions
        to see budget tracking here.
    </MudAlert>
}
else if (_budgets.Count > 0)
{
    @* ── KPI cards ─────────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 h-100 budgets-kpi-card" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Budget</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold budgets-kpi-value">@Fmt(_totalBudget)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="budgets-kpi-footer">@_budgets.Count budget(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 h-100 budgets-kpi-card" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Current Period Spend</MudText>
                <MudText Typo="Typo.h5" Class="mt-1 fw-bold budgets-kpi-value">@Fmt(_totalCurrentSpend)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Transparent" Class="budgets-kpi-footer">@("\u00A0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 h-100 budgets-kpi-card" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Budget Variance</MudText>
                <MudText Typo="Typo.h5"
                         Class="mt-1 fw-bold budgets-kpi-value"
                         Color="@(_variance > 0 ? Color.Error : Color.Success)">
                    @Fmt(_variance)
                </MudText>
                <MudText Typo="Typo.caption" Color="@(_variance > 0 ? Color.Error : Color.Success)" Class="budgets-kpi-footer">
                    @(_variance > 0 ? "over budget" : "under budget")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 h-100 budgets-kpi-card" Elevation="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Budget Variance %</MudText>
                <MudText Typo="Typo.h5"
                         Class="mt-1 fw-bold budgets-kpi-value"
                         Color="@(_variancePct > 0 ? Color.Error : Color.Success)">
                    @_variancePct.ToString("F1")%
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Transparent" Class="budgets-kpi-footer">@("\u00A0")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Gauge + per-subscription bar ──────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Spend vs Budget (Current Period)</MudText>
                <ApexChart TItem="GaugePoint" Options="_gaugeOpts">
                    <ApexPointSeries TItem="GaugePoint"
                                     Items="_gaugeData"
                                     Name="Budget usage"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Pct)"
                                     SeriesType="SeriesType.RadialBar" />
                </ApexChart>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-2">
                    @Fmt(_totalCurrentSpend) of @Fmt(_totalBudget)
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Budget vs Current Spend by Subscription</MudText>
                <ApexChart TItem="SubBudgetPoint" Options="_subBarOpts">
                    <ApexPointSeries TItem="SubBudgetPoint"
                                     Items="_subBudgetData"
                                     Name="Budget"
                                     XValue="@(e => e.SubName)"
                                     YValue="@(e => (decimal?)e.Budget)"
                                     SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="SubBudgetPoint"
                                     Items="_subBudgetData"
                                     Name="Current Spend"
                                     XValue="@(e => e.SubName)"
                                     YValue="@(e => (decimal?)e.Spend)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Monthly spend vs total budget ──────────────────────────────────────── *@
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Monthly Spend vs Total Budget (Last 6 Months)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Actual spend is stacked by subscription@(ShowTenantColumn ? " and tenant" : "") against the total budget line.
                </MudText>
                <ApexChart TItem="MonthBudgetPoint" Options="_groupedBarOpts">
                    @foreach (var subId in _monthlySubIds)
                    {
                        var capturedSubId = subId;
                        <ApexPointSeries TItem="MonthBudgetPoint"
                                         Items="_monthlySpend.Where(p => p.SubscriptionId.Equals(capturedSubId, StringComparison.OrdinalIgnoreCase)).ToList()"
                                         Name="@SubChartLabel(capturedSubId)"
                                         XValue="@(e => e.Label)"
                                         YValue="@(e => (decimal?)e.Actual)"
                                         SeriesType="SeriesType.Bar" />
                    }
                    <ApexPointSeries TItem="MonthBudgetPoint"
                                     Items="_monthlyBudgetLine"
                                     Name="Total Budget"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => (decimal?)e.Budget)"
                                     SeriesType="SeriesType.Line" />
                </ApexChart>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Budget Details by Subscription</MudText>
                <MudDataGrid T="BudgetRow"
                             Items="_budgetRows"
                             Dense
                             SortMode="SortMode.Single"
                             Filterable
                             FilterMode="DataGridFilterMode.ColumnFilterRow">
                    <Columns>
                        <PropertyColumn Property="r => r.SubscriptionName" Title="Subscription" />
                        @if (ShowTenantColumn)
                        {
                            <PropertyColumn Property="r => r.Tenant" Title="Tenant" />
                        }
                        <PropertyColumn Property="r => r.SubscriptionId" Title="Subscription ID" />
                        <PropertyColumn Property="r => r.BudgetName" Title="Budget" />
                        <PropertyColumn Property="r => r.Amount" Title="Budget Amount" Format="N0" />
                        <PropertyColumn Property="r => r.CurrentSpend" Title="Current Spend" Format="N0" />
                        <TemplateColumn Title="Usage %">
                            <CellTemplate>
                                @context.Item.UsagePct.ToString("F1")%
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private record GaugePoint(string Label, decimal Pct);
    private record MonthBudgetPoint(string Label, string SubscriptionId, decimal Actual, decimal Budget);
    private record SubBudgetPoint(string SubName, decimal Budget, decimal Spend);
    private record BudgetRow(
        string SubscriptionId,
        string SubscriptionName,
        string Tenant,
        string BudgetName,
        decimal Amount,
        decimal CurrentSpend,
        decimal UsagePct);

    private List<SubscriptionBudget> _budgets = [];
    private decimal _totalBudget;
    private decimal _totalCurrentSpend;
    private decimal _variance;
    private decimal _variancePct;

    private List<GaugePoint>      _gaugeData     = [];
    private List<SubBudgetPoint>  _subBudgetData = [];
    private List<MonthBudgetPoint> _monthlySpend = [];
    private List<MonthBudgetPoint> _monthlyBudgetLine = [];
    private List<string>          _monthlySubIds = [];
    private List<BudgetRow> _budgetRows = [];

    private readonly ApexChartOptions<GaugePoint> _gaugeOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions
        {
            RadialBar = new PlotOptionsRadialBar
            {
                StartAngle = -135,
                EndAngle   = 135,
                Hollow     = new Hollow { Size = "55%" },
                DataLabels = new RadialBarDataLabels
                {
                    Name  = new RadialBarDataLabelsName  { Show = true },
                    Value = new RadialBarDataLabelsValue { Show = true, FontSize = "22px", Formatter = "function(val) { return val != null ? parseFloat(val).toFixed(2) + '%' : ''; }" }
                }
            }
        }
    };

    private readonly ApexChartOptions<SubBudgetPoint> _subBarOpts = ApexChartPresets.VerticalBar<SubBudgetPoint>();

    private readonly ApexChartOptions<MonthBudgetPoint> _groupedBarOpts = ApexChartPresets.StackedBar<MonthBudgetPoint>();

    protected override async Task LoadAsync()
    {
        await RunLoadAsync(async () =>
        {
            // Start both requests concurrently – both are likely cache hits after first load.
            var costTask   = CostService.GetMainCostDataAsync();
            var budgetTask = CostService.GetSubscriptionBudgetsAsync();
            var subNameTask = CostService.GetSubscriptionDisplayNamesAsync();
            var costData   = ApplySubFilter(await costTask);
            var budgets    = await budgetTask;
            var apiSubNames = await subNameTask;
            _subNames = new Dictionary<string, string>(apiSubNames, StringComparer.OrdinalIgnoreCase);
            await IndexSubscriptionData(costData);

            // Compute month-to-date spend per subscription from cost data.
            // The Consumption Budgets API's currentSpend is unreliable for CSP
            // cross-tenant subscriptions and frequently returns null / 0.
            // Anchor "today" to the most recent date present in the data rather than the wall
            // clock. Azure cost data lags by 1-3 days and a brand-new calendar month often has
            // no rows yet, which would otherwise make month-to-date spend read 0. Fall back to
            // UtcNow only when there is no data at all.
            var today = costData.Count > 0 ? costData.Max(r => r.Date) : DateTime.UtcNow;
            var mtdBySub = costData
                .Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                .GroupBy(r => r.SubscriptionId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Sum(r => r.NormalizedCost),
                              StringComparer.OrdinalIgnoreCase);

            _budgets     = budgets;
            _totalBudget = budgets.Sum(b => b.Amount);
            // Sum MTD spend for each unique subscription; fall back to the API's
            // currentSpend only when cost data is absent for that subscription.
            _totalCurrentSpend = budgets
                .GroupBy(b => b.SubscriptionId, StringComparer.OrdinalIgnoreCase)
                .Sum(g => mtdBySub.TryGetValue(g.Key, out var mtd) ? mtd : g.Sum(b => b.CurrentSpend));
            _variance    = _totalCurrentSpend - _totalBudget;
            _variancePct = _totalBudget > 0 ? _variance / _totalBudget * 100m : 0m;

            var spendPct = _totalBudget > 0
                ? Math.Min((double)(_totalCurrentSpend / _totalBudget * 100m), 200d)
                : 0d;
            _gaugeData = [new GaugePoint("Budget", (decimal)spendPct)];

            // Per-subscription: aggregate in case a subscription has multiple budgets. Span every
            // subscription in scope (not just those with a budget) so a partner sees all of them.
            var budgetBySub = budgets
                .GroupBy(b => b.SubscriptionId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Sum(b => b.Amount), StringComparer.OrdinalIgnoreCase);
            var scopeSubIds = GetOrderedSubscriptionIds();
            _subBudgetData = scopeSubIds
                .Select(id =>
                {
                    var budget = budgetBySub.TryGetValue(id, out var amt) ? amt : 0m;
                    var spend  = mtdBySub.TryGetValue(id, out var mtd) ? mtd
                                 : budgets.Where(b => b.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase))
                                          .Sum(b => b.CurrentSpend);
                    return new SubBudgetPoint(SubChartLabel(id), budget, spend);
                })
                .Where(p => p.Budget > 0 || p.Spend > 0)
                .OrderByDescending(p => p.Budget)
                .ToList();

            // One detail row per subscription in scope (a subscription may have 0..n budgets).
            _budgetRows = scopeSubIds
                .Select(id =>
                {
                    var subBudgets = budgets
                        .Where(b => b.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    var amount = subBudgets.Sum(b => b.Amount);
                    var spend  = mtdBySub.TryGetValue(id, out var mtd) ? mtd : subBudgets.Sum(b => b.CurrentSpend);
                    var usage  = amount > 0 ? spend / amount * 100m : 0m;
                    var budgetName = subBudgets.Count switch
                    {
                        0 => "—",
                        1 => subBudgets[0].BudgetName,
                        _ => $"{subBudgets.Count} budgets"
                    };
                    return new BudgetRow(
                        id,
                        GetSubName(id),
                        SubTenantName(id),
                        budgetName,
                        amount,
                        spend,
                        usage);
                })
                .OrderByDescending(r => r.CurrentSpend)
                .ToList();

            _withDataSubCount = _budgetRows
                .Where(r => r.CurrentSpend > 0 || r.Amount > 0)
                .Select(r => r.SubscriptionId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

            // Historical monthly spend stacked by subscription, plus a total-budget line.
            _monthlySubIds = scopeSubIds;
            var months = costData
                .Select(r => new DateTime(r.Date.Year, r.Date.Month, 1))
                .Distinct()
                .OrderBy(d => d)
                .TakeLast(6)
                .ToList();
            _monthlySpend = months
                .SelectMany(m => scopeSubIds.Select(id =>
                {
                    var actual = costData
                        .Where(r => r.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase)
                                 && r.Date.Year == m.Year && r.Date.Month == m.Month)
                        .Sum(r => r.NormalizedCost);
                    return new MonthBudgetPoint(m.ToString("MMM yy"), id, Math.Round(actual, 2), _totalBudget);
                }))
                .ToList();
            _monthlyBudgetLine = months
                .Select(m => new MonthBudgetPoint(m.ToString("MMM yy"), string.Empty, 0m, _totalBudget))
                .ToList();
        });
    }
}

