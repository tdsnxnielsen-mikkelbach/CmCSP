@page "/subscriptions"
@inject ICostDetailsService CostDetails
@inherits CostPageBase

<PageTitle>Subscription Breakdown – CSP Dashboard</PageTitle>

<PageTour />

<LoadingErrorDisplay Loading="@_loading" Error="@_error" />

<MudText Typo="Typo.h5" Class="mb-4 fw-bold"
         data-tour="10"
         data-tour-title="Subscription Breakdown"
         data-tour-desc="Cost by subscription &mdash; totals, share of spend, and a per-subscription detail table.">Subscription Breakdown</MudText>
<SubscriptionScopeBadge SelectedCount="_selectedSubCount" WithDataCount="_withDataSubCount" />

@* ── Summary card *@
<MudGrid Spacing="3" Class="mb-4"
         data-tour="12"
         data-tour-title="Totals"
         data-tour-desc="Totals, subscription count, and the largest subscription's share of spend.">
    <KpiCard Label="Total Cost" Value="@Fmt(_totalCost)" Sm="4" Md="4" />
    <KpiCard Label="Subscriptions" Value="@_rows.Count.ToString()" Sm="4" Md="4" />
    <KpiCard Label="Largest Subscription Share" Value="@($"{_topShare:F1}%")" Sm="4" Md="4" />
</MudGrid>

<MudGrid Spacing="3">
    @* Bar chart – cost by subscription *@
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Cost by Subscription</MudText>
            <ApexChart TItem="SubPoint" Options="_hbarOpts" @key="ChartKey">
                <ApexPointSeries TItem="SubPoint"
                                 Items="_barData"
                                 Name="Total Cost"
                                 XValue="@(e => e.SubName)"
                                 YValue="@(e => (decimal?)e.Cost)"
                                 SeriesType="SeriesType.Bar" />
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Donut – share by subscription *@
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Cost Share</MudText>
            <ApexChart TItem="SubPoint" Options="_donutOpts" @key="ChartKey">
                <ApexPointSeries TItem="SubPoint"
                                 Items="_barData"
                                 Name="Share"
                                 XValue="@(e => e.SubName)"
                                 YValue="@(e => (decimal?)e.Cost)"
                                 SeriesType="SeriesType.Donut" />
            </ApexChart>
        </MudPaper>
    </MudItem>

    @* Reference table *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">Subscription Reference</MudText>
                <MudTooltip Text="Amortized Cost spreads reservation purchases evenly over the term. 
RI Savings = ActualCost − AmortizedCost (positive = reservation benefit). 
Values only available when CostDetails:Enabled = true." Arrow>
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                </MudTooltip>
            </MudStack>
            <MudDataGrid T="TableRow"
                         Items="_rows"
                         SortMode="SortMode.Multiple"
                         Filterable
                         FilterMode="DataGridFilterMode.ColumnFilterRow"
                         Dense>
                <Columns>
                    <PropertyColumn Property="r => r.SubId"    Title="Subscription ID" />
                    <PropertyColumn Property="r => r.SubName"  Title="Name" />
                    @if (ShowTenantColumn)
                    {
                        <PropertyColumn Property="r => r.Tenant" Title="Tenant" />
                    }
                    <PropertyColumn Property="r => r.TotalCost" Title="Actual Cost"
                                    Format="N0" />
                    <PropertyColumn Property="r => r.MtdCost"  Title="MTD (Actual)"
                                    Format="N0" />
                    <PropertyColumn Property="r => r.AmortizedCost" Title="Amortized Cost"
                                    Format="N0" />
                    <TemplateColumn Title="RI Savings">
                        <CellTemplate>
                            @if (context.Item.AmortizedCost > 0)
                            {
                                var savings = context.Item.TotalCost - context.Item.AmortizedCost;
                                <MudText Color="@(savings > 0 ? Color.Error : Color.Success)">
                                    @savings.ToString("N0")
                                </MudText>
                            }
                            else
                            {
                                <MudText Color="Color.Default">—</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Share %">
                        <CellTemplate>
                            @context.Item.SharePct.ToString("F1")%
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record SubPoint(string SubName, decimal Cost);
    private record TableRow(string SubId, string SubName, decimal TotalCost, decimal MtdCost,
                            decimal AmortizedCost, decimal SharePct, string Tenant);

    private decimal _totalCost;
    private decimal _topShare;
    private List<SubPoint> _barData = [];
    private List<TableRow> _rows = [];

    private readonly ApexChartOptions<SubPoint> _hbarOpts = ApexChartPresets.HorizontalBar<SubPoint>();

    private readonly ApexChartOptions<SubPoint> _donutOpts = ApexChartPresets.Donut<SubPoint>();

    protected override async Task LoadAsync()
    {
        await RunLoadAsync(async () =>
        {
            var dataTask  = CostService.GetMainCostDataAsync();
            var nameTask  = CostService.GetSubscriptionDisplayNamesAsync();
            var amortTask = Options.CostDetails.Enabled
                ? CostService.GetAmortizedMainCostDataAsync()
                : Task.FromResult(new List<CostRow>());
            var rawData  = await dataTask;
            _subNames = await nameTask;
            // Apply the partner's subscription view-filter before any aggregation.
            var data      = ApplySubFilter(rawData);
            var amortData = ApplySubFilter(await amortTask);
            await IndexSubscriptionData(data);
            var start = RangeStart;
            var end   = RangeEnd;
            // Anchor "today" to the most recent date present in the data rather than the wall
            // clock. Azure cost data lags by 1-3 days and a brand-new calendar month often has
            // no rows yet, which would otherwise make month-to-date columns read 0. Fall back
            // to UtcNow only when there is no data at all.
            var today = data.Count > 0 ? data.Max(r => r.Date) : DateTime.UtcNow;

            var filtered = data.Where(r => r.Date >= start && r.Date <= end).ToList();

            _totalCost = filtered.Sum(r => r.NormalizedCost);

            // Attribute each subscription to the tenant that owns it (from the tagged rows).
            var subTenant = data
                .Where(r => !string.IsNullOrWhiteSpace(r.SubscriptionId))
                .GroupBy(r => r.SubscriptionId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => g.Select(r => r.TenantId).FirstOrDefault(t => !string.IsNullOrWhiteSpace(t)) ?? string.Empty,
                    StringComparer.OrdinalIgnoreCase);

            var bySub = filtered
                .GroupBy(r => new { r.SubscriptionId, r.SubscriptionName })
                .Select(g => new
                {
                    g.Key.SubscriptionId,
                    g.Key.SubscriptionName,
                    Total = g.Sum(r => r.NormalizedCost),
                    Mtd   = g.Where(r => r.Date.Year == today.Year && r.Date.Month == today.Month)
                             .Sum(r => r.NormalizedCost)
                })
                .OrderByDescending(x => x.Total)
                .ToList();

            // The universe of subscriptions = those present in the data (across every in-scope
            // tenant) unioned with every subscription in scope (home registry + each in-scope
            // customer's mapped subscriptions), narrowed by the active view-filter. Using the
            // scope set (not just SubStore.AllIds) guarantees a partner sees every customer
            // subscription here even when a sub currently has no cost rows.
            var sel = State.SelectedSubscriptionIds;
            var universe = data.Select(r => r.SubscriptionId)
                .Concat(_scopeSubIds)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Where(id => sel.Count == 0 || sel.Contains(id))
                .ToList();

            var merged = universe
                .Select(id =>
                {
                    var existing = bySub.FirstOrDefault(x =>
                        x.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase));
                    var resolvedName = _subNames.TryGetValue(id, out var n) ? n : id;
                    var amortTotal = amortData
                        .Where(r => r.SubscriptionId.Equals(id, StringComparison.OrdinalIgnoreCase)
                                 && r.Date >= start && r.Date <= end)
                        .Sum(r => r.NormalizedCost);
                    return new
                    {
                        SubscriptionId = id,
                        SubscriptionName = !string.IsNullOrWhiteSpace(existing?.SubscriptionName)
                            ? existing.SubscriptionName
                            : resolvedName,
                        Total = existing?.Total ?? 0m,
                        Mtd = existing?.Mtd ?? 0m,
                        Amortized = amortTotal,
                        // Prefer the tenant from the rows; fall back to the scope map (covers subs
                        // with no cost rows yet) so every subscription is tenant-attributed.
                        Tenant = subTenant.TryGetValue(id, out var t) && !string.IsNullOrWhiteSpace(t)
                            ? t
                            : (_subTenantMap.TryGetValue(id, out var mt) ? mt : string.Empty)
                    };
                })
                .OrderByDescending(x => x.Total)
                .ToList();

            _barData = merged
                .Select(x => new SubPoint(SubChartLabel(x.SubscriptionId), x.Total))
                .ToList();

            _rows = merged
                .Select(x => new TableRow(
                    x.SubscriptionId,
                    string.IsNullOrWhiteSpace(x.SubscriptionName) ? x.SubscriptionId : x.SubscriptionName,
                    x.Total,
                    x.Mtd,
                    x.Amortized,
                    _totalCost > 0 ? x.Total / _totalCost * 100m : 0m,
                    TenantNames.GetCachedOrId(x.Tenant)))
                .ToList();

            _withDataSubCount = _rows
                .Where(r => r.TotalCost > 0)
                .Select(r => r.SubId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();

            _topShare = _rows.Count > 0 ? _rows.Max(r => r.SharePct) : 0m;
        });
    }
}

