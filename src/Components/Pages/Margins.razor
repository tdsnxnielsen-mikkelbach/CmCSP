@page "/margins"
@using CmCSP.Models
@inject IonEnrichmentService Ion
@inject CostManagementOptions Options
@inject CustomerStore Store
@inject ITenantScopeProvider ScopeProvider
@inject NavigationManager Nav

<PageTitle>Margins – CSP Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 fw-bold">Customer margins</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Per-customer commercial view fusing the
    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">native</MudChip>
    Microsoft list price (Partner Center) with
    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Ion</MudChip>
    transacted cost and margin (TD SYNNEX StreamOne). Ion pricing is reseller-level and
    SKU-approximate — each line shows how it was matched.
</MudText>

@if (!_ready)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
}
else if (!Ion.IsConfigured)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
        The Ion Gateway integration is not configured. Set <code>IonGateway:ApiKey</code> via
        user-secrets or Key Vault to enable margin data.
    </MudAlert>
}
else if (!Store.IsEnabled)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Outlined.Storage">
        The SQL customer registry is required to resolve the customer portfolio but is not configured.
    </MudAlert>
}
else
{
    @* ── Portfolio KPIs ─────────────────────────────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-4">
        <KpiCard Label="Customers priced" Value="@_summaries.Count.ToString()" Sm="6" Md="3" />
        <KpiCard Label="Total list price (native)" Value="@Total(_summaries.Sum(s => s.TotalListPrice))" Sm="6" Md="3" />
        <KpiCard Label="Total Ion cost" Value="@Total(_summaries.Sum(s => s.TotalIonCost))" Sm="6" Md="3" />
        <KpiCard Label="Total Ion margin" Value="@Total(_summaries.Sum(s => s.TotalIonMargin))" Sm="6" Md="3" />
    </MudGrid>

    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
        <MudSwitch T="bool" @bind-Value="_groupByReseller" Color="Color.Primary" Label="Group by reseller" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="LoadAsync">
            Refresh
        </MudButton>
    </div>

    <MudPaper Class="pa-4" Elevation="2">
        @if (_busy)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-2" />
        }
        else if (_summaries.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No priced customers. Import customers from Ion (Customers page) or check that resellers are
                matched to Ion accounts.
            </MudText>
        }
        else if (_groupByReseller)
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                @foreach (var g in BuildGroups())
                {
                    <MudExpansionPanel @key="g.Reseller" Expanded="true">
                        <TitleContent>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body1" Class="fw-bold">@g.Reseller</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@g.Customers.Count customers</MudChip>
                                @if (g.BlendedPct is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@g.BlendedPct.Value.ToString("N1")% margin</MudChip>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    List <b>@g.TotalList.ToString("N0")</b> ·
                                    Cost <b>@g.TotalCost.ToString("N0")</b> ·
                                    Margin <b>@g.TotalMargin.ToString("N0")</b> @g.Currency
                                </MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                                @foreach (var s in g.Customers)
                                {
                                    <CustomerMarginPanel Summary="s" @key="@(s.TenantId ?? s.Domain)" />
                                }
                            </MudExpansionPanels>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                @foreach (var s in _summaries)
                {
                    <CustomerMarginPanel Summary="s" @key="@(s.TenantId ?? s.Domain)" />
                }
            </MudExpansionPanels>
        }
    </MudPaper>
}

@code {
    private bool _ready;
    private bool _busy;
    private bool _groupByReseller = true;
    private List<CustomerMarginSummary> _summaries = [];

    private record ResellerGroup(
        string Reseller,
        List<CustomerMarginSummary> Customers,
        decimal TotalList,
        decimal TotalCost,
        decimal TotalMargin,
        decimal? BlendedPct,
        string Currency);

    private IReadOnlyList<ResellerGroup> BuildGroups() =>
        _summaries
            .GroupBy(s => string.IsNullOrWhiteSpace(s.ResellerName) ? "(unmatched)" : s.ResellerName!)
            .Select(g =>
            {
                var cost = g.Sum(s => s.TotalIonCost);
                var margin = g.Sum(s => s.TotalIonMargin);
                var sell = cost + margin;
                return new ResellerGroup(
                    Reseller: g.Key,
                    Customers: g.OrderByDescending(s => s.TotalIonMargin).ToList(),
                    TotalList: g.Sum(s => s.TotalListPrice),
                    TotalCost: cost,
                    TotalMargin: margin,
                    BlendedPct: sell > 0 ? Math.Round(margin / sell * 100m, 1) : null,
                    Currency: g.Select(s => s.Currency).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c)) ?? string.Empty);
            })
            .OrderByDescending(x => x.TotalMargin)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (Options.MultiTenancy.Enabled)
        {
            var scope = await ScopeProvider.GetScopeAsync();
            if (!scope.IsPartner)
            {
                Nav.NavigateTo("/", forceLoad: false, replace: true);
                return;
            }
        }

        if (Ion.IsConfigured && Store.IsEnabled)
            await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _summaries = await Ion.GetPortfolioMarginsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Total(decimal v) => v.ToString("N0");
}
