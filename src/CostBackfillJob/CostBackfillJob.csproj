<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cmcsp-cost-backfill-job</UserSecretsId>

    <!-- Microsoft.Data.SqlClient (SQL data platform) requires ICU; the plain chiseled
         image runs in globalization-invariant mode and throws on SqlConnection.Open().
         Use the -extra variant (ships ICU + tzdata) and disable invariant mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- dotnet publish /t:PublishContainer defaults -->
    <ContainerRepository>cmcsp-backfill</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/runtime:10.0-noble-chiseled-extra</ContainerBaseImage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CmCSP.Core\CmCSP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageReference Include="Azure.Identity" Version="*" />
    <!-- Unify Microsoft.Identity.Client: Azure.Identity pulls an older build transitively, which
         conflicts (MSB3277) with the newer version referenced by CmCSP.Core. A direct reference
         pins the higher version as primary so the assembly versions resolve cleanly. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="*" />
  </ItemGroup>

</Project>
